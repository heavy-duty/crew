#!/usr/bin/env bash
# crew — spawn and tend a fleet of role-focused coding agents, on a host with
# `box` installed.
#
# The command surface is the CMDS table below: it is the single source of truth
# for what exists, what it looks like, what the help says, and what runs. This
# comment deliberately does NOT list the commands — it used to, it was printed
# verbatim as `crew help`, and it drifted: it advertised `crew hire <box>
# [--force]` long after the verb grew --role, --agent and --ref. `crew help`
# renders from the table now, so it cannot say something the code does not do.
#
# What a reader of this file needs that the help does not carry:
#
#   CREW_CONFIG_DIR selects one fleet definition directory. CREW_ROSTER is the
#   exceptional roster-only fixture override; it does not select a fleet
#   context. `fleet.roster` is the proof file: directories without one are
#   skipped, while an explicitly invalid CREW_CONFIG_DIR is an error. `crew
#   floor --roster` (CREW_FLOOR_ROSTER) does the same for the console. Use
#   these to drill against a subset — editing examples/fleet.roster to test is
#   how a leftover drill box came to count as a fleet member (#51).
#
#   The lifecycle is create → login → hire, and the middle step is a HUMAN one:
#   `crew auth` automated it and was REMOVED (danmt, 2026-07-25) until the rest
#   of the fleet is proven — vendor logins are flaky and change often, and
#   half-automating a step you still have to babysit buys nothing but a second
#   thing to debug. `crew help` carries the operator-facing version of this.
set -euo pipefail

# Resolve THIS script's real path before deriving the root. Installed, `crew`
# on PATH is a symlink ($BINDIR/crew -> …/current/cli/crew), so a plain
# $0/dirname would put CREW_ROOT in $BINDIR instead of the versioned tree.
# readlink -f follows the whole chain; on a plain checkout it is a no-op
# (the installer that creates that layout is install.sh, heavy-duty/crew#95).
CREW_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck disable=SC1091
source "$CREW_ROOT/shared/lib/version-skew.sh"
# The platform declaration and the ONE writer of the fresh-mint sequence (#679).
# box-mint.sh sources platform.sh itself, so the two hardcoded 0.10.0 mentions
# below and the mint read the same declaration whichever order these load in.
# shellcheck disable=SC1091
source "$CREW_ROOT/shared/lib/platform.sh"
# shellcheck disable=SC1091
source "$CREW_ROOT/shared/lib/box-mint.sh"
# The detail view renders the report computed inside the box. Source only the
# renderer's leaf module here: common.sh is the guest engine's entry point and
# brings host-irrelevant state, while duplicating these rows would let the CLI
# and floor drift (#484).
# shellcheck disable=SC1091
source "$CREW_ROOT/shared/lib/common/tick-health.sh"
ROLES_DIR="$CREW_ROOT/shared/conf/roles"
AGENTS_DIR="$CREW_ROOT/shared/conf/agents"

# A version is a DIRECTORY NAME under the installer's versions/ — nothing else.
# Byte-identical to install.sh's copy; shared/test/run.sh diffs the two so the
# gate the installer trusts and the gate the CLI trusts (crew use / uninstall,
# heavy-duty/crew#96) cannot drift.
valid_version() {
  case "$1" in
    ''|.*|-*) return 1 ;;
    *[!A-Za-z0-9._+-]*) return 1 ;;
  esac
  return 0
}
if [ "${CREW_CONFIG_DIR+x}" = x ]; then
  if [ -z "$CREW_CONFIG_DIR" ] || [ ! -d "$CREW_CONFIG_DIR" ] ||
     [ ! -f "$CREW_CONFIG_DIR/fleet.roster" ]; then
    echo "crew: CREW_CONFIG_DIR '$CREW_CONFIG_DIR' is not a fleet definition (fleet.roster is required)" >&2
    exit 1
  fi
  CONFIG_DIR="$(cd "$CREW_CONFIG_DIR" && pwd)"
  CONFIG_IS_OPERATOR=1
else
  CONFIG_DIR=""
  CONFIG_IS_OPERATOR=0
  if [ -n "${XDG_CONFIG_HOME:-}" ]; then CONFIG_CANDIDATE="$XDG_CONFIG_HOME/crew"
  else CONFIG_CANDIDATE="$HOME/.config/crew"; fi
  for candidate in "$CONFIG_CANDIDATE" "$PWD" "$CREW_ROOT/examples"; do
    if [ -d "$candidate" ] && [ -f "$candidate/fleet.roster" ]; then
      CONFIG_DIR="$(cd "$candidate" && pwd)"
      [ "$CONFIG_DIR" = "$CREW_ROOT/examples" ] || CONFIG_IS_OPERATOR=1
      break
    fi
  done
  [ -n "$CONFIG_DIR" ] || { echo "crew: no fleet definition found (fleet.roster is required)" >&2; exit 1; }
fi
# Completeness is checked on WHATEVER directory resolution selected, operator
# or fallback. It used to run only under CONFIG_IS_OPERATOR=1, which gave the
# least-trusted definition the least verification: an operator config missing
# a required file failed loudly, and a shipped-examples directory missing one
# ran unchecked (#216). Nothing about "is this file here" depends on who wrote
# the directory.
missing=""
for required in fleet.conf repos.txt; do
  [ -f "$CONFIG_DIR/$required" ] || missing="$missing $required"
done
[ -z "$missing" ] ||
  { echo "crew: fleet definition '$CONFIG_DIR' is incomplete; missing:$missing" >&2; exit 1; }
# Rehearsals that claim to exercise operator-owned configuration set this
# assertion. Keep it beside resolution so a missing CREW_CONFIG_DIR cannot
# silently fall through to examples/ and turn a real-host drill into coverage
# of the wrong mode (#82).
if [ "${CREW_EXPECT_OPERATOR_CONFIG:-0}" = 1 ] && [ "$CONFIG_IS_OPERATOR" -ne 1 ]; then
  echo "crew: operator-config mode required, but resolution selected '$CONFIG_DIR' (CONFIG_IS_OPERATOR=0)" >&2
  exit 1
fi
# config_file NAME — the fleet definition's own copy of NAME, or the shipped
# `examples/` one when the definition has none. This is the fallback the floor
# resolves too (`floor/registry.py`'s `_fleet_source`), so a definition
# carrying no `notify-repos.txt` reads identically on both halves (#488).
#
# On its own lines rather than folded onto one, for the same reason the
# registry family below is: the floor suite extracts each of these from THIS
# file on a `/^name() {/,/^}/` range to assert against the shipped resolver
# instead of a copy, and a one-line function silently over-captures to the
# next closing brace. That matters here more than anywhere — a suite proving
# the two halves agree about a missing file must resolve it the way the
# transport does, not the way the suite thinks the transport does.
config_file() { # NAME
  [ -f "$CONFIG_DIR/$1" ] && printf '%s\n' "$CONFIG_DIR/$1" || printf '%s\n' "$CREW_ROOT/examples/$1"
}
# registry_entries FILE — the repositories one registry file names, as every
# reader of these files defines them: `#` and blank lines are ignored, and an
# entry is its line STRIPPED (#488).
# `|| true` for the same reason box_registry carries it — a file with no entries
# in it exits non-zero, and under `pipefail` that kills the caller.
#
# The strip is what makes this half agree with the floor's `read_entries`,
# which has always emitted `line.strip()`. Without it a hand-indented entry in
# the fleet-wide file reaches `resolved_registry`'s exact-match `awk` with its
# leading spaces and matches no selection, so a box WITH an override silently
# drops a repository the console shows it watching — the console-vs-transport
# drift this family exists to make impossible. One `awk` rather than a
# `grep | sed` pipeline: a pipeline here is one more way to red under
# `pipefail` and buys nothing.
#
# On its own lines rather than folded onto one, so that every resolver in this
# family extracts with the same `/^name() {/,/^}/` range. The floor suite pulls
# them out of this file one by one to assert against the SHIPPED resolver
# instead of a copy, and a one-line function silently over-captures to the next
# closing brace.
registry_entries() { # FILE
  awk '{ sub(/^[[:space:]]+/, ""); sub(/[[:space:]]+$/, "") } $0 != "" && $0 !~ /^#/' "$1" 2>/dev/null || true
}
# registry_fleet_file KIND / registry_override_file BOX KIND — the two files
# behind one box's registry. KIND is `work` or `notify`. The override printer
# is silent when the box has none, so "" IS the inherit state and every caller
# tests it the same way.
registry_fleet_file() { # KIND
  case "$1" in
    work)   printf '%s\n' "$REPOS_SEED" ;;
    notify) printf '%s\n' "$NOTIFY_REPOS_SEED" ;;
    *)      die "registry_fleet_file: unknown registry '$1'" ;;
  esac
}
registry_override_file() { # BOX KIND
  local f
  case "$2" in
    work)   f="$CONFIG_DIR/repos.d/$1.txt" ;;
    notify) f="$CONFIG_DIR/notify-repos.d/$1.txt" ;;
    *)      die "registry_override_file: unknown registry '$2'" ;;
  esac
  [ -f "$f" ] && printf '%s\n' "$f"
  return 0
}
# resolved_registry BOX KIND — the repositories this box actually watches: the
# fleet-wide list, narrowed to the box's own selection when it has one (#488).
#
# THIS IS WHAT MAKES THE OVERRIDE A LAYER RATHER THAN A FILE. The floor writes
# `repos.d/<box>.txt`; without this resolver the transport would keep staging
# the fleet-wide list over it and the selection would be a file nothing reads —
# which is worse than not having one, because the console would report a
# narrowing the box does not have.
#
# The INTERSECTION, and not the override's own contents, is the operator's
# direction of 2026-08-29 arriving where it actually binds: a droid's watch set
# is drawn from the host-level list, so a repository the fleet-wide registry no
# longer names must not reach a guest merely because some box selected it
# before it was retired. `floor/registry.py`'s `effective()` resolves the same
# way, and the floor suite asserts the two agree — a drift between what the
# console renders and what the transport ships is the one failure this layer
# can introduce that nobody would see until a tick.
#
# Fleet-wide order, because that is the order the operator maintains upstream;
# awk rather than `comm`, which would need both sides sorted and would hand the
# box a registry ordered by nothing anyone chose.
#
# Existence is the whole test for HAVING a selection. An EMPTY override file is
# a box deliberately pointed at no board at all — containment state, the
# narrowing repos.txt's own header describes — and falling through to the
# fleet-wide list on emptiness would silently re-widen precisely that box.
resolved_registry() { # BOX KIND
  local fleet override
  fleet="$(registry_fleet_file "$2")"
  override="$(registry_override_file "$1" "$2")"
  if [ -z "$override" ]; then registry_entries "$fleet"; return 0; fi
  awk 'NR==FNR{sel[$0]=1;next} ($0 in sel)' \
    <(registry_entries "$override") <(registry_entries "$fleet")
}
# registry_seed BOX KIND — a FILE holding what this box should carry, for the
# transport to put. Prints the fleet-wide file itself when the box inherits, so
# the 60 lines of doctrine `repos.txt` ships reach the guest verbatim as they
# always have; a box with a selection gets a generated file instead, headed
# with what it is and where it came from, because shipping the fleet-wide
# doctrine header over a narrowed list would describe a scope the box does not
# have. A generated file is a TEMPORARY one and the caller removes it; the test
# for "did this generate" is `[ "$seed" != "$(registry_fleet_file KIND)" ]`,
# a comparison against the one path this can return without generating, rather
# than a guess about which directory mktemp used.
registry_seed() { # BOX KIND
  local override tmp
  override="$(registry_override_file "$1" "$2")"
  if [ -z "$override" ]; then registry_fleet_file "$2"; return 0; fi
  tmp="$(mktemp)"
  {
    printf '# %s registry — resolved by crew for box %s (#488).\n' "$2" "$1"
    printf '# A per-box selection from %s, edited on the floor.\n' "$(registry_fleet_file "$2")"
    printf '# Edits here are overwritten by the next crew upgrade.\n'
    resolved_registry "$1" "$2"
  } >"$tmp"
  printf '%s\n' "$tmp"
}
# registry_seed_discard KIND PATH — remove a seed registry_seed generated, and
# leave a fleet-wide file it merely pointed at alone. The comparison IS the
# test, so a caller can pair every registry_seed with this and never has to
# remember which of the two it got back.
registry_seed_discard() { # KIND PATH
  [ "$2" = "$(registry_fleet_file "$1")" ] || rm -f "$2"
}
# agent_conf NAME — the one resolved profile path every reader uses: an
# operator `agents/NAME.conf` beside the fleet definition wins over the
# same-named shipped profile; the shipped set is the fallback (#75). Adding a
# vendor is configuration, so it must not require editing the tracked tree —
# and a name clash resolves to the operator, or a fleet could never adjust a
# vendor it did not invent.
agent_conf() {
  if [ "$CONFIG_IS_OPERATOR" -eq 1 ] && [ -f "$CONFIG_DIR/agents/$1.conf" ]; then
    printf '%s\n' "$CONFIG_DIR/agents/$1.conf"
  else
    printf '%s\n' "$AGENTS_DIR/$1.conf"
  fi
}
# agent_names — every profile name agent_conf can resolve, shipped and
# operator, unsorted and possibly repeated; callers `sort -u`.
agent_names() {
  local f
  for f in "$AGENTS_DIR"/*.conf; do
    if [ -f "$f" ]; then basename "$f" .conf; fi
  done
  if [ "$CONFIG_IS_OPERATOR" -eq 1 ]; then
    for f in "$CONFIG_DIR"/agents/*.conf; do
      if [ -f "$f" ]; then basename "$f" .conf; fi
    done
  fi
}
ROSTER="${CREW_ROSTER:-$CONFIG_DIR/fleet.roster}"
FLEET_CONF="$(config_file fleet.conf)"
REPOS_SEED="$(config_file repos.txt)"
NOTIFY_REPOS_SEED="$(config_file notify-repos.txt)"
DOCTRINE_CONF="$(config_file doctrine.conf)"
CREW_REPO="${CREW_REPO:-heavy-duty/crew}"
# Two tick boundaries — the fleet's death rule. MUST equal fleet-floor's
# SILENT_AFTER_S (floor.py: 2 * TICK_S); shared/test/run.sh fails if it does
# not. Kept here rather than in the in-box script so the number lives on the
# host, once per reader, and never inside a box that cannot see either.
SILENT_AFTER_S="${CREW_SILENT_AFTER:-600}"
# These are shared operator verdicts, not display tuning. The floor accepts the
# same override for STUCK and treats an unmatched START as live for six hours;
# shared/test pins both readers so either side moving alone fails loudly.
STUCK_AFTER_S="${CREW_FLOOR_STUCK_AFTER:-$SILENT_AFTER_S}"
# The engine's kill grace, from shared/lib/common/operating-limits.sh:18
# (`session_kill_grace_seconds`), and spelled here rather than sourced because
# that file's own header says nothing sources it directly. A session AT its
# ceiling has not failed yet: `timeout` signals and waits this long before
# SIGKILL, so a lock still held one second past the ceiling is a session being
# killed on schedule, not a wedge.
#
# NOT operator-overridable, and that is the point of naming it: the floor holds
# the same number as a bare constant (fleet-floor/server/floor/units.py), and
# `kill-grace-cli-matches-floor` in shared/test/common.sh reds if either reader
# moves alone. A knob on one side would leave that pin comparing two defaults
# while the two consoles disagreed in front of the operator (#624 D4).
SESSION_KILL_GRACE_S=60
# The widest ceiling this reader GRADES arithmetically, and the reason it needs
# naming is that the floor has no equivalent: Python's int is unbounded, bash's
# is a fixed-width signed 64. A role conf is operator-editable and nothing
# between it and `session.sh`'s `timeout=${tmo}s` range-checks — GNU `timeout
# 999999999999999999999999 true` exits 0 — so the wire can genuinely carry more
# digits than bash can hold, and both of bash's ways of touching them are
# wrong: `test` fails with `integer expression expected` on stderr, and `$(( ))`
# WRAPS SILENTLY (`10#999999999999999999999999` is 2003764205206896639). Past
# this width the ceiling is not computed with, it is saturated at it — which
# grades identically to the floor's unbounded arithmetic, because 10^18 seconds
# is 31.7 billion years and no lock age off `date +%s` reaches it (#624 D3).
SESSION_CEILING_MAX_S=999999999999999999
# Twice the longest shipped role-session ceiling (builder: 3600s). A normal
# session gets its whole governed budget; a lock held through another whole
# budget is maintenance-wedge evidence rather than ordinary work (#588 D4).
RESTART_FORCE_AFTER_HOURS="${CREW_RESTART_FORCE_AFTER_HOURS:-2}"
RESTART_DRAIN_POLL_S="${CREW_DRAIN_POLL_SECONDS:-10}"
# A cold VM may accept `box start` before its guest agent can serve `box exec`.
# Keep that readiness wait bounded while allowing tests to collapse the clock.
# The one knob #589 D7 left to the builder, with the measurement in the PR
# body: how full a box may be and still be worth freezing into a checkpoint.
# Measured on claude-builder 2026-09-02 — 90% of 58 GiB, of which 45 GiB sits
# OUTSIDE $HOME and 25 GiB of that is two swapfiles providing no swap
# (heavy-duty/box#178). Nothing crew can reclaim moves a box in that state, so
# cutting it would make 90% the floor the fleet restores to every week. 80%
# sits above a swept box's real working set (a crew box's base plus worktrees
# is ~50%) and below the point where the image becomes the drift.
RESET_MAX_USED_PCT="${CREW_RESET_CUT_MAX_USED_PCT:-80}"
# The checkpoint every reset restores to. One label, fixed by the ruling of
# 2026-08-29: `bootstrapped` and `pristine` are NOT reset targets, and this is
# spelled once so no branch can drift into a fallback (#589 D-out).
RESET_LABEL=armed
RESTART_READY_ATTEMPTS="${CREW_RESTART_READY_ATTEMPTS:-60}"
RESTART_READY_POLL_S="${CREW_RESTART_READY_POLL_SECONDS:-2}"

# --- host maintenance state (#590) -------------------------------------------
# What a SCHEDULED caller of restart/reset needs, which neither verb owed on
# its own: a lock so the daily and the weekly can never overlap, and a log,
# because the cron line carries no redirect and its stdout goes to mail nobody
# reads on Monday. Both live in the VERB and neither in the cron line — that is
# shared/host-crontab.example's whole charter, inherited from the on-box side,
# where locking and redirecting in the crontab drifted five ways.
#
# Under XDG_STATE_HOME because that is what it is: host-side runtime evidence,
# not configuration. The explicit override exists for fixtures and for an
# operator running two fleet definitions on one host, who wants two schedules
# that do not share a lock.
HOST_STATE_DIR="${CREW_HOST_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/crew}"
HOST_JOB_LOG="$HOST_STATE_DIR/host-maintenance.log"
HOST_JOB_LOCK="$HOST_STATE_DIR/.host-maintenance.lock"
# tick.sh's number, for tick.sh's reason: a log that grows without bound is a
# disk-full incident on the host that runs the fleet.
HOST_JOB_LOG_MAX=5242880

# The maintenance verbs' exit statuses, spelled once. 1 and 2 keep crew's
# fleet-wide meanings (the world went wrong · you asked wrong); 3 is #588's
# contract and does not move. 4 is this issue's addition, and it exists because
# a cron mail has nothing but this number to read: "nothing was attempted"
# and "everything I attempted worked" are different facts, and the schedule is
# exactly where they get confused — a `reset --all` that skipped the whole run
# behind the lock used to be indistinguishable from one that restored the fleet.
EXIT_BOX_FAILED=1
EXIT_SKIPPED_BUSY=3
EXIT_NOTHING_TO_DO=4

# Two failures, two exit codes — because crew is called from scripts and from
# `crew up` loops, and "the fleet is broken" and "you typo'd" used to return
# the same 1. The line between them (#97):
#
#   2  the fault is in the INVOCATION — an unknown command, a missing,
#      unknown or conflicting flag, or an argument naming something the
#      CONFIGURATION does not define (an agent or role with no profile, a
#      box with no roster row). Nothing was attempted.
#   1  the fault is in the WORLD — the box CLI is absent, no roster file,
#      the box already exists, incus said no, a guard refused. You asked
#      correctly and the answer was no.
#
# The rule that decides the near-misses: the roster and the profiles are
# CONFIGURATION, so naming something absent from them is 2; boxes and the
# daemon are STATE, so their absence is 1. `crew hire nosuchbox` is 1 (the
# box is not there yet), `crew new --agent nosuchvendor` is 2 (no such
# profile is defined anywhere).
die() { echo "crew: $*" >&2; exit 1; }         # 1 = it went wrong
usage_error() { echo "crew: $*" >&2; echo "try 'crew help'." >&2; exit 2; }  # 2 = you asked wrong
need_box() { command -v box >/dev/null || die "the 'box' CLI is not on PATH — crew runs on a box host"; }

# The examples fallback is a definition NOBODY WROTE, and it must not be able
# to create infrastructure or arm cron (#216). Resolution ends at
# $CREW_ROOT/examples only when a host has no operator config at all, and
# before this that host presented as a fully configured seven-box fleet:
# `crew up` created seven boxes and armed cron against the three live
# repositories the shipped registry then named, with nothing in the output
# saying the definition was not the operator's. The shipped registry ships
# empty now, which closes the "aimed at somebody else's boards" half; this
# closes the other half — a scaffold is a thing to READ, never a mandate to
# act on.
#
# WHERE THESE ARE CALLED FROM is the load-bearing part, and it follows crew's
# own two-exit-code split above: a malformed invocation is diagnosed FIRST and
# still exits 2, because the operator asked wrong before the world could
# answer. The refusal is a WORLD fault — you asked correctly and the answer is
# no — so it exits 1, and every call site sits after that verb's argument
# parsing (and after resolve_engine, which is where a bad --ref earns its 2)
# and before that verb's first mutation.
require_operator_config() { # VERB
  if [ "$CONFIG_IS_OPERATOR" -eq 1 ]; then return 0; fi
  die "$1 refuses under the shipped example fleet definition at $CONFIG_DIR.
  Nobody configured this host, so there is nothing here to create or arm: the
  examples are a scaffold to read, not a fleet to run. Scaffold your own —
    crew init
  then edit the generated files (repos.txt ships EMPTY: name your repos) and
  run again. 'crew status', 'crew profiles' and 'crew up --dry-run' keep
  working here, which is how you inspect a host in this state."
}

# The read-only half of the same rule. `status`, `profiles` and `up --dry-run`
# are how someone INSPECTS an unconfigured host, so they keep working — but
# they say what they are reading, because the reported symptom was a table
# nobody could tell from a configured fleet's.
#
# On stderr deliberately: these verbs print tables, and a banner mixed into
# the rows is a second thing every reader of that stdout has to filter. A
# terminal shows both; a pipe keeps the rows it asked for.
fallback_banner() {
  if [ "$CONFIG_IS_OPERATOR" -eq 1 ]; then return 0; fi
  echo "crew: NOTE this host has NO operator fleet definition." >&2
  echo "crew: reading the shipped examples at $CONFIG_DIR — a scaffold, not an operator definition." >&2
  echo "crew: 'crew init' scaffolds one; until then no verb here will create a box or arm cron." >&2
}

# `--flag` with no value is a malformed invocation and must exit 2 like every
# other one. Reading "$2" directly under `set -u` makes BASH kill the process
# with its own "unbound variable" and exit 1 — so `crew new --agent` reported
# "the fleet is broken" for a typo, which is the exact confusion the split
# above exists to end. `${2:?...}` has the same defect: it is bash's error and
# bash's exit code, not ours (codex, review of #106).
#
# Called as `need_value "$@"` from inside the option's case branch, where "$1"
# is the flag and "$2" is its value if one was given. An EMPTY value is
# refused too, matching what the `${2:?}` sites already did.
need_value() { { [ "$#" -ge 2 ] && [ -n "$2" ]; } || usage_error "$1 needs a value"; }

# ...and the mirror of that: an argument BEYOND the synopsis was silently
# ignored. `crew help hire unexpected` printed hire's help and exited 0
# (codex, round 2 of #106), and `crew profiles junk` / `crew down junk` did
# the same. A verb whose parser is a while-loop already refuses these; the
# ones that read "${1:-}" positionally never looked. The table declares each
# synopsis, so the count comes from there rather than from a second opinion.
max_args() {  # $1 = verb, $2 = how many it accepts, then "$@" as given
  local verb="$1" max="$2"; shift 2
  [ "$#" -le "$max" ] || usage_error "too many arguments (usage: $(synopsis_of "$verb"))"
}


# The tree's own version, read in ONE place — `crew --version` says it out
# loud, and hire/upgrade stamp it onto a box (#94), so a box can name the
# release that put its engine there. crew_version is deliberately STRICT: a
# missing VERSION must fail the stamp loudly rather than write "unknown" onto
# a box. Only the display wrapper tolerates its absence.
crew_version() { head -1 "$CREW_ROOT/VERSION" | tr -d '\r\n'; }
version() { echo "crew $(crew_version 2>/dev/null || echo unknown) ($CREW_ROOT)"; }

# ---------------------------------------------------------------------------
# The command table.
#
#   verb ^ synopsis ^ one-line summary ^ function
#
# It is the single source of truth for what exists, what it looks like, what
# the help says, and what runs. The help cannot drift from the code because it
# is rendered from the rows that dispatch. Before this, the command list lived
# THREE times — the header comment printed as help, a hand-written dispatch
# `case`, and each verb's own usage string — and they had already diverged:
# the header advertised `crew hire <box> [--force]` while the verb had grown
# --role, --agent and --ref.
#
# Fields are ^-separated because a synopsis contains '|' and '[]' freely.
#
# crew's table is four fields, not box's seven: every crew verb is a shell
# function with its own argument parsing, so there is no precondition engine
# or thin-wrapper action to encode. Copying box's shape here would have been
# five empty columns.
CMDS=(
  "new^<roster-name> | --role <r> --agent <a> [--name <n>] [--from <box>[/<snap>]]^Create one box — infrastructure only; it does nothing until hired^cmd_new"
  "create-all^^Create every roster box that does not exist yet^cmd_create_all"
  "hire^<box> [--role <r> --agent <a>] [--ref <version-or-git-ref>] [--force] [--allow-offroster]^Put a box on duty: engine installed, cron armed. Idempotent^cmd_hire"
  "hire-all^[--ref <version-or-git-ref>]^Hire every created roster box; skips those already at this version^cmd_hire_all"
  "up^[--dry-run]^Converge the fleet: create missing, start stopped, hire, report^cmd_up"
  "restart^<box>... | --all [--force-after <hours>]^Drain and cycle selected boxes; busy boxes are skipped^cmd_restart"
  "down^[--force]^Drain and stop every roster box; --force skips the drain^cmd_down"
  "reset^[--cut] <box>... | --all [--force-after <hours>]^Restore boxes to their 'armed' checkpoint; --cut takes that checkpoint^cmd_reset"
  "status^[<box>]^Engine version and duty evidence, per box^cmd_status"
  "versions^^List installed host versions and mark the current and running trees^cmd_versions"
  "use^<version>^Switch the default host version; report box engines left behind^cmd_use"
  "uninstall^[<version>] [--all] [--force]^Remove one host version or the whole console, with fleet guards^cmd_uninstall"
  "upgrade^<box> | --all [--ref <version-or-git-ref>] [--force]^Ship the engine from this host and re-install it in place^cmd_upgrade"
  "gold^<box> [--force]^Snapshot a box as a gold image — cut PRE-login, credential-free^cmd_gold"
  "floor^[--port <n>] [--bind <a>] [--local] [--user <u>] [--pass <p>] [--roster <path>] [--interval <s>]^Serve the fleet-floor console on IP:PORT^cmd_floor"
  "init^[config-dir]^Scaffold a new operator fleet definition^cmd_init"
  "profiles^^List the role and agent profiles this crew resolves^cmd_profiles"
  "help^[<command>]^This help, or 'crew help <command>' for one command^cmd_help"
)

# Named verb_row, not cmd_row: the `cmd_` prefix marks a VERB IMPLEMENTATION
# and nothing else, so "every cmd_* has a table row" is checkable without an
# exclusion list. An exclusion list is the thing that rots.
verb_row() { local r; for r in "${CMDS[@]}"; do case "$r" in "$1^"*) echo "$r"; return 0 ;; esac; done; return 1; }
verbs()   { local r; for r in "${CMDS[@]}"; do echo "${r%%^*}"; done; }
is_command() { verb_row "$1" >/dev/null 2>&1; }
# locals matter: field() is called from inside dispatch, which holds its own
# row — a global read would clobber the row being dispatched.
field() {
  local r f_syn f_sum f_fn
  r="$(verb_row "$1")" || return 1
  IFS='^' read -r _ f_syn f_sum f_fn <<<"$r"
  case "$2" in syn) echo "$f_syn" ;; sum) echo "$f_sum" ;; fn) echo "$f_fn" ;; esac
}
synopsis_of() { local s; s="$(field "$1" syn)"; echo "crew $1${s:+ $s}"; }

# `adopt` was renamed to `hire`. It stays dispatchable so an old script does
# not break, and it stays OUT of the table so the help does not advertise a
# retired name. Normalizing here rather than in the dispatch `case` means
# `crew help adopt` lands on hire's help too, instead of "unknown command".
normalize_verb() {
  case "$1" in
    adopt) echo "crew: 'adopt' is now 'hire'" >&2; printf 'hire\n' ;;
    *) printf '%s\n' "$1" ;;
  esac
}

# Nearest verb by edit distance — a typo should point somewhere, not just fail.
suggest() {
  verbs | awk -v w="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" '
    function dist(a, b,   la, lb, i, j, c, prev, cur) {
      la = length(a); lb = length(b)
      for (j = 0; j <= lb; j++) prev[j] = j
      for (i = 1; i <= la; i++) {
        cur[0] = i
        for (j = 1; j <= lb; j++) {
          c = (substr(a, i, 1) == substr(b, j, 1)) ? 0 : 1
          cur[j] = prev[j] + 1
          if (cur[j - 1] + 1 < cur[j]) cur[j] = cur[j - 1] + 1
          if (prev[j - 1] + c < cur[j]) cur[j] = prev[j - 1] + c
        }
        for (j = 0; j <= lb; j++) prev[j] = cur[j]
      }
      return prev[lb]
    }
    BEGIN { best = 99 }
    { d = dist(w, $0); if (d < best) { best = d; hit = $0 } }
    END { if (best <= 2) print hit }'
}

unknown_command() {
  local hint; hint="$(suggest "$1")"
  if [ -n "$hint" ]; then
    echo "crew: unknown command: $1 — did you mean '$hint'?" >&2
  else
    echo "crew: unknown command: $1" >&2
  fi
  echo "try 'crew help' for the command list." >&2
  exit 2
}

usage() {
  cat <<'EOF'
crew — spawn and tend a fleet of role-focused coding agents, on a box host.

USAGE
  crew <command> [<args>] [options]

COMMANDS
EOF
  local r v sum
  for r in "${CMDS[@]}"; do
    IFS='^' read -r v _ sum _ <<<"$r"
    printf '  %-11s %s\n' "$v" "$sum"
  done
  cat <<'EOF'

THE LIFECYCLE — two verbs around one human step in the middle

  create  crew new / crew create-all — infrastructure only. The box is minted
          blank at the role profile's size, then rig converges it into its
          agent's <agent>-box role (the vendor CLI). It has no engine and no
          cron: it does nothing at all until it is hired.
  login   BY HAND, once per box, ever. 'crew auth' was removed until the
          fleet is proven — vendor logins are flaky and half-automating a
          step you still babysit buys a second thing to debug:
              box shell <box>      # then, inside the box:
              gh auth login        # a NEW identity — one box per identity
              <the agent profile's login hint — see 'crew profiles'>
          'crew status' and 'crew up' report who still owes this.
  hire    crew hire / crew hire-all — the box joins the crew: engine
          installed at this tree's version, cron armed, on duty at the next
          five-minute boundary. An idempotent upsert.

  A fleet from scratch: install box and crew, 'crew create-all', log each box
  in by hand, 'crew hire-all'. Steady state afterwards is just 'crew up'.

ENVIRONMENT
  CREW_CONFIG_DIR   Select one fleet definition directory. An invalid value
                    is an error, never a silent fall-through to the examples.
  CREW_ROSTER       Roster-only override, for drills and fixtures. It does
                    NOT select a fleet context.
  CREW_FLOOR_*      PORT, BIND, USER, PASS, INTERVAL, ROSTER — the console's
                    settings, each overridden by the matching flag.
  CREW_SILENT_AFTER Seconds before a box with no tick reads as silent (600).
  CREW_HOST_STATE_DIR
                    Where the host maintenance lock and job log live
                    ($XDG_STATE_HOME/crew).

EXIT STATUS
  0  ok
  1  it went wrong (no box CLI, no roster, incus said no, a guard refused)
  2  you asked wrong (unknown command, bad or missing flag, unknown profile)
  3  lifecycle work completed after a busy restart skip or a down drain wait
  4  nothing was attempted — restart/reset selected no box, or another host
     maintenance job held the lock

EXAMPLES
  # the whole fleet, converged — the verb you run most
  crew up
  crew status

  # one new member, end to end
  crew new claude-builder
  box shell claude-builder          # gh auth login, then the agent login
  crew hire claude-builder

  # a god-view of the fleet, reachable from the LAN
  crew floor --port 8420

  # your own fleet definition, outside the checkout
  crew init
  $EDITOR ~/.config/crew/fleet.roster

  Docs: https://github.com/heavy-duty/crew
EOF
}

# The synopsis and the summary come from the table; only prose lives here, and
# only where a verb has something to say beyond its summary.
help_cmd() {
  echo "usage: $(synopsis_of "$1")"
  echo
  echo "$(field "$1" sum)."
  case "$1" in
    new) cat <<'EOF'

A roster name takes everything from the roster row. --role and --agent make
an ad-hoc box instead, named <agent>-<role> unless --name says otherwise.
--from clones an existing box or one of its snapshots — that is how a gold
image becomes a new member without a second vendor install.

The box is created and nothing else. Log it in by hand, then hire it.
EOF
      ;;
    hire) cat <<'EOF'

Idempotent: a box already carrying this crew's version is skipped, so
hire is safe to re-run and is what 'crew up' calls. --force re-bakes anyway,
and overwrites a box whose engine files were modified by hand (which hire
otherwise refuses, same as upgrade); a development tree (a -dev version)
always re-bakes, because two dev trees at the same version are not the same
code.

--ref names a DIFFERENT engine source, resolved on the host (#99): from a
working tree it is a git ref, and from an installed tree it is one of the
versions under versions/. The box never fetches anything itself.

The guard: hiring an OFF-ROSTER box against the production registry is
refused, because that arms a second production agent racing the fleet for
the same work. Narrow its registry first, add it to the roster, or pass
--allow-offroster if arming production is genuinely what you mean.

The other guard: a box whose tenant role never converged is refused, because
hiring installs the engine and arms cron on a box that can never run its
agent — it then wakes every five minutes, fails, and writes the failure to
its own duty.log where nobody is looking. crew reads rig's role marker
(/etc/rig/role) to tell the two apart. A box that cannot be read is refused
too: an unreadable marker is not a converged one. --force overrides both.

'adopt' was this verb's old name and still works.
EOF
      ;;
    up) cat <<'EOF'

The steady-state verb: it creates what is missing, starts what is stopped,
hires what is unhired, and reports who still owes a login. Nothing is ever
deleted — a box on the host but not in the roster is reported and left
alone. --dry-run says what it would do and touches nothing.

A box whose tenant role never converged is SKIPPED, named in the summary,
and reflected in the exit status — one box must not stop the convergence,
and a fleet short a member must not exit 0.
EOF
      ;;
    upgrade) cat <<'EOF'

--all means the ROSTER, not every box on the host: a disarmed box carrying a
real identity and a production registry must not be armed by routine
maintenance. Naming a box explicitly still reaches it — that is a deliberate
act on a known target, which --all is not.

A box's armed state is preserved rather than asserted: an upgrade that arms
a box nobody armed is a behaviour change wearing a version bump's clothes.

A box whose engine files no longer match the version they were installed at
is REFUSED, naming what differs, and nothing is written. Somebody patched
that box; this is the last moment anyone can be told before the patch is
overwritten. 'crew status <box>' lists the files. --force overwrites them.
EOF
      ;;
    restart) cat <<EOF

--all means the ROSTER, never every box on the host. A held or unreadable duty
lock is skipped and makes the command exit 3. After the default of
${RESTART_FORCE_AFTER_HOURS} continuous hours (twice the longest shipped session budget),
the lock is treated as wedged; --force-after changes that threshold for this run.
The override applies only when a valid continuous lock age is available.

Each idle target has stale duty snapshots removed, then is stopped, confirmed
stopped, and started. A stop that does not take is never followed by a start.

This is a SCHEDULED verb (shared/host-crontab.example runs it daily), so it
carries the three things an unattended caller needs — see 'crew help reset',
which shares all of them: the host maintenance lock, the job log at
$HOST_JOB_LOG, and the exit statuses 0 · 1 · 3 · 4 described there.
EOF
      ;;
    # UNQUOTED heredoc, and it is the only one in this case block that is: the
    # floor this paragraph quotes is the declaration's (#679 D11), so it
    # interpolates. There is no other $ or backtick in the text.
    down) cat <<EOF

A plain down waits for each held duty lock, announcing every wait with the box
and lock age. It never escalates. --force performs no drain and calls
'box down <box> --force'; it requires box $CREW_PLATFORM_BOX_MIN or later.
EOF
      ;;
    gold) cat <<'EOF'

Gold images are the bake cache and must carry ZERO credentials, so they are
cut BEFORE the box is logged in. A box with live gh credentials is refused
unless you pass --force, and if you do, treat the result like a credential.
EOF
      ;;
    reset) cat <<EOF

AN 'armed' CHECKPOINT CONTAINS LIVE CREDENTIALS. This is 'crew gold' inverted,
not bypassed: gold REFUSES a logged-in box, and --cut REQUIRES one, because a
checkpoint of a half-built box is worse than none — the restore that uses it
looks like it worked. So the host holding these images IS the trust boundary,
exactly as it is for a gold cut with --force. No crew verb ever exports an
'armed' image, and it is refused as a 'crew new --from' source: cloning one
mints a second box carrying the first box's identity. Ruled and accepted by
the operator, 2026-08-29.

--cut snapshots each box as '$RESET_LABEL', after checking it is logged in AND hired,
and records the engine version it was cut at. LOGGED IN IS BOTH HALVES — 'gh
auth status' and the agent profile's own login probe — because a box that
cannot reach its model is the half-built box this refuses. A box whose engine
stamp is not a version at all is refused too: a version that cannot be
recorded cannot be compared at restore time.

It reclaims first: the reaper runs on demand, and only then is the disk
measured, so a box that is merely one day of transcripts fat is cut rather
than refused. A box still over ${RESET_MAX_USED_PCT}% after reclaiming is REFUSED, naming what
is large — whatever is inside the image becomes the floor the fleet returns to
forever. CREW_RESET_CUT_MAX_USED_PCT overrides the ceiling, and is read on
this path only.

Without --cut, each box is restored to its '$RESET_LABEL' checkpoint and started.
'box info' is the only thing that knows a label exists, so a box without one
is refused and NAMED — never skipped, and never rolled back to 'bootstrapped'
or 'pristine', which would return a creds-free, unhired box.

The interlock: restoring to a checkpoint cut before the engine moved silently
DOWNGRADES that box. So EVERY verb that installs an engine — 'crew hire',
'crew up', 'crew upgrade' — marks the checkpoint stale BEFORE installing, and
refuses to install if that mark cannot be written; a reset then refuses the
box naming both versions and naming 'crew reset --cut <box>' as the repair.
Marking first is what makes it durable: a mark written afterwards that failed
would leave a box running a new engine and a checkpoint claiming the old one
is current. A checkpoint whose recorded version cannot be read, or is not a
version, is refused the same way and for the same reason: an unknown version
is not a matching one.

A stopped box is restored where it stands — the restore stops it first anyway
— but it is REFUSED for a cut, which reads its login, its engine and its disk
from inside it.

--all means the ROSTER, never every box on the host. A held or unreadable duty
lock is skipped and makes the command exit 3, on #588's contract and its
${RESTART_FORCE_AFTER_HOURS}-hour --force-after default: a reset destroys in-flight work exactly
as a restart does.

--force-after forces the RESTORE path only, and does not apply to --cut: the
cut is skipped on a held lock however old, because the on-demand reaper takes
that same lock and a checkpoint of a box that could not be reclaimed becomes
the floor every later reset returns to.

SCHEDULED USE. This verb and 'crew restart' are the two the host schedule
fires (shared/host-crontab.example: restart daily, reset weekly), and both
carry what a caller with no terminal and nobody watching needs.

They take one HOST MAINTENANCE LOCK between them, non-blocking, so the daily
and the weekly can never overlap. The later one names the holder, touches no
box, and exits 4. The lock is taken on every invocation and not only under
cron: an operator running this by hand during a scheduled run IS the collision
it prevents. It needs 'flock' on PATH and refuses without it rather than
running unlocked.

Every run writes its boundary and its whole output to
  $HOST_JOB_LOG
because a cron line carries no redirect. A run that did nothing writes there
too, so silence in that log at a boundary means one thing: cron is dead.
CREW_HOST_STATE_DIR moves the lock and the log together.

The exit status is what a cron mail is read off:
  0  every selected box was acted on
  1  a box FAILED, or was REFUSED (the interlock above is a refusal, and the
     per-box line says so and names the repair)
  3  no failure, but a box was SKIPPED busy
  4  nothing was attempted — no box was selected, or the lock was held
EOF
      ;;
    floor) cat <<'EOF'

The console reads every box over 'box exec' from THIS host and fires operator
actions the same way. Nothing is installed inside a box and no box has to
reach out — the boxes have no inbound path, but the host that runs them has
always had a control channel into them.

It binds 0.0.0.0 by default, because being reachable at IP:PORT is the job.
That makes HTTP Basic auth non-optional: a page that can power-cycle boxes
and start model sessions is not one to leave open on a LAN. Without --pass a
password is generated and printed once, at startup. --local binds loopback
instead, and over plain HTTP on a LAN the password crosses in the clear.

It needs an operator fleet definition and REFUSES under the shipped examples,
like every verb that creates or arms: its buttons resume cron and start model
sessions. 'crew init' scaffolds one; 'crew status' inspects a host without.
--roster selects a roster file, not a fleet — it does not lift the refusal.
EOF
      ;;
    init) cat <<'EOF'

Copies the shipped examples into a fleet definition you own — roster, fleet
config, the two registries, and doctrine paths — and never overwrites an
existing path. Edit them outside the checkout; crew resolves them by
CREW_CONFIG_DIR, then $XDG_CONFIG_HOME/crew, then the working directory,
then the shipped examples.

The login list it prints is a static reading of the roster, not a live
auth check.
EOF
      ;;
    status) cat <<'EOF'

With no box: one row per roster member — state, the engine version it was
hired at, its gh and vendor credential health, and its last duty line. With
a box: that box's engine version and the tail of its duty log.

A box whose duty log has not moved in two tick boundaries reads as stale
rather than flowing. An idle tick is not silent — the engine logs every run
— so silence means no tick RAN, which is a cron problem.

For an UN-HIRED box the note carries whether rig converged its tenant role:
an INCOMPLETE one names the bootstrap recovery rather than 'crew hire', and
'crew hire' refuses it. Every other column here is derived through the
engine, which does not exist until hire — so before hiring, this is the only
column that can carry the failure.
EOF
      ;;
    profiles) cat <<'EOF'

Roles change the engine's duty lifecycle; agent profiles are configuration.
An operator agents/ directory beside the fleet definition overlays the
shipped set, and a same-named profile wins — a profile listed here is
hireable, and one marked [operator] is the operator's copy, not the
shipped one.
EOF
      ;;
  esac
}

show_help() {   # "" → general help
  case "${1:-}" in
    ""|help) usage ;;
    *) is_command "$1" || unknown_command "$1"; help_cmd "$1" ;;
  esac
}

cmd_help() { max_args help 1 "$@"; show_help "$(normalize_verb "${1:-}")"; }

# --- versioned host install -------------------------------------------------
install_root() {
  local versions_dir; versions_dir="$(dirname "$CREW_ROOT")"
  [ "$(basename "$versions_dir")" = versions ] || return 1
  dirname "$versions_dir"
}

crew_bin_links() {
  [ -L "${BASH_SOURCE[0]}" ] && printf '%s\n' "${BASH_SOURCE[0]}"
  [ -n "${CREW_BIN:-}" ] && printf '%s\n' "$CREW_BIN/crew"
  printf '%s\n' "$HOME/.local/bin/crew"
}

link_target() {
  readlink -f "$1" 2>/dev/null ||
    readlink -m "$(dirname "$1")/$(readlink "$1" 2>/dev/null)" 2>/dev/null ||
    true
}

converge_crew_bin_links() {
  local install="$1" link target
  while IFS= read -r link; do
    [ -L "$link" ] || continue
    target="$(link_target "$link")"
    case "$target" in
      "$install"/*) ln -sfn "$install/current/cli/crew" "$link" ;;
    esac
  done < <(crew_bin_links | awk '!seen[$0]++')
}

cmd_versions() {
  max_args versions 0 "$@"
  local install current dir version_name marks
  install="$(install_root)" ||
    die "this crew runs from a working tree ($CREW_ROOT), not a versioned install — nothing to list."
  current="$(readlink -f "$install/current" 2>/dev/null || true)"
  echo "VERSIONS  ($install)"
  for dir in "$install"/versions/*/; do
    [ -d "$dir" ] || continue
    version_name="$(basename "$dir")"; marks=""
    [ "$(readlink -f "$dir")" = "$current" ] && marks=" (current)"
    [ "$(readlink -f "$dir")" = "$CREW_ROOT" ] && marks="$marks (running)"
    printf '  %s%s\n' "$version_name" "$marks"
  done
  echo
  echo "switch the default:  crew use <version>"
  echo "install another:     re-run install.sh (versions land side by side)"
}

cmd_use() {
  max_args use 1 "$@"
  [ "$#" -eq 1 ] || usage_error "usage: $(synopsis_of use)"
  local version_name="$1" install effective answer
  install="$(install_root)" ||
    die "this crew runs from a working tree ($CREW_ROOT), not a versioned install — nothing to switch."
  valid_version "$version_name" ||
    usage_error "not a sane version name: '$version_name' (see 'crew versions')"
  [ -d "$install/versions/$version_name" ] ||
    die "no such version: $version_name (see 'crew versions')"
  [ -w "$install" ] ||
    die "cannot write install root $install — a system crew install is root-owned; run 'crew use' as root"

  ln -sfn "versions/$version_name" "$install/current.new.$$"
  mv -Tf "$install/current.new.$$" "$install/current"
  converge_crew_bin_links "$install"

  effective="$(basename "$(readlink -f "$install/current" 2>/dev/null || true)")"
  [ "$effective" = "$version_name" ] ||
    die "the switch did not take — current resolves to '${effective:-nothing}', not $version_name"
  answer="$("$install/current/cli/crew" --version 2>&1 || true)"
  case "$answer" in
    "crew $version_name ("*) : ;;
    *) die "current/cli/crew answers '$answer', not version $version_name — the symlink chain is broken" ;;
  esac

  echo "crew: switched to $version_name (current -> versions/$version_name)"
  report_engine_skew "$version_name"
}

uninstall_confirm() {
  local question="$1" forced="$2" reply
  [ "$forced" -eq 1 ] && return 0
  [ -n "${CREW_YES:-}" ] && return 0
  [ -t 0 ] ||
    die "refusing to $question without --force (no terminal to confirm on; CREW_YES=1 also means yes)"
  printf 'crew: %s? [y/N] ' "$question"
  read -r reply || die "aborted."
  case "$reply" in y|Y|yes|YES|Yes) return 0 ;; *) die "aborted." ;; esac
}

live_floor_pids() {
  local floor="$1/fleet-floor/server/floor.py" cmdline argv
  for cmdline in /proc/[0-9]*/cmdline; do
    [ -r "$cmdline" ] || continue
    argv="$(tr '\0' ' ' <"$cmdline" 2>/dev/null || true)"
    case "$argv" in
      *"$floor"*) basename "$(dirname "$cmdline")" ;;
    esac
  done
}

cmd_uninstall() {
  local version_name="" all=0 force=0 arg install current link target leftover=""
  local hired="" floor_pids="" box_name engine
  local removal_targets=()
  for arg in "$@"; do
    case "$arg" in
      --all) all=1 ;;
      --force) force=1 ;;
      -*) usage_error "unknown option '$arg' (usage: $(synopsis_of uninstall))" ;;
      *) [ -z "$version_name" ] ||
           usage_error "usage: $(synopsis_of uninstall)"
         version_name="$arg" ;;
    esac
  done
  install="$(install_root)" ||
    die "this crew runs from a working tree ($CREW_ROOT), not a versioned install — nothing to uninstall."
  [ -w "$install" ] ||
    die "cannot write install root $install — a system crew install is root-owned; run 'crew uninstall' as root"

  if [ -n "$version_name" ] && [ "$all" -eq 0 ]; then
    valid_version "$version_name" ||
      usage_error "not a sane version name: '$version_name' (see 'crew versions')"
    [ -d "$install/versions/$version_name" ] ||
      die "no such version: $version_name (see 'crew versions')"
    current="$(basename "$(readlink -f "$install/current" 2>/dev/null || true)")"
    { [ -n "$current" ] && [ -d "$install/versions/$current" ]; } ||
      die "current is dangling — 'crew use <version>' to repair it before removing anything"
    [ "$version_name" != "$current" ] ||
      die "$version_name is the CURRENT version — 'crew use <other>' first"
    floor_pids="$(live_floor_pids "$install/versions/$version_name")"
    [ -z "$floor_pids" ] ||
      die "version $version_name has a live crew floor (PID(s): $(tr '\n' ' ' <<<"$floor_pids")) — stop that console before uninstalling its tree"
    uninstall_confirm "remove crew version $version_name from $install" "$force"
    rm -rf "$install/versions/$version_name" || true
    if [ -e "$install/versions/$version_name" ] || [ -L "$install/versions/$version_name" ]; then
      echo "crew: uninstall INCOMPLETE — still present: $install/versions/$version_name" >&2
      return 1
    fi
    echo "crew: removed version $version_name (the default stays $current)"
    return 0
  fi
  [ -z "$version_name" ] || usage_error "a version and --all together is ambiguous"
  [ "$all" -eq 1 ] || usage_error "usage: $(synopsis_of uninstall)"

  hired="$(hired_engine_versions)"
  if [ -n "$hired" ] && [ "$force" -eq 0 ] && [ -z "${CREW_YES:-}" ]; then
    {
      echo "crew: refusing to remove the console while hired boxes are running:"
      while IFS=$'\t' read -r box_name engine; do
        echo "crew:   · $box_name ($engine)"
      done <<<"$hired"
      echo "crew: cron is armed inside each box; the fleet keeps running autonomously,"
      echo "crew: unattended, while nothing remains to see, converge, or stop it."
      echo "crew: stop the fleet first with 'crew down', or use --force/CREW_YES=1"
      echo "crew: only if leaving it running unattended is deliberate."
      echo "crew: this removes the console only — box engines are untouched, and"
      echo "crew: 'crew status' is the visibility you are about to lose."
    } >&2
    return 1
  fi
  uninstall_confirm "remove the ENTIRE crew console at $install (every host version)" "$force"

  removal_targets+=("$install")
  while IFS= read -r link; do
    [ -L "$link" ] || continue
    target="$(link_target "$link")"
    case "$target" in "$install"/*) removal_targets+=("$link") ;; esac
  done < <(crew_bin_links | awk '!seen[$0]++')
  mapfile -t removal_targets < <(printf '%s\n' "${removal_targets[@]}" | awk '!seen[$0]++')
  for target in "${removal_targets[@]}"; do rm -rf "$target" || true; done
  for target in "${removal_targets[@]}"; do
    if [ -e "$target" ] || [ -L "$target" ]; then leftover="$leftover $target"; fi
  done
  if [ -n "$leftover" ]; then
    echo "crew: uninstall INCOMPLETE — still present:$leftover" >&2
    return 1
  fi
  echo "crew: uninstalled the host console; box engines were untouched."
}

# EVERY `box exec` in this file takes stdin from /dev/null.
#
# `box exec` forwards stdin the way ssh does, so inside a
# `while read … done < <(read_roster)` the FIRST iteration drained the roster
# FIFO: `read` then hit EOF and the loop exited cleanly, rc=0, with N-1 boxes
# silently missing. `crew status` reported one of three boxes and `crew up`
# converged one box and called it success (#48) — no error either time, which
# is what made it survive a real-host run.
#
# Safe at every call site: all of them pass the script as an ARGUMENT.
# vendor_probe is the one helper that legitimately ships data over stdin, and
# it has its own `<"$(agent_conf "$2")"` redirect — which is exactly why it
# never broke.
#
# Those two are the ONLY places `box exec` appears in this file, and the test
# suite asserts that count. Routing every caller through a helper is what makes
# "stdin is always pinned" checkable at all: before, the redirect was a thing
# each call site had to remember, and the two that forgot were the two in
# roster loops.
bxn() { box exec "$1" -- bash -lc "$2" </dev/null; }

# bxput is the one other stdin-bearing box channel: atomically stage one host
# file without requiring it to be tracked by git in the box's checkout.
bxput() { # BOX SOURCE DESTINATION
  local box_name="$1" source_file="$2" destination="$3" remote_script
  remote_script="
    set -euo pipefail
    destination=\"\$HOME/$destination\"
    mkdir -p \"\$(dirname \"\$destination\")\"
    tmp=\$(mktemp \"\$(dirname \"\$destination\")/.crew-stage.XXXXXX\")
    cat >\"\$tmp\"
    mv \"\$tmp\" \"\$destination\"
  "
  box exec "$box_name" -- bash -lc "$remote_script" <"$source_file"
}

# resolve_engine REF — select one host-side engine source and set the
# ENGINE_* globals consumed by stage_engine. A checkout resolves Git refs;
# an installed tree resolves its current engine or versions/<version>.
# The six failures below split along the same line as the rest of the file
# (codex, round 3 of #106): three are INVOCATION faults and exit 2 — a ref
# whose SHAPE can never be valid, a ref that resolves to nothing, and a ref in
# the wrong form for the mode. Nothing is attempted in any of them. The other
# three exit 1 because the world is wrong rather than the asking: the ref is
# real but its tree has no VERSION, the version directory is missing, or the
# directory's VERSION contradicts its own name.
resolve_engine() {
  local ref="${1:-HEAD}" version_root
  case "$ref" in -*) usage_error "engine ref must not begin with '-': '$ref'" ;; esac
  ENGINE_GIT_REF=""
  if git -C "$CREW_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git -C "$CREW_ROOT" rev-parse --verify "$ref^{commit}" >/dev/null 2>&1 \
      || usage_error "working-tree mode cannot resolve git ref '$ref'"
    ENGINE_VERSION="$(git -C "$CREW_ROOT" show "$ref:VERSION" 2>/dev/null | head -1 | tr -d '\r\n')"
    [ -n "$ENGINE_VERSION" ] || die "working-tree git ref '$ref' has no VERSION"
    ENGINE_MODE="working-tree git ref $ref"
    ENGINE_ROOT="$CREW_ROOT"
    ENGINE_GIT_REF="$ref"
  else
    if [ "$ref" = HEAD ]; then
      version_root="$CREW_ROOT"
      ENGINE_MODE="installed current engine"
    else
      if [[ ! "$ref" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[A-Za-z0-9][A-Za-z0-9.-]*)?$ ]]; then
        usage_error "installed-tree mode expects --ref <installed-version>, not '$ref'"
      fi
      version_root="$CREW_ROOT/versions/$ref"
      ENGINE_MODE="installed version $ref"
    fi
    if [ ! -f "$version_root/VERSION" ] || [ ! -d "$version_root/shared" ]; then
      die "$ENGINE_MODE is unavailable under $version_root"
    fi
    ENGINE_VERSION="$(head -1 "$version_root/VERSION" | tr -d '\r\n')"
    [ "$ref" = HEAD ] || [ "$ENGINE_VERSION" = "$ref" ] \
      || die "installed version directory '$ref' contains VERSION '$ENGINE_VERSION'"
    ENGINE_ROOT="$version_root"
  fi
  echo "  engine source: $ENGINE_MODE → crew@$ENGINE_VERSION"
}

# cleanup_staged_engine BOX — best-effort rollback for a failure between the
# engine upload and the install wrapper that normally owns this cleanup.
cleanup_staged_engine() {
  bxn "$1" 'rm -rf ~/.crew-engine-stage ~/.crew-engine.tgz' >/dev/null 2>&1 || true
}

# stage_engine BOX — archive the resolved host engine, atomically upload it,
# and extract it into a disposable box-side staging directory.
stage_engine() {
  local box_name="$1" archive
  archive="$(mktemp)"
  if [ -n "$ENGINE_GIT_REF" ]; then
    if ! git -C "$CREW_ROOT" archive --format=tar.gz \
      --output="$archive" "$ENGINE_GIT_REF" shared VERSION; then
      rm -f "$archive"
      return 1
    fi
  elif ! tar czf "$archive" -C "$ENGINE_ROOT" shared VERSION; then
    rm -f "$archive"
    return 1
  fi
  if ! bxput "$box_name" "$archive" '.crew-engine.tgz'; then
    rm -f "$archive"
    cleanup_staged_engine "$box_name"
    return 1
  fi
  rm -f "$archive"
  # shellcheck disable=SC2016  # expanded by bash inside the box
  if ! bxn "$box_name" '
    set -euo pipefail
    stage="$HOME/.crew-engine-stage"
    archive="$HOME/.crew-engine.tgz"
    cleanup_failed() {
      rc=$?
      if [ "$rc" -ne 0 ]; then rm -rf "$stage" "$archive"; fi
      return "$rc"
    }
    trap cleanup_failed EXIT
    rm -rf "$stage"
    mkdir -p "$stage"
    tar xzf "$archive" -C "$stage"
    test -f "$stage/shared/install.sh"
    test -f "$stage/VERSION"
  '; then
    cleanup_staged_engine "$box_name"
    return 1
  fi
}

# install_staged_engine BOX ARGS — retire the obsolete box-side checkout,
# run the selected host engine, and remove staging on every exit path.
install_staged_engine() {
  local box_name="$1" install_args="$2"
  bxn "$box_name" "
    set -euo pipefail
    stage=\"\$HOME/.crew-engine-stage\"
    archive=\"\$HOME/.crew-engine.tgz\"
    cleanup() { rm -rf \"\$stage\" \"\$archive\"; }
    trap cleanup EXIT
    if [ -e \"\$HOME/crew\" ]; then
      retired=\"\$HOME/crew.retired\"
      if [ -e \"\$retired\" ]; then
        retired=\"\$HOME/crew.retired.\$(date -u '+%Y%m%dT%H%M%SZ')\"
      fi
      mv \"\$HOME/crew\" \"\$retired\"
      echo \"crew: retired obsolete box-side engine source ~/crew to \${retired#\$HOME/}\"
    fi
    \"\$stage/shared/install.sh\" $install_args
  "
}

# stage_agent_profiles BOX — every operator agents/*.conf into the seed dir
# install.sh reads. The seed dir is emptied FIRST even when the operator has
# no agents/ at all: a profile staged by a previous install and since deleted
# from the fleet definition must not resurrect from a stale seed.
#
# The timing is the contract (#75): install.sh refuses an unknown agent
# profile BEFORE it creates conf/agents, so a profile that only arrived with
# the conf copy would fail its own validation — the seed has to be on the box
# before install.sh runs, which is exactly when this stage runs.
stage_agent_profiles() { # BOX
  local box_name="$1" profile
  bxn "$box_name" 'rm -rf ~/duty/.crew-seed-agents' || return 1
  if [ "$CONFIG_IS_OPERATOR" -eq 1 ] && [ -d "$CONFIG_DIR/agents" ]; then
    for profile in "$CONFIG_DIR"/agents/*.conf; do
      if [ -f "$profile" ]; then
        bxput "$box_name" "$profile" "duty/.crew-seed-agents/$(basename "$profile")" || return 1
      fi
    done
  fi
  return 0
}

stage_registry_examples() { # BOX
  local box_name="$1"
  if [ "$CONFIG_IS_OPERATOR" -eq 0 ]; then return 0; fi
  bxput "$box_name" "$CREW_ROOT/examples/repos.txt" \
    'duty/.crew-example-repos.txt' &&
    bxput "$box_name" "$CREW_ROOT/examples/notify-repos.txt" \
      'duty/.crew-example-notify-repos.txt'
}

stage_fleet_definition() { # BOX
  local box_name="$1" runtime_conf work_seed notify_seed
  runtime_conf="$(mktemp)"
  {
    cat "$FLEET_CONF"
    printf '\n# Resolved from the selected fleet directory doctrine.conf.\n'
    cat "$DOCTRINE_CONF"
  } >"$runtime_conf"
  # Resolved ONCE and held in a variable, not called inline twice. A box with a
  # selection gets a generated file (registry_seed, above), so an inline call
  # in the `bxput` chain would leak one temp file per staging and leave nothing
  # holding its name to remove — the same reason $runtime_conf is a local.
  work_seed="$(registry_seed "$box_name" work)"
  notify_seed="$(registry_seed "$box_name" notify)"
  if bxput "$box_name" "$ROSTER" 'duty/fleet.roster' &&
     bxput "$box_name" "$runtime_conf" 'duty/conf/fleet.conf' &&
     bxput "$box_name" "$work_seed" 'duty/.crew-seed-repos.txt' &&
     bxput "$box_name" "$notify_seed" 'duty/.crew-seed-notify-repos.txt' &&
     stage_registry_examples "$box_name" &&
     stage_agent_profiles "$box_name"; then
    rm -f "$runtime_conf"
    registry_seed_discard work "$work_seed"
    registry_seed_discard notify "$notify_seed"
    return 0
  fi
  rm -f "$runtime_conf"
  registry_seed_discard work "$work_seed"
  registry_seed_discard notify "$notify_seed"
  bxn "$box_name" 'rm -f ~/duty/.crew-seed-repos.txt ~/duty/.crew-seed-notify-repos.txt ~/duty/.crew-example-repos.txt ~/duty/.crew-example-notify-repos.txt; rm -rf ~/duty/.crew-seed-agents' || true
  return 1
}

registry_install_arg() {
  if [ "$CONFIG_IS_OPERATOR" -eq 1 ]; then printf '%s' '--converge-registries'; fi
}

box_names() {
  box list --json 2>/dev/null | jq -r '.[].name' 2>/dev/null \
    || box list 2>/dev/null | awk 'NR>1 {print $1}'
}
box_exists() { local names; names="$(box_names)"; grep -qx -- "$1" <<<"$names"; }

# box_state NAME — the box's lifecycle state, lowercased; "?" when the payload
# cannot be read.
#
# `box info --json` returns an ARRAY. Two call sites filtered it as an object
# (`.state // .status`), so jq died with `Cannot index array with string
# "state"` — and because both were command substitutions under `set -euo
# pipefail`, jq's rc=5 killed the whole command (#47). `crew status` printed
# its header and stopped, which reads like an empty roster rather than a
# crash; `crew up` did the same on the first EXISTING box, and that is the
# steady-state convergence verb. Neither had ever worked on a populated fleet.
#
# `.state` is an object in the real payload, so `.[0].status` must come first.
# The `|| true` and the `${s:-?}` are the parts that matter long-term: a future
# shape change must degrade to "?", not kill the command. box_names makes the
# identical call and survived only because it had a fallback.
box_state() {
  local s
  s="$(box info "$1" --json 2>/dev/null \
    | jq -r 'if type == "array" then (.[0] // {}) else . end
             | .status // (.state | if type == "object" then .status else . end) // "?"' 2>/dev/null \
    | head -1 | tr -d '\r' | tr '[:upper:]' '[:lower:]' || true)"
  printf '%s\n' "${s:-?}"
}

# Roster reader: <name> <agent> <role> [<from-box>/<snap>]; comments/blanks
# skipped. roster_line prints "agent role from" for one name.
read_roster() { grep -vE '^[[:space:]]*(#|$)' "$ROSTER"; }
roster_line() { read_roster | awk -v n="$1" '$1 == n {print $2, $3, $4; exit}'; }
roster_names() { read_roster | awk '{print $1}'; }
install_identity_args() { # NAME AGENT ROLE — shell words for remote install.sh
  local names
  names="$(roster_names)"
  if grep -qx -- "$1" <<<"$names"; then
    printf "%s" "--box '$1'"
  else
    printf "%s" "--agent '$2' --role '$3'"
  fi
}
# The vendor's own login instruction, for the by-hand step that replaced
# `crew auth`. Falls back to something honest rather than printing nothing.
login_hint() {
  local h
  h="$(sed -n 's/^AGENT_LOGIN_HINT=//p' "$(agent_conf "$1")" 2>/dev/null | tr -d '"')"
  printf '%s\n' "${h:-run the $1 CLI login}"
}

validate_profiles() {  # agent role
  [ -f "$(agent_conf "$1")" ] || usage_error "unknown agent '$1' — see: crew profiles"
  [ -f "$ROLES_DIR/$2.conf" ]  || usage_error "unknown role '$2' — see: crew profiles"
}

# Can THIS host's box size a clone? box 0.10.0 made --cpu/--memory/--disk ride
# a `--from` copy; every box before it rejected them outright (box#171, #607
# D5). Probed off the help text rather than compared against `box --version`,
# for the reason box_supports_force_down is: the question is what this binary
# does, and a version string is a proxy for it that a fork or a local build
# gets wrong. The needle is box's own sentence for the capability.
#
# `tr` first, because that sentence WRAPS in the help output — "A --from clone
# instead accepts the\nexplicit --cpu/--memory/--disk flags" — and a
# line-oriented match on it silently never fires, which fails safe here (the
# clone is merely unsized) and is still a wrong answer.
#
# Fails CLOSED on anything unexpected: no box, an error, a help text that does
# not say it. The cost of a false no is a clone at the source's size and a line
# saying so; the cost of a false yes is a `crew new` that dies on a roster line
# that worked yesterday, which is #590 all over again.
box_supports_clone_sizing() {
  local help
  help="$(box new --help 2>&1 | tr '\n' ' ' || true)"
  grep -qE -- '--from clone[^.]*accepts[^.]*--cpu' <<<"$help"
}

# box_size_fields NAME — what the instance actually carries, tab-separated as
# CPU, MEMORY, DISK. Three fields and not one string, because #607 D5 as
# amended is answered PER FIGURE: cpu, memory and disk land or fail
# independently now, so the reporter has to compare them one at a time.
#
# `box info --json` is a raw `incus list --format json` passthrough, and these
# are incus's own documented keys rather than a shape crew is guessing at:
# limits.cpu and limits.memory in the config, the root device's size beside
# them. Expanded first — the question is what the box will RUN with, and a
# limit set by a profile is as real as one stamped on the instance.
#
# A figure that does not read is "?" and never a plausible default. The shell
# defaults below are the second half of that: jq's `//` answers a key that is
# missing from a document, and `${cpu:-?}` answers a document that never
# arrived — no box, no daemon, unparseable output. The disk figure is genuinely
# absent on a container, whose root rides the storage pool, so "?" there is an
# answer and not a failure.
box_size_fields() { # NAME
  local raw cpu mem disk
  raw="$(box info "$1" --json 2>/dev/null \
    | jq -r 'if type == "array" then (.[0] // {}) else . end
             | (.expanded_config // .config // {}) as $c
             | (.expanded_devices // .devices // {}) as $d
             | [($c["limits.cpu"] // "?"),
                ($c["limits.memory"] // "?"),
                ((($d.root // {}).size) // "?")] | @tsv' 2>/dev/null \
    | head -1 | tr -d '\r' || true)"
  IFS=$'\t' read -r cpu mem disk <<<"$raw"
  printf '%s\t%s\t%s\n' "${cpu:-?}" "${mem:-?}" "${disk:-?}"
}

# size_verdict ASKED FIGURE READ WANT — one figure's answer, in the three words
# the note is allowed to say. ASKED is the space-fenced list of flags crew
# actually passed, so this never has to infer intent from an outcome.
#
#   NOT applied  — crew did not ask for it, or asked and the daemon reports
#                  something else
#   applied      — crew asked and the read-back agrees
#   unverified   — crew asked and the figure does not read back at all
#
# The middle case is deliberately biased: an incus that normalises a unit
# ("8GiB" stored as a byte count) would be reported NOT applied when it did
# apply. That is the safe direction and the note prints both figures beside the
# verdict, so an operator can see the disagreement — whereas the other error,
# claiming a landing crew never verified, is exactly the silence D5 forbids.
#
# The FIRST case reads the same way on a coincidence, and that is also
# deliberate: a gold snapshot already carrying the role's disk reports "disk
# NOT applied" beside two identical figures, because crew withheld --disk and
# so verified nothing. "applied" means crew asked and confirmed, never crew
# looked and liked what it saw — a snapshot that happens to agree today is one
# re-gold away from disagreeing, and the note that claimed it landed would not
# move. Both figures are on the line, so the coincidence is legible.
size_verdict() { # ASKED FIGURE READ WANT
  case "$1" in
    *" $2 "*) ;;
    *) printf 'NOT applied\n'; return ;;
  esac
  if [ "$3" = "$4" ]; then printf 'applied\n'
  elif [ "$3" = '?' ]; then printf 'unverified\n'
  else printf 'NOT applied\n'; fi
}

# clone_size_report NAME ROLE ASKED WANT_CPU WANT_MEM WANT_DISK WHY — the ONE
# line every `--from` clone owes its operator (#607 D5, amended by triage
# 2026-09-03 to be answered per figure).
#
# EVERY clone, not only the one that could not be sized: with --disk withheld
# on this path by construction (see create_box), even the best case is a
# PARTIAL landing, and "a partial landing is a legitimate outcome and must be
# said out loud" is the criterion's own wording. A branch that printed nothing
# because two of three figures rode would be the silent case in better clothes.
#
# The wanted figures are ARGUMENTS and not create_box's locals reached through
# bash's dynamic scope: this function is the thing #607 is about, and a caller
# that has to set three variables with the right names to use it is one rename
# away from reporting a size nobody asked for.
#
# THE RESIZE ROUTE NAMES ALL THREE FIGURES, including ones that landed. Memory
# is the reason #607 exists — codex-reviewer died with exit 137, not out of
# disk — so a route that skipped it left an operator following the line
# verbatim repairing the two figures that did not kill the box. It is also not
# a per-figure route: the verdicts are already on the line, and printing the
# whole route once is a command an operator can run against whatever they see
# there, rather than a second thing to reconcile with the first.
clone_size_report() { # NAME ROLE ASKED WANT_CPU WANT_MEM WANT_DISK WHY
  local name="$1" role="$2" asked=" $3 " want_cpu="$4" want_mem="$5" want_disk="$6" why="$7"
  local cpu mem disk
  IFS=$'\t' read -r cpu mem disk <<<"$(box_size_fields "$name")"
  echo "note: $name — cpu $(size_verdict "$asked" cpu "$cpu" "$want_cpu"), memory $(size_verdict "$asked" memory "$mem" "$want_mem"), disk $(size_verdict "$asked" disk "$disk" "$want_disk"); it carries $cpu cpu / $mem / $disk and the $role profile asks $want_cpu cpu / $want_mem / $want_disk. $why (resize: box incus $name -- config set {} limits.cpu $want_cpu, config set {} limits.memory $want_mem, and config device set {} root size=$want_disk with the box stopped first — box new --help says why)"
}

# create_box NAME AGENT ROLE [FROM] — infrastructure only, no engine.
create_box() {
  local name="$1" agent="$2" role="$3" from="${4:-}"
  local BOX_CPU="" BOX_MEMORY="" BOX_DISK=""
  # D2 (#589): an `armed` checkpoint is a CREDENTIAL AT REST, and it is not a
  # gold image. Cloning one mints a second box carrying the first box's gh
  # identity, its vendor login and its engine — the fleet's own #294 failure
  # arrived at from the other side, and it would arrive silently, because the
  # clone comes up working. Guarded HERE rather than in cmd_new so that every
  # route to a clone is covered: `crew new --from`, and a roster line whose
  # fourth column names one, which `create-all` and `up` both read.
  case "$from" in
    */"$RESET_LABEL")
      die "refusing to clone '$from': an $RESET_LABEL checkpoint contains ${from%%/*}'s live credentials and engine, so a box minted from it carries that box's identity. Gold images are the clone source (crew gold <box>)" ;;
  esac
  # shellcheck disable=SC1090
  source "$ROLES_DIR/$role.conf"
  if [ -z "$BOX_CPU" ] || [ -z "$BOX_MEMORY" ] || [ -z "$BOX_DISK" ]; then
    die "role '$role' declares no BOX_CPU/BOX_MEMORY/BOX_DISK"
  fi
  # </dev/null on both: create_box runs inside the create-all and up roster
  # loops, which read from a FIFO any stdin-inheriting `box` call would drain
  # (#48). Neither form takes input — every argument is on the command line.
  #
  # THE CLONE PATH TAKES --cpu AND --memory AGAIN, AND NEVER --disk (#607 D5,
  # as amended by triage 2026-09-03). The refusal those flags were removed for
  # was real: `box new --from` used to reject all three outright, so every
  # roster line with a 4th-column gold snapshot died at `crew new` (#590). box
  # 0.10.0, tagged 2026-09-02, reverses that for cpu and memory — they ride the
  # copy, incus sizing the clone as it creates it, with no resize, no restart
  # and no step inside the guest (box#171).
  #
  # --disk IS NOT THE SAME FLAG AND IT IS THE ONE THAT CAN COST THE MINT.
  # `box new --help` states its precondition and bin/box:2179-2186 implements
  # it: --disk rides a copy only where the SOURCE has a root device of its own.
  # A container source takes a note and clones anyway; a VM whose root comes
  # from a profile — or a source box cannot read, which box treats as the same
  # answer — makes box refuse and die BEFORE `incus copy`, so nothing is
  # created at all. That is #590's outcome one layer further in, produced by
  # #607's own fix, and the ruling on this issue forbids it in as many words:
  # no branch may turn a roster line that mints today into one that does not.
  #
  # So crew does not ask. It is not that the question is hard — it is that crew
  # cannot ask it: box reads the source with `incus config show <srcref>`, and
  # crew's only window on the daemon is `box info --json`, an `incus list` over
  # INSTANCES, which cannot see the `<box>/<snapshot>` ref a 4th column holds.
  # A crew-side pre-flight would be a copy of another tool's precondition, read
  # off a different object, drifting the first time box edits it. The disk is
  # reported as not landing instead, with the route to resize it.
  #
  # PROBED, not version-compared, and the probe governs the two flags that do
  # ride: this host's box is whatever the operator installed, and passing them
  # to one that predates 0.10.0 re-breaks #590 for the same rosters. Same idiom
  # as box_supports_force_down. Either way the clone ends in ONE line saying
  # what landed and what did not — a builder minted from a reviewer-sized gold
  # comes up on the reviewer's disk regardless, and finding that out under load
  # is what the report exists to prevent.
  if [ -n "$from" ]; then
    if box_supports_clone_sizing; then
      echo "creating $name  (role=$role agent=$agent from=$from cpu=$BOX_CPU mem=$BOX_MEMORY)"
      box new --name "$name" --from "$from" \
        --cpu "$BOX_CPU" --memory "$BOX_MEMORY" </dev/null
      clone_size_report "$name" "$role" "cpu memory" \
        "$BOX_CPU" "$BOX_MEMORY" "$BOX_DISK" \
        "crew does not pass --disk on a copy: box serves it only from a source with a root device of its own and refuses before anything is created, so asking would trade this box for a clearer number (box#171)"
    else
      echo "creating $name  (role=$role agent=$agent from=$from)"
      box new --name "$name" --from "$from" </dev/null
      clone_size_report "$name" "$role" "" \
        "$BOX_CPU" "$BOX_MEMORY" "$BOX_DISK" \
        "this host's box predates $CREW_PLATFORM_BOX_MIN clone sizing and rejects the flags on a copy, so the clone carries $from's size"
    fi
  else
    # THE FRESH MINT IS NOT SPELLED HERE ANY MORE (#679 D9). It used to be
    # `box new --template "$agent-box"`, which box 0.10.0 refuses outright
    # (bin/box:2094-2096) while `crew down --force` has required box 0.10.0 or
    # later since it landed — so crew could not mint a box on the platform its
    # own floor requires. The replacement is a blank mint plus a rig bootstrap,
    # and drill/rehearsal.sh mints too, so the sequence lives in ONE writer that
    # both call rather than in two copies a human keeps agreeing.
    echo "creating $name  (role=$role agent=$agent cpu=$BOX_CPU mem=$BOX_MEMORY disk=$BOX_DISK user=$agent rig-role=$agent-box)"
    box_mint_fresh "$name" "$agent" "$BOX_CPU" "$BOX_MEMORY" "$BOX_DISK"
  fi
}

# box_agent NAME — the agent the box was ACTUALLY installed as, per the
# instance.conf install.sh wrote. Empty on an unhired box. Parsed rather than
# sourced: one string is not worth executing a config for.
#
# `|| true` is load-bearing, exactly as it is in box_state: under `set -o
# pipefail` this pipeline takes bxn's status, so an unreachable box made
# `actual="$(box_agent …)"` fail and `set -e` killed the whole status loop —
# after four of six rows, which is the same silent-truncation shape as #48.
box_agent() {
  bxn "$1" 'sed -n "s/^BOT_AGENT=//p" ~/duty/conf/instance.conf 2>/dev/null | head -1' 2>/dev/null \
    | tr -d '"'\''\r\n' || true
}

# engine_report NAME [--paths] — ONE exec: which engine this box carries, and
# whether its files are still that engine (#159).
#
# Both facts on the same round trip because `crew status` needs both on every
# row and the budget was explicit: no additional round trip per box. This
# replaces the bare `head -1 ~/duty/VERSION` that hired_at used to make, so the
# fleet table costs exactly what it cost before.
#
# Emits key=value lines:
#     state=current|modified|unverified|absent
#     stamp=<the ~/duty/VERSION first line>
#     recorded=<the stamp the engine manifest was recorded at>
#     path=<modified|added|removed> <relpath>     (--paths, when modified)
#
# key=value rather than one delimited record on purpose: a TAB-joined line read
# back with `read -r a b c` collapses an empty field into the next one, and the
# empty field here — `recorded=` on an unverified box — is the common case
# until the fleet has upgraded once.
engine_report() {
  local name="$1" paths="${2:-}"
  # shellcheck disable=SC2016  # $HOME must expand INSIDE the box
  bxn "$name" '
    if [ -x "$HOME/duty/bin/engine-manifest.sh" ]; then
      "$HOME/duty/bin/engine-manifest.sh" --report '"$paths"'
    else
      # An engine installed before content stamping ships no tool to compute
      # an engine manifest and recorded none. That is UNVERIFIED, never
      # modified: a fleet that reads modified everywhere on the day this lands
      # has learned that the word means nothing. One upgrade cures it.
      if [ -s "$HOME/duty/VERSION" ]; then echo state=unverified; else echo state=absent; fi
      echo "stamp=$(head -1 "$HOME/duty/VERSION" 2>/dev/null)"
      echo recorded=
    fi
  ' 2>/dev/null | tr -d '\r' || true
}

# report_field KEY REPORT — one value out of an engine_report or rig_report
# capture. The `^` is what makes rig_report's `rig:` namespace real rather than
# decorative: unanchored, a plain `schema` would be answered by `rig:schema=1`,
# and the namespace it was added to provide would be gone. Keeping rig's two
# provenance PAIRS apart is a different discipline and lives at the call sites
# — ask for the whole key (`rig:converged_at`), never for the family (`.*_at=`),
# because /etc/rig/manifest carries `bootstrapped_at=` two lines above
# `converged_at=` and a family read answers with the first one it meets.
report_field() { printf '%s\n' "$2" | sed -n "s/^$1=//p" | head -1; }

# The marker that lets the session budget (#464 D7) ride along with the detail
# view's duty-log read instead of buying a round trip of its own. See
# status_probe: #221 fixed the detail view's cost at THREE execs and
# fleet-floor/test/cli.sh asserts the number, so a fourth question is a
# different and more expensive change than the one D7 asked for.
STATUS_PROBE_MARK="::crew-budget-end::"
# The bounded tick-health report rides in the same detail-view exec (#484).
STATUS_HEALTH_MARK="::crew-health-end::"
# The second section boundary in that same one exec: the box vitals record
# (#483) rides between the budget and the duty-log tail. Still THREE round
# trips — #221's budget is a count of execs, not of questions, and this is one
# more line in the exec already being made.
STATUS_VITALS_MARK="::crew-vitals-end::"

# vitals_finding RAW — `name:k=v,k=v` -> `name: k=v, k=v`.
#
# Byte-for-byte what floor.units._vitals_finding produces, because the finding
# an operator reads on the console and the finding they read here have to be
# one string: a reworded finding is a finding nobody can grep the log for.
vitals_finding() {
  local name="${1%%:*}" detail="${1#*:}"
  if [ "$detail" = "$1" ] || [ -z "$detail" ]; then printf '%s\n' "$name"; return 0; fi
  printf '%s: %s\n' "$name" "${detail//,/, }"
}

# vitals_rows RECORD — one box vitals record as `<label><TAB><text>` rows.
#
# THIS FUNCTION IS HALF OF A CONTRACT WITH fleet-floor/index.html. #483's
# acceptance criterion is that `crew status` and the floor render the same
# record and CANNOT disagree, and two readers in two languages only hold that
# if the strings are pinned rather than each side owning a phrase-book. So the
# labels and the text here are exactly what `boxVitalsRows` builds, and
# fleet-floor/test/cli.sh drives ONE captured record through both and asserts
# the outputs are identical. Change a word here and that test reds until the
# page says the same word.
#
# Nothing is measured, converted or re-derived: the tick measured it, this
# quotes it. Figures stay in the MiB the probe wrote — a friendlier `5.8 GiB`
# on one reader and `5948 MiB` on the other is precisely the disagreement the
# criterion forbids, wearing a courtesy.
#
# A row is emitted only when every field it needs is on the record. D6 is
# per-field degradation, so a box whose `free` failed has no memory row rather
# than a row of dashes, which would read as a measurement of nothing.
vitals_rows() {
  local record="${1:-}"
  case "$record" in "VITALS ts="*) : ;; *) return 0 ;; esac
  local -A f=()
  local -a parts=() findings=()
  local series="" tok key val
  # `read -ra`, never `for tok in $record`: the record is unquoted box output,
  # and word-splitting it in a for-loop would also GLOB it — one `*` in a
  # future field and the reader starts listing the working directory.
  read -ra parts <<<"$record"
  for tok in "${parts[@]}"; do
    key="${tok%%=*}"; val="${tok#*=}"
    if [ "$key" = "$tok" ]; then continue; fi   # a bare token is not a field
    if [ -z "$val" ]; then continue; fi         # an empty value is an ABSENCE
    case "$key" in
      finding) findings+=("$(vitals_finding "$val")") ;;
      disk_series) series="$val" ;;
      *) f["$key"]="$val" ;;
    esac
  done

  # `${x:+ suffix}` and not a command substitution: an optional half of a row
  # is a string operation, and buying a subshell per row for it would also put
  # every one of these behind `set -e` semantics that have nothing to do with
  # what is being asked.
  if [ -n "${f[cores]:-}" ]; then
    printf 'Cores\t%s%s\n' "${f[cores]}" "${f[load1]:+ · load1 ${f[load1]}}"
  fi
  if [ -n "${f[mem_total_mb]:-}" ] && [ -n "${f[mem_avail_mb]:-}" ]; then
    printf 'Memory\t%s of %s MiB available%s\n' "${f[mem_avail_mb]}" "${f[mem_total_mb]}" \
      "${f[mem_shared_mb]:+ · ${f[mem_shared_mb]} MiB shared}"
  fi
  if [ -n "${f[disk_total_mb]:-}" ] && [ -n "${f[disk_used_mb]:-}" ] &&
     [ -n "${f[disk_pct]:-}" ]; then
    printf 'Disk\t%s of %s MiB used · %s%%\n' \
      "${f[disk_used_mb]}" "${f[disk_total_mb]}" "${f[disk_pct]}"
  fi
  # Always BOTH numbers, never a derived "swap is fine". The pair IS the
  # finding: 0 active beside 12288 configured is a swapfile holding a quarter
  # of the disk and doing nothing, and either number alone looks explicable.
  if [ -n "${f[swap_active_mb]:-}" ] && [ -n "${f[swap_configured_mb]:-}" ]; then
    printf 'Swap\t%s MiB active of %s MiB configured\n' \
      "${f[swap_active_mb]}" "${f[swap_configured_mb]}"
  fi
  # D5 — the backfilled series, so the disk history starts where the box did.
  # Purely historical: the live reading is the Disk row above, and splicing the
  # two into one arrow would put a figure measured this second on the end of a
  # series read out of a log.
  if [ -n "$series" ]; then
    local -a points=() good=()
    local p st pc span noun
    IFS=',' read -ra points <<<"$series"
    for p in "${points[@]}"; do
      case "$p" in *@*) ;; *) continue ;; esac
      st="${p%@*}"; pc="${p##*@}"
      if [ -z "$st" ]; then continue; fi
      case "$pc" in ''|*[!0-9]*) continue ;; esac
      good+=("$st@$pc")
    done
    if [ "${#good[@]}" -gt 0 ]; then
      p="${good[0]}"
      if [ "${#good[@]}" -gt 1 ]; then
        span="${p##*@}% → ${good[$(( ${#good[@]} - 1 ))]##*@}%"
        noun="boot readings"
      else
        span="${p##*@}%"
        noun="boot reading"
      fi
      printf 'Disk since\t%s · %s over %s %s\n' "${p%@*}" "$span" "${#good[@]}" "$noun"
    fi
  fi
  if [ -n "${f[platform]:-}" ]; then
    printf 'Platform\t%s%s\n' "${f[platform]}" "${f[os]:+ · ${f[os]}}"
  fi
  local finding
  for finding in ${findings[@]+"${findings[@]}"}; do
    printf 'Finding\t%s\n' "$finding"
  done
}

# rig_report NAME — ONE exec: did rig's tenant bootstrap converge this box, and
# which rig did it (#220). Read BEFORE hiring, which is the whole point — every
# other column crew has (GH, VENDOR, ENGINE) is derived through the engine, and
# the engine does not exist until hire, so for exactly the window in which
# convergence is the only thing that matters every existing signal reads
# `unknown`.
#
# Two files, because rig writes two and they answer different questions. Both
# shapes below are quoted from a real rig-converged tenant box (this one, rig
# 0.3.2-dev), not inferred from rig's source:
#
#     /etc/rig/role      role=claude-box tenant=yes host=no
#     /etc/rig/manifest  schema=1
#                        bootstrapped_by=0.3.2-dev
#                        bootstrapped_at=2026-08-01T12:31:11Z
#                        converged_by=0.3.2-dev
#                        converged_at=2026-08-01T12:31:11Z
#
# `/etc/rig/role` is what the box IS — ONE line of space-separated key=value,
# written only after the tenant bootstrap converged — and `/etc/rig/manifest`
# is what BUILT it, key=value PER LINE. The marker decides the verdict; the rig
# manifest only enriches the report, because a marker with no rig manifest
# beside it is a box converged by a rig older than that file, which is old, not
# broken.
#
# Both are 0644, so the read takes no `sudo` and must not grow one: a `sudo` in
# a non-interactive `box exec` is itself a way to turn a converged box into a
# false INCOMPLETE.
#
# Emits key=value lines:
#     probe=ok                      (always, when the box answered at all)
#     marker=<the marker's first line>          (omitted when absent)
#     rig:<k>=<v>                   one per /etc/rig/manifest line (omitted when absent)
#
# The box side does no INTERPRETING — it cats the two files and namespaces the
# provenance one under `rig:`, and every semantic read happens back here through
# report_field. That split is deliberate: the box side of an exec is the half
# no offline test can reach (a stub intercepts the whole script and answers for
# it), so anything that decides a meaning has to sit on this side of it or it
# ships unexercised. The `rig:` namespace says whose keys those are and keeps a
# future rig manifest key from answering for one of crew's own report keys.
#
# `probe=ok` is the load-bearing line and not a decoration: without it an
# unreachable box and a converged-but-markerless one both capture as the empty
# string, and the spec's rule 5 is that those two must never collapse — the
# failure this closes is a broken box passing for a healthy one, so the
# ambiguous case has to be nameable. `|| true` for the same reason it is on
# box_state, box_agent and engine_report: an unreachable box must degrade to a
# verdict, never kill the caller under `set -e`.
rig_report() {
  # shellcheck disable=SC2016  # the substitutions must run INSIDE the box
  bxn "$1" '
    echo probe=ok
    if [ -r /etc/rig/role ]; then
      printf "marker=%s\n" "$(head -n1 /etc/rig/role 2>/dev/null)"
    fi
    if [ -r /etc/rig/manifest ]; then
      sed "s|^|rig:|" /etc/rig/manifest 2>/dev/null
    fi
  ' 2>/dev/null | tr -d '\r' || true
}

# convergence_of REPORT — the verdict from a rig_report capture:
#
#     converged   the marker is there and names an agent tenant
#     incomplete  the box answered and rig never converged it
#     unknown     the box did not answer, so nothing is known
#
# `unknown` is NOT converged. That is rule 5 of #220's spec and it is the whole
# safety property: the defect being closed is a broken box reading as a healthy
# one, so the case crew cannot see into must refuse rather than proceed.
#
# The tenant test is FIELD-ANCHORED, never a substring — the marker is one line
# of space-separated key=value fields, and rig's own root_door_of learned this
# the hard way on rig#77, where an unanchored pattern let `root-door=closedish`
# resolve as `closed` and pass the one gate that authorizes an irreversible
# act. Hiring is crew's irreversible act. Whitespace is normalised first so a
# hand-edited marker using tabs is read the same way rather than silently
# failing to match.
#
# BOTH halves of #220's pinned rule are required — a non-empty `role=` AND
# `tenant=yes`. rig writes the two in one line, so a marker carrying one and
# not the other is a box it was interrupted partway through converging, and
# mid-convergence is exactly what this refuses.
convergence_of() {
  local report="$1" marker
  grep -qx 'probe=ok' <<<"$report" || { printf 'unknown\n'; return 0; }
  marker="$(report_field marker "$report")"
  [ -n "$marker" ] || { printf 'incomplete\n'; return 0; }
  case "$(marker_fault "$marker")" in
    "") printf 'converged\n' ;;
    *)  printf 'incomplete\n' ;;
  esac
}

# marker_fault MARKER — empty when the marker line names a converged agent
# tenant, otherwise the one clause saying which half of it is wrong.
#
# ONE reader, because the verdict and the reason must never disagree about a
# marker: a row reading INCOMPLETE beside a detail naming nothing missing is a
# refusal an operator cannot act on, and two copies of a field-anchored parse
# is how that starts.
marker_fault() {
  local padded role
  padded=" ${1//[[:space:]]/ } "
  case "$padded" in
    *" role="*) role="${padded##* role=}"; role="${role%% *}" ;;
    *) role="" ;;
  esac
  if [ -z "$role" ]; then
    printf '/etc/rig/role carries no role= field (%s) — the marker is half-written\n' "$1"
    return 0
  fi
  case "$padded" in
    *" tenant=yes "*) : ;;
    *) printf '/etc/rig/role names a machine role (%s), not an agent tenant\n' "$1" ;;
  esac
}

# convergence_detail REPORT — what is missing, in one clause, for the operator
# who has to fix it. The causes take different actions — reach the box, run the
# bootstrap, look at a marker that is there and wrong — so collapsing them into
# "not converged" would throw away the only part of this that is actionable.
convergence_detail() {
  local report="$1" marker
  grep -qx 'probe=ok' <<<"$report" ||
    { printf 'the box did not answer: /etc/rig/role could not be read\n'; return 0; }
  marker="$(report_field marker "$report")"
  if [ -z "$marker" ]; then
    printf 'no /etc/rig/role marker: rig bootstrap never converged this box, so its vendor CLI was never installed\n'
  else
    marker_fault "$marker"
  fi
}

# convergence_recovery NAME AGENT — the three commands that fix it, which are
# the ones `box` itself prints when the bootstrap hook fails. crew's job here
# is to stop advising `crew hire` and start advising this.
#
# An off-roster box names no agent, and the recovery is still worth printing —
# it renders the tenant as `<agent>-box` rather than a malformed `-box`, which
# is a placeholder an operator can fill in rather than a command that would
# fail if pasted.
convergence_recovery() {
  local name="$1" agent="${2:-}"
  printf 'box shell %s → sudo rig bootstrap %s-box → box snapshot %s bootstrapped\n' \
    "$name" "${agent:-<agent>}" "$name"
}

# hired_at NAME — the raw first-line engine stamp, if any. Keep this raw for
# status and provenance; comparisons go through stamp_version below.
hired_at() { report_field stamp "$(engine_report "$1")"; }

# is_engine_version STRING — is this an engine version and not merely a
# nonempty string? ONE definition, because there are now two readers: the stamp
# parser below, and `crew reset`'s check that a recorded checkpoint version can
# be compared with a box's at all. Two copies of this shape would drift, and
# the direction it would drift in is a version that one side accepts and the
# other refuses — which is exactly the disagreement #589 D5 is about.
is_engine_version() { # STRING
  [[ "${1:-}" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[A-Za-z0-9][A-Za-z0-9.-]*)?$ ]]
}
# stamp_version STAMP — print the version from a current-format stamp.
# SHA-only legacy stamps deliberately fail to parse: they still prove the box
# is hired, but cannot compare equal to a version and therefore re-bake once.
stamp_version() {
  local stamp="${1:-}" version
  case "$stamp" in
    crew@*) version="${stamp#crew@}"; version="${version%% *}" ;;
    *) return 1 ;;
  esac
  if is_engine_version "$version"; then
    printf '%s\n' "$version"
  else
    return 1
  fi
}

# vendor_probe NAME AGENT — run the agent profile's bot_cli_probe inside the
# box, shipping the profile over stdin (works on unhired boxes too).
vendor_probe() {
  box exec "$1" -- bash -lc \
    'cat >/tmp/.crew-agent-probe.conf; source /tmp/.crew-agent-probe.conf; bot_cli_probe' \
    <"$(agent_conf "$2")" >/dev/null 2>&1
}

# auth_from_flow NAME — the box's credential state as the DUTY ENGINE last
# observed it, in one exec of pure local file reads. Echoes thirteen fields:
#
#     <gh-state> <vendor-state> <tick-age-seconds-or--1> <armed> <paused>
#     <suppression-age-or--1> <lane-or--> <repo#pr@head-or-->
#     <log-present> <session-active> <lock-age-or--1>
#     <session-kind-or--> <session-ceiling-seconds-or--1>
#
# The last two are the in-flight `SESSION START`'s own `kind=` and `timeout=`,
# and they are APPENDED for the reason the field order already had one: a field
# added at the end cannot push an existing one off the line a caller `read`s,
# which is how the #189 count bug shipped. They cost nothing — the line they
# come off is already inside the 600-line tail this function already takes, and
# already matched by the awk pass below. Nothing new is fetched and there is no
# second `box exec`.
#
# They exist because `crew status` and the floor must grade one lock the same
# way. The floor measures a held lock against the ceiling the running session
# declared on its own record (#610); a CLI firing at a fleet-wide constant
# called a `build` forty minutes into its governed 3600s STUCK while the floor
# called it healthy, in front of the same operator, about the same box (#624).
# The ceiling is read off the WIRE and never out of `shared/conf/roles/*.conf`:
# those are the box's files, the box already states its own ceiling on the
# record, and a host-side copy is a second source of truth that drifts on the
# first role edit.
#
# `armed` and `paused` are crontab line COUNTS, read with probe.sh's own
# patterns, so `crew status` and the floor answer "is this box armed?" from
# one source instead of two (#189: the floor called every unarmed box SILENT,
# and the CLI could not answer the question at all).
#
# where a state is flowing | waiting | stale | missing | unknown, the same
# vocabulary fleet-floor's probe.sh emits — including `stale`, which is the
# difference between an engine that is INSTALLED and one that is RUNNING.
# VERSION alone proves only the first, so a disarmed box with a dead token
# reported `flowing` until this required a recent tick too. `waiting` splits
# the never-ticked box back out of `stale`: it has not STOPPED ticking, it has
# not STARTED (#265).
#
# The box reports the tick AGE and this host applies the rule, exactly as the
# floor does with probe.sh's ::tickage. A threshold baked into the in-box
# script would be a third copy of a number floor.py derives from TICK_S, and
# the drill asserts these two readers agree — so a drift here fails it for a
# reason nobody would connect to a constant.
#
# This deliberately does NOT call `gh auth status` or bot_cli_probe. Those
# reach the network, and — more importantly — they are a SECOND source of
# truth. `rehearsal-app.sh` asserts the floor and this CLI agree about every
# box, on the grounds that a disagreement means one of them is lying to an
# operator; that only holds while both read the same evidence. When the floor
# stopped polling credentials and started reading what the engine records,
# leaving `crew status` probing live would have manufactured exactly the
# disagreement the drill exists to catch — a box whose token died four
# minutes ago reading MISSING here and `flowing` there.
#
# Live probing survives where it belongs: `crew hire` and the boot gate pay
# for certainty once, at the moment someone is standing there to fix it.
auth_from_flow() {
  # shellcheck disable=SC2016  # $HOME and $svc must expand INSIDE the box
  bxn "$1" '
    for svc in gh vendor; do
      if [ -s "$HOME/duty/.auth-fail.$svc" ]; then printf "missing "
      elif [ ! -s "$HOME/duty/VERSION" ]; then printf "unknown "
      else printf "nofail "; fi
    done
    age=-1; log_timestamped=0; session_active=0; lockage=-1
    session_kind=-; session_ceiling=-1
    if [ -r "$HOME/duty/duty.log" ]; then
      log_tail="$(tail -n 600 "$HOME/duty/duty.log")"
      ts="$(printf "%s\n" "$log_tail" | grep -oE "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z" | tail -1)"
      if [ -n "$ts" ]; then
        log_timestamped=1
        age=$(( $(date -u +%s) - $(date -u -d "$ts" +%s 2>/dev/null || echo 0) ))
      fi
      # Match floor.units.derive_sessions: END pops the newest unmatched START,
      # and an orphan older than six hours is a crashed session, not live work.
      #
      # `kind=` and `timeout=` are SCANNED, never counted off as fields, for
      # the reason floor.units gives about RE_END: the engine appends new
      # tokens to this line (holder=, sid=), so a reader that assumed a
      # position would break on the next one. `timeout=` is also OPTIONAL —
      # absent on every line an engine older than #538 wrote — and a line
      # carrying none must leave the ceiling at -1 rather than at a guess.
      # Both are carried per depth, so the pop above discards the popped
      # session'\''s numbers with its timestamp instead of leaking them upward.
      session_flow="$(printf "%s\n" "$log_tail" | awk "
        / SESSION END / { if (depth > 0) depth--; next }
        / SESSION START / { depth++; started[depth]=substr(\$0, 1, 20)
          k = \"-\"
          if (match(\$0, / kind=[^ ]+/)) k = substr(\$0, RSTART + 6, RLENGTH - 6)
          c = -1
          if (match(\$0, / timeout=[0-9]+s/) &&
              (RSTART + RLENGTH > length(\$0) || substr(\$0, RSTART + RLENGTH, 1) == \" \"))
            c = substr(\$0, RSTART + 9, RLENGTH - 10)
          kinds[depth] = k; ceilings[depth] = c
        }
        END { if (depth > 0) print started[depth], kinds[depth], ceilings[depth] }
      ")"
      if [ -n "$session_flow" ]; then
        read -r session_start session_kind session_ceiling <<<"$session_flow"
        session_kind="${session_kind:--}"; session_ceiling="${session_ceiling:--1}"
        session_epoch="$(date -u -d "$session_start" +%s 2>/dev/null || echo 0)"
        case "$session_epoch" in
          ""|*[!0-9]*) : ;;
          *) [ $(( $(date -u +%s) - session_epoch )) -lt 21600 ] && session_active=1 ;;
        esac
        # Past that bound the floor has no session at all — `cur` is None, so
        # it holds no kind and no ceiling. Say the same thing on the wire
        # rather than emitting a dead START'\''s numbers and relying on every
        # future reader to gate them: an inertly wrong field is a second
        # source of truth that happens to be unread, and this helper exists
        # to refuse those. Nothing rendered moves — `cmd_status` already
        # gates on session_active — which is what makes it safe to state.
        [ "$session_active" = 1 ] || { session_kind=-; session_ceiling=-1; }
      fi
    fi
    if [ -r "$HOME/duty/.duty.lock.since" ]; then
      lock_since="$(cat "$HOME/duty/.duty.lock.since" 2>/dev/null || echo)"
      case "$lock_since" in ""|*[!0-9]*) : ;; *) lockage=$(( $(date +%s) - lock_since )) ;; esac
    fi
    # Live tick.sh crontab lines. The pattern is probe.sh'\''s ::cron pattern
    # CHARACTER FOR CHARACTER, and it has to stay that way: this helper exists
    # because a CLI and a floor holding private sources of truth disagree in
    # front of an operator, and a private PATTERN is that defect wearing a
    # smaller hat — a box would read armed here and disarmed there.
    #
    # NO `||` guard, and that is deliberate. grep -c PRINTS the count and then
    # exits 1 when it is zero; `|| echo 0` appends a SECOND zero on a new line,
    # which pushes every later field off the line the caller reads. It shipped
    # that way for one review round: a paused box emitted "… 0\n0 1", `read`
    # saw only line 1, and the operator was told to `crew hire` a box they had
    # just paused — the precise outcome the comment below claims to prevent.
    # Nothing here runs under `set -e`, so the exit status is inert; the count
    # on stdout is the whole answer. probe.sh carries no guard either, which is
    # what makes the CHARACTER FOR CHARACTER claim above true.
    armed="$(crontab -l 2>/dev/null | grep -cE "^[^#].*tick\.sh")"
    # Both counts, because "not armed" has two causes with two different fixes:
    # the console'\''s Pause comments the line out (resume it), and an unarmed
    # box never had one (crew hire it). Telling an operator to re-hire a box
    # they paused thirty seconds ago is worse than saying nothing.
    paused="$(crontab -l 2>/dev/null | grep -cE "^#[[:space:]]*CREW-FLOOR-PAUSED")"
    sw=0; sk=-; sid=-
    for sf in "$HOME"/duty/.builder-suppressed.*; do
      [ -f "$sf" ] || continue
      IFS="$(printf "\t")" read -r when kind key <"$sf" 2>/dev/null || continue
      case "$when" in ""|*[!0-9]*) continue ;; esac
      [ -n "$kind" ] && [ -n "$key" ] || continue
      if [ "$sw" -eq 0 ] || [ "$when" -lt "$sw" ]; then sw="$when"; sk="$kind"; sid="$key"; fi
    done
    if [ "$sw" -gt 0 ]; then sage=$(( $(date +%s) - sw )); else sage=-1; fi
    printf "%s %s %s %s %s %s %s %s %s %s %s\n" \
      "$age" "$armed" "$paused" "$sage" "$sk" "$sid" \
      "$log_timestamped" "$session_active" "$lockage" \
      "$session_kind" "$session_ceiling"
    printf "\n"
  ' 2>/dev/null | tr -d '\r'
}

status_duration() {
  local age="${1:-0}"
  if [ "$age" -ge 3600 ]; then
    printf '%dh %02dm\n' "$(( age / 3600 ))" "$(( age % 3600 / 60 ))"
  elif [ "$age" -ge 60 ]; then
    printf '%dm\n' "$(( age / 60 ))"
  else
    printf '%ds\n' "$age"
  fi
}

# production_registry — the repo list THIS checkout would seed into a box.
#
# THROUGH `registry_entries`, WHICH IS THE POINT (#488). This used to read the
# fleet-wide file with its own `grep -vE '^[[:space:]]*(#|$)'` — the same
# entries, but as WRITTEN rather than stripped. That was harmless while
# hire_guard's inheriting branch assigned `reg="$prod"`, because the comparison
# below it was then false by construction. It stopped being harmless the moment
# that branch derived its side from `resolved_registry`, which strips: two
# readers of one file disagreeing about trailing whitespace, feeding a `!=`
# whose every difference is read as "this box is narrowed". One trailing space
# or a CRLF in a hand-edited `repos.txt` and #51's off-roster refusal is gone
# — while the guard's own line prints the production registry it is letting the
# box have. A registry file is defined by ONE reader in this CLI, and every
# comparison against it goes through that reader.
#
# `registry_entries` carries the `|| true` this function used to need, and for
# the same reason: an EMPTY or all-comment registry exits non-zero, pipefail
# takes that status, and `prod="$(production_registry)"` in hire_guard then
# dies under set -e with no message at all.
production_registry() {
  registry_entries "$REPOS_SEED" | sort
}
# The one-repo-one-fleet sweep below still walks the FLEET-WIDE list and needs
# no union with the per-box selections (#488). Under the operator's direction
# of 2026-08-29 a selection can only narrow — every repository any box watches
# is by construction a repository the fleet-wide registry names — so the
# fleet-wide list is not merely a good enough sweep set, it is exactly the set.
# Written down because the opposite is the intuitive reading of a per-box
# override, and was in fact this branch's first one: a free override CAN aim a
# droid at a board nobody else watches, and would have left that board — the
# one an operator just made a decision about — as the only one nothing checked
# for a second fleet. Containment is what removes the hole, and if containment
# is ever relaxed this sweep is the second thing that has to move.
# box_registry NAME — the repos.txt the box actually carries, or empty when it
# has none yet (install.sh seeds this box's own resolved default in that case).
#
# Through `registry_entries` too, and for `production_registry`'s reason: this
# is the OTHER side of hire_guard's production comparison, so an entry the box
# carries with a trailing space compares unequal to the same entry in the
# fleet's list and arms an off-roster box against production. That half is
# older than #488 — it is the asymmetry `tr -d '\r'` was added for, stopped one
# whitespace character short. The `tr` stays: it removes a carriage return
# anywhere in the line, where the strip only reaches the ends.
box_registry() {
  bxn "$1" 'grep -vE "^[[:space:]]*(#|\$)" ~/duty/repos.txt 2>/dev/null' 2>/dev/null \
    | tr -d '\r' | registry_entries - | sort || true
}

# fleet_static_identities — GitHub logins declared by the selected fleet.
# The roster names boxes and vendor profiles, not GitHub accounts, so its live
# identities are added separately below. Keep the source in a subshell: an
# operator fleet.conf is trusted configuration, but it must not overwrite this
# host CLI's state while we read three values from it.
fleet_static_identities() (
  FLEET_BENCH="" FLEET_TRIAGE="" FLEET_HUMAN=""
  # shellcheck disable=SC1090  # selected operator/shipped config, resolved above
  source "$FLEET_CONF"
  printf '%s\n' "$FLEET_BENCH" "$FLEET_TRIAGE" "$FLEET_HUMAN" | tr ' ' '\n'
)

# fleet_identities — configured participants plus authenticated roster boxes.
# A newly-created or logged-out box contributes nothing; the static bench and
# triage declarations still make detection useful before the whole fleet is up.
fleet_identities() {
  local name
  fleet_static_identities
  while read -r name; do
    if box_exists "$name"; then
      bxn "$name" 'gh api user --jq .login 2>/dev/null' 2>/dev/null | tr -d '\r' || true
    fi
  done < <(roster_names)
}

# foreign_actor_check — notice a likely second fleet on one of our boards.
# GitHub's repository event feed is shared board state, not a connection to
# another fleet. This deliberately warns after the fact and returns success:
# only operators decide which fleet keeps a repo, and this path never writes a
# registry (crew#70, option 2).
foreign_actor_check() {
  local allowed repo events parsed jq_err_file jq_err finding action actor
  allowed="$(fleet_identities | sed '/^$/d' | sort -u)"

  while read -r repo; do
    if ! events="$(gh api -X GET "repos/$repo/events?per_page=100" 2>/dev/null)"; then
      echo "crew: NOTE one-repo-one-fleet: could not inspect recent board activity for $repo; overlap detection skipped" >&2
      continue
    fi
    jq_err_file="$(mktemp)"
    if ! parsed="$(printf '%s' "$events" | jq -r '
      .[] |
      if .type == "IssuesEvent" and .payload.action == "assigned" then
        ["claim", (.payload.assignee.login // .actor.login)]
      elif .type == "IssuesEvent" and .payload.action == "opened" then
        ["mint", .actor.login]
      elif .type == "PullRequestReviewEvent"
           and ((.payload.review.state // "") | ascii_downcase)
               as $state
           | ($state == "approved" or $state == "changes_requested") then
        ["verdict", .actor.login]
      else empty end |
      select(.[1] != null) | @tsv
    ' 2>"$jq_err_file")"; then
      jq_err="$(<"$jq_err_file")"
      rm -f "$jq_err_file"
      echo "crew: NOTE one-repo-one-fleet: unreadable recent board activity for $repo ($jq_err); overlap detection skipped" >&2
      continue
    fi
    rm -f "$jq_err_file"
    [ -n "$parsed" ] || continue
    finding="$(while IFS=$'\t' read -r action actor; do
      if ! grep -Fxq "$actor" <<<"$allowed"; then
        printf '%s\t%s\n' "$action" "$actor"
        break
      fi
    done <<<"$parsed")"
    [ -n "$finding" ] || continue
    IFS=$'\t' read -r action actor <<<"$finding"
    echo "crew: WARN one-repo-one-fleet: foreign $action by @$actor in registered repo $repo indicates another fleet may also govern it." >&2
    echo "crew: WARN registries LEFT UNCHANGED — the operators must decide which fleet keeps $repo." >&2
  done < <(production_registry)
}

# hire_guard NAME ALLOW_OFFROSTER — refuse to arm an OFF-ROSTER box against the
# production registry. Always prints the registry it is about to arm against.
#
# `crew hire` on a leftover crew-drill-* box turned it into a SECOND production
# agent, with nothing in the path saying so (#51). The drill's teardown had
# worked correctly — it restored the pre-drill repos.txt, and "pre-drill" IS
# the shipped registry example — and install.sh correctly left that registry
# alone, because seeding only happens when the file is absent. So a hand-hire
# to re-arm the box armed cron against production, and within one tick a drill
# box was doing author-side duty on a real repo under the same identity as the
# real fleet, racing it for the same work. That tick was benign. The next need
# not be.
#
# The test is STRUCTURAL rather than a name convention (#51's third bullet):
# roster membership, plus the registry the box will actually work. That reaches
# an ad-hoc box called anything at all, and it lets a genuine drill box be
# hired the moment its registry is a sandbox — which is the state
# drill/rehearsal.sh leaves it in while it runs. `crew upgrade --all` already
# draws this same line for the same reason (#37).
hire_guard() {
  local name="$1" allow="$2" reg prod names
  prod="$(production_registry)"
  reg="$(box_registry "$name")"
  if [ -z "$reg" ]; then
    # The registry this box would actually get, which is its own selection from
    # the fleet-wide list when it has one (#488). Reading `$prod` here claimed
    # a box with a narrowing selection was about to be armed against
    # production, and the guard below then refused an off-roster box over a
    # registry it was never going to carry — the "dirty member" reading the
    # operator ruled out on 2026-08-29. A narrowed member is narrowed, and
    # `$reg` differing from `$prod` is what lets it through.
    reg="$(resolved_registry "$name" work | sort)"
    # A box selected down to NOTHING is a state this layer supports on purpose
    # — the containment state repos.txt's own header describes — so the line
    # says so rather than trailing off after "seed " with nothing behind it.
    if [ -z "$reg" ]; then
      echo "  registry: none yet — this box selects no repositories, so install.sh will seed an empty one"
    else
      echo "  registry: none yet — install.sh will seed $(printf '%s' "$reg" | tr '\n' ' ')"
    fi
  else
    echo "  registry: $(printf '%s' "$reg" | tr '\n' ' ')"
  fi
  names="$(roster_names)"
  if grep -qx -- "$name" <<<"$names"; then return 0; fi
  if [ "$reg" != "$prod" ]; then return 0; fi
  if [ "$allow" -eq 1 ]; then
    echo "  NOTE: $name is off-roster and carries the PRODUCTION registry — arming anyway (--allow-offroster)"
    return 0
  fi
  die "$name is not in $ROSTER, and hiring it would arm it against the PRODUCTION registry:
    $(printf '%s' "$prod" | tr '\n' ' ')
  That makes it a second production agent racing the fleet for the same work (#51).
  Narrow its registry first (for a drill box, drill/rehearsal.sh does exactly that),
  add it to the roster, or pass --allow-offroster if arming production is what you mean."
}

# convergence_guard NAME AGENT FORCE — refuse to arm a box whose tenant role
# never converged (#220). Returns 0 to proceed, 3 to SKIP.
#
# 3 rather than 1, and the distinction is the point: hire-all and up must count
# a skip apart from a failure, because they are different facts about the
# fleet. A failure is "this hire went wrong"; a skip is "this box was never
# eligible to be hired", and an operator reading a summary that merges them
# cannot tell a flaky install from a box that needs `rig bootstrap`.
#
# Hiring is the irreversible step — it installs the engine and arms cron — and
# arming a box whose vendor CLI was never installed produces a member that
# wakes every five minutes, fails, and writes the failure into its own duty.log
# where nobody is looking. The fleet then reports seven members and six work.
# Reporting alone does not close that: the table told the operator to hire this
# box, so the refusal is the load-bearing half.
convergence_guard() {
  local name="$1" agent="$2" force="$3" report conv
  report="$(rig_report "$name")"
  conv="$(convergence_of "$report")"
  [ "$conv" = converged ] && return 0
  # --force already meant "install over what is there regardless" — a version
  # match, a MODIFIED engine (#159). One flag, one meaning, and it carries here
  # too: the operator who knows better (a box converged out of band, a marker
  # lost to a hand-edit) needs a way through. It stays LOUD, because a forced
  # hire of an unconverged box is exactly the member that fails silently later.
  if [ "$force" -eq 1 ]; then
    echo "$name: NOT CONVERGED — $(convergence_detail "$report")"
    echo "  hiring anyway (--force): the engine installs and cron arms, but the agent still cannot run"
    return 0
  fi
  echo "$name: REFUSED — $(convergence_detail "$report")"
  echo "  $(convergence_recovery "$name" "$agent")"
  echo "  crew hire $name --force arms it anyway, if you know better"
  return 3
}

# hire_box NAME AGENT ROLE REF FORCE [ALLOW_OFFROSTER] — bake + arm; release
# versions skip when already installed, while development versions re-bake.
#
# Returns 3 when the box was SKIPPED for non-convergence — see convergence_guard.
hire_box() {
  local name="$1" agent="$2" role="$3" ref="$4" force="$5" allow="${6:-0}"
  local want have have_version identity_args registry_arg
  identity_args="$(install_identity_args "$name" "$agent" "$role")"
  registry_arg="$(registry_install_arg)"
  # The engine is resolved ONCE by the calling verb, at parse time, not here
  # per box. Resolving inside this loop meant a malformed --ref was validated
  # LAZILY: `crew hire-all --ref -bad` against an empty roster never reached
  # this line and exited 0, and `crew hire nosuchbox --ref -bad` died on the
  # missing box first. A malformed invocation must be refused before any state
  # is consulted (found by this PR's own regression assertion, round 3). It
  # also stops re-running `git rev-parse` once per box.
  want="$ENGINE_VERSION"
  # Convergence FIRST, before the registry guard and before the already-hired
  # shortcut. It is the most fundamental question of the three — "can this box
  # run an agent at all" comes before "which registry would it work" — and
  # asking it first means an unconverged box is never talked about as though
  # the only thing wrong with it were its registry.
  convergence_guard "$name" "$agent" "$force" || return 3
  # The guard runs BEFORE the already-hired shortcut: a box that is already
  # armed against the wrong registry is precisely the state an operator needs
  # told about, and "skipping" would hide it.
  hire_guard "$name" "$allow"
  have="$(hired_at "$name")"
  have_version="$(stamp_version "$have" 2>/dev/null || true)"
  if [[ "$want" == *-dev* ]]; then
    echo "$name: crew@$want is a development tree — re-baking even when the installed version matches"
  elif [ "$force" -eq 0 ] && [ "$have_version" = "$want" ]; then
      echo "$name: already hired at $have — version $want matches, skipping"
      return 0
  fi
  echo "hiring $name  (role=$role agent=$agent crew@$want)"
  # D5's mark, BEFORE the install that invalidates the checkpoint (#589). Here
  # and not only in cmd_upgrade: this is the route `crew up` takes for every
  # roster box, and an engine that moves by it is no less past the checkpoint
  # for having moved by a hire. A refusal here installs nothing, so the box and
  # its checkpoint stay in agreement.
  checkpoint_stale_gate "$name" "$want" || return 1
  # --force already meant "re-install even when the version matches"; it now
  # also carries through install.sh's refusal to overwrite a MODIFIED engine
  # (#159). One flag, one meaning: install over what is there regardless.
  # An `if`, not `[ … ] && …`: under set -e that form kills the function
  # whenever force is 0, the same shape as the note in cmd_upgrade's loop.
  local force_arg=""
  if [ "$force" -eq 1 ]; then force_arg="--force"; fi
  if ! stage_engine "$name" ||
     ! stage_fleet_definition "$name" ||
     ! install_staged_engine "$name" "$identity_args $registry_arg --arm-cron $force_arg"; then
    cleanup_staged_engine "$name"
    echo "$name: hire FAILED — the engine is NOT installed and cron is NOT armed (output above)"
    # The same residual cmd_upgrade names, said in the same amount here: the
    # gate above marked the checkpoint stale for a move that then did not
    # happen, so a reset refuses this box until it is re-cut. The gate's own
    # STALE note has already printed, but the two routes that install an
    # engine saying different amounts about one state is the drift this
    # checkpoint spent a round removing. Guarded on the record, so a box that
    # never had one is not told about a mark that was never written.
    if [ -f "$(checkpoint_file "$name")" ]; then
      echo "  note: $name's $RESET_LABEL checkpoint was already marked stale for crew@$want and stays marked; a reset REFUSES this box until it is re-cut with: crew reset --cut $name"
    fi
    return 1
  fi
  if bxn "$name" 'gh auth status >/dev/null 2>&1'; then
    echo "$name: hired — on duty at the next 5-minute boundary"
  else
    echo "$name: hired but NOT authenticated — it idles loudly until you log it in: box shell $name → gh auth login"
  fi
}

cmd_new() {
  need_box
  local role="" agent="" name="" from=""
  # Positional first argument = a roster name.
  if [ $# -gt 0 ]; then
    case "$1" in --*) : ;; *) name="$1"; shift ;; esac
  fi
  while [ $# -gt 0 ]; do
    case "$1" in
      --role)  need_value "$@"; role="$2";  shift 2 ;;
      --agent) need_value "$@"; agent="$2"; shift 2 ;;
      --name)  need_value "$@"; name="$2";  shift 2 ;;
      --from)  need_value "$@"; from="$2";  shift 2 ;;
      *) usage_error "unknown argument '$1' (usage: crew new <roster-name> | crew new --role <r> --agent <a> [--name <n>] [--from <box>/<snap>])" ;;
    esac
  done
  if [ -n "$name" ] && [ -z "$role$agent" ]; then
    local line
    line="$(roster_line "$name")"
    [ -n "$line" ] || usage_error "'$name' is not in $ROSTER (or pass --role/--agent for an ad-hoc box)"
    read -r agent role from <<<"$line"
  fi
  if [ -z "$role" ] || [ -z "$agent" ]; then usage_error "usage: crew new <roster-name> | crew new --role <r> --agent <a>"; fi
  validate_profiles "$agent" "$role"
  require_operator_config "crew new"
  if [ -z "$name" ]; then
    name="$agent-$role"
    local i=2
    while box_exists "$name"; do name="$agent-$role-$i"; i=$((i + 1)); done
  fi
  box_exists "$name" && die "'$name' already exists (crew hire $name to put it on duty)"

  create_box "$name" "$agent" "$role" "$from"
  # WHAT THIS SENTENCE MAY CLAIM IS DECIDED BY WHICH PATH JUST RAN (#679 D2,
  # and the fence triage widened onto this line on 2026-09-05). It used to read
  # "vendor CLI converging via the $agent-box template", and that was wrong
  # three ways at once. There is no box template any more — box 0.10.0 retired
  # the four agent spellings outright. <agent>-box is RIG's role, not box's
  # template, which is D2's whole distinction. And box_mint_fresh returns only
  # AFTER `rig bootstrap` has completed (shared/lib/box-mint.sh), so by the time
  # this prints, convergence is finished rather than in flight.
  #
  # The third error is the one a rewording alone still gets wrong: this same
  # response prints on the CLONE path, where there was no template, no rig and
  # no bootstrap at all — the box was copied from a gold snapshot that already
  # carried whatever it carried. So the sentence is BRANCHED rather than
  # corrected, and the clone half makes no claim about rig whatsoever.
  local minted
  if [ -n "$from" ]; then
    minted="copied from $from"
  else
    minted="vendor CLI converged by rig into the $agent-box role"
  fi
  cat <<EOF

$name is created — $minted.
No engine, no cron: it does nothing until hired. Next, once per box, ever:

  box shell $name        # then, inside the box:
                         #   gh auth login
                         #   $(login_hint "$agent")
  crew hire $name        # joins the crew; on duty at the next 5-min boundary

(a NEW GitHub identity per box; for a reviewer decide the panel= changes first)
EOF
  return 0
}

cmd_create_all() {
  max_args create-all 0 "$@"
  need_box
  require_operator_config "crew create-all"
  local name agent role from made=0 existing=0 failed=0 failed_names=""
  while read -r name agent role from; do
    validate_profiles "$agent" "$role"
    if box_exists "$name"; then
      echo "$name: exists"
      existing=$((existing + 1))
    else
      if create_box "$name" "$agent" "$role" "$from"; then
        made=$((made + 1))
      else
        failed=$((failed + 1))
        failed_names="${failed_names}${failed_names:+, }$name"
      fi
    fi
  done < <(read_roster)
  echo
  if [ "$failed" -eq 0 ] && [ "$existing" -eq 0 ]; then
    echo "$made created. Next: log each new box in by hand (box shell <box> → gh auth login; the worst part,"
  else
    echo "create-all: $made created, $existing existing, $failed failed${failed_names:+ ($failed_names)}."
    echo "Next: log each new box in by hand (box shell <box> → gh auth login; the worst part,"
  fi
  echo "halved: GitHub is automated), then 'crew hire-all'."
  if [ "$failed" -ne 0 ]; then return 1; fi
}

cmd_hire() {
  need_box
  local name="${1:-}"; shift || true
  case "$name" in ""|--*) usage_error "usage: $(synopsis_of hire)" ;; esac
  local role="" agent="" ref="HEAD" force=0 allow=0 explicit_profile=0 line=""
  local roster_agent="" roster_role=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --role)  need_value "$@"; role="$2";  explicit_profile=1; shift 2 ;;
      --agent) need_value "$@"; agent="$2"; explicit_profile=1; shift 2 ;;
      --ref)   need_value "$@"; ref="$2";   shift 2 ;;
      --force) force=1;    shift ;;
      # Deliberately NOT --force: that means "re-bake an already-hired box",
      # and overloading it would let a routine re-bake wave the registry check
      # through as a side effect (#51).
      --allow-offroster) allow=1; shift ;;
      *) usage_error "unknown argument '$1'" ;;
    esac
  done
  resolve_engine "$ref"
  require_operator_config "crew hire"
  box_exists "$name" || die "no box named '$name' — crew new $name first"
  line="$(roster_line "$name")"
  if [ -n "$line" ] && [ "$explicit_profile" -eq 1 ]; then
    read -r roster_agent roster_role _ <<<"$line"
    usage_error "$name is declared as agent=$roster_agent role=$roster_role in $ROSTER; remove --agent/--role (the roster in force is authoritative)"
  fi
  if [ -z "$role$agent" ]; then
    [ -n "$line" ] || usage_error "'$name' is not in $ROSTER — pass --role and --agent"
    read -r agent role _ <<<"$line"
  fi
  if [ -z "$role" ] || [ -z "$agent" ]; then usage_error "--role and --agent go together"; fi
  validate_profiles "$agent" "$role"
  foreign_actor_check
  # 3 is hire_box's SKIP status, which only the fleet verbs need to tell apart
  # from a failure: for a single named box the operator asked for one hire and
  # did not get it, so it collapses to crew's ordinary "the world is not ready"
  # 1 — the same code cmd_status uses for a box that does not exist (#97), and
  # the same one `crew hire nosuchbox` already exits with. Leaving 3 to escape
  # would put a third meaning on crew's exit surface for no caller's benefit.
  local rc=0
  hire_box "$name" "$agent" "$role" "$ref" "$force" "$allow" || rc=$?
  case "$rc" in
    0) return 0 ;;
    3) return 1 ;;
    *) return "$rc" ;;
  esac
}

cmd_hire_all() {
  need_box
  # Beyond codex's list, same class and one step worse: an unknown flag was
  # SILENTLY IGNORED here, so `crew hire-all --dry-run` hired the whole fleet
  # while reading like a rehearsal. The table now declares this verb's
  # synopsis, so anything else is malformed and says so.
  local ref="HEAD"
  if [ "$#" -gt 0 ]; then
    case "$1" in
      --ref) need_value "$@"; ref="$2"; shift 2 ;;
      *) usage_error "unknown argument '$1' (usage: $(synopsis_of hire-all))" ;;
    esac
    [ "$#" -eq 0 ] || usage_error "usage: $(synopsis_of hire-all)"
  fi
  resolve_engine "$ref"
  require_operator_config "crew hire-all"
  local name agent role _from hired=0 failed=0 skipped=0 skipped_names="" rc
  foreign_actor_check
  while read -r name agent role _from; do
    validate_profiles "$agent" "$role"
    if ! box_exists "$name"; then
      echo "$name: not created — crew new $name first"
      continue
    fi
    # `|| rc=$?`, not a bare call: crew's top-level `set -e` used to kill
    # hire-all on the first failing box, so one failed engine convergence
    # blocked the ENTIRE fleet (#49). A fleet verb reports what it could not
    # do and carries on; the summary below is what makes the failure loud.
    # Same reason one unconverged box (rc 3) must not stop the run either — it
    # is counted and named, never fatal (#220).
    rc=0
    hire_box "$name" "$agent" "$role" "$ref" 0 || rc=$?
    case "$rc" in
      0) hired=$((hired + 1)) ;;
      3) skipped=$((skipped + 1)); skipped_names="${skipped_names}${skipped_names:+, }$name" ;;
      *) failed=$((failed + 1)) ;;
    esac
  done < <(read_roster)
  echo
  echo "hire-all: $hired hired, $skipped skipped, $failed failed"
  # NAMED, not just counted. A count tells the operator something is wrong; the
  # name is what they act on, and this whole issue exists because a table full
  # of equals never named the one box that could not work.
  #
  # "not confirmed converged" rather than "rig bootstrap failed", because the
  # skip set holds two different facts: a box that answered and has no marker,
  # and a box that answered nothing at all (stopped, unreachable). Both refuse
  # — an unreadable marker is NOT converged — but only the first is a failed
  # bootstrap, and a summary asserting the stronger one would send an operator
  # to `rig bootstrap` for a box that is merely switched off. The per-box line
  # above already carries the accurate reason for each.
  if [ "$skipped" -ne 0 ]; then
    echo "  not confirmed converged (reason printed above for each): $skipped_names"
  fi
  # A skip is not success: `crew hire-all` is run by automation, and an rc of 0
  # with a member missing from the fleet is the same silent partial outage this
  # issue is about, one level up.
  if [ "$failed" -ne 0 ] || [ "$skipped" -ne 0 ]; then return 1; fi
}

cmd_up() {
  need_box
  # Same silently-ignored-flag defect as hire-all above: `crew up --dry-run`
  # is the ONLY accepted form, and anything else used to converge the fleet
  # without a word.
  local dry=0
  if [ "$#" -gt 0 ]; then
    case "$1" in
      --dry-run) dry=1; shift ;;
      *) usage_error "unknown argument '$1' (usage: $(synopsis_of up))" ;;
    esac
    [ "$#" -eq 0 ] || usage_error "usage: $(synopsis_of up)"
  fi
  [ -f "$ROSTER" ] || die "no roster at $ROSTER"
  # --dry-run is a read: it is exactly how an operator inspects a host that has
  # no configuration yet, so it keeps working and carries the banner. The
  # converging form creates boxes and arms cron, so it refuses.
  if [ "$dry" -eq 1 ]; then fallback_banner; else require_operator_config "crew up"; fi

  # The platform check, at the earliest point on this verb that knows the host
  # (#679 D12). `up` is where a fleet is converged, so it is where a floor is
  # worth stating; the installer states the same finding in the same words at
  # the other end. It REPORTS and never refuses (#679 D14) — `crew up` on a
  # below-floor box still converges the fleet, and every call site keeps its own
  # consequence. Silent when everything is at or above its floor, so this is
  # invisible on a healthy host.
  #
  # Before require_operator_config would put it ahead of a refusal, and after
  # the roster read would put it behind one — a platform floor an operator
  # meets only once their configuration is complete is the surprise D12 is
  # about, one step further in.
  #
  # $ROSTER is handed down rather than re-resolved: the rig half reads the
  # guests, and the guests it may read are the ones crew was asked about, which
  # is the same scope `cmd_up` itself keeps and the same one `crew upgrade
  # --all` intersects to. This resolution is the fleet's only one.
  report_platform "$(crew_version 2>/dev/null || echo unknown)" "$ROSTER"

  # `up` takes no --ref, but hire_box now consumes the globals the caller
  # resolves — so it resolves HEAD once here, for the same reason and with the
  # same "once, not per box" property.
  resolve_engine HEAD
  local name agent role from state failed=0 skipped=0 skipped_names="" rc conv
  local new_box=0 would_create=0 would_start=0 would_hire=0
  foreign_actor_check
  while read -r name agent role from; do
    validate_profiles "$agent" "$role"
    new_box=0
    if ! box_exists "$name"; then
      new_box=1
      if [ "$dry" -eq 1 ]; then
        echo "$name: WOULD create ($agent/$role${from:+ from $from})"
        would_create=$((would_create + 1))
      else
        create_box "$name" "$agent" "$role" "$from"
      fi
    else
      state="$(box_state "$name")"
      if [ "$state" = "stopped" ]; then
        # `box start` in a roster loop gets the same /dev/null as bxn: any
        # `box` subcommand that inherits stdin can drain the FIFO this loop is
        # reading from (#48).
        if [ "$dry" -eq 1 ]; then
          echo "$name: WOULD start"
          would_start=$((would_start + 1))
        else
          box start "$name" </dev/null
          echo "$name: started"
        fi
      fi
    fi
    if [ "$dry" -eq 0 ]; then
      # Same reasoning as hire-all: one box must not abort the convergence, and
      # an unconverged box (rc 3) is skipped and named rather than fatal (#220).
      rc=0
      hire_box "$name" "$agent" "$role" HEAD 0 || rc=$?
      case "$rc" in
        0) : ;;
        3) skipped=$((skipped + 1)); skipped_names="${skipped_names}${skipped_names:+, }$name" ;;
        *) failed=$((failed + 1)) ;;
      esac
    else
      # A dry run that says WOULD hire about a box the real run will refuse
      # tells the same lie the NOTE column told, one verb over — and --dry-run
      # is precisely what an operator reads BEFORE the irreversible verb, so it
      # is the last place that lie can still be cheap to correct.
      if [ "$new_box" -eq 1 ]; then
        echo "$name: WOULD hire (new box — engine crew@$ENGINE_VERSION, cron armed)"
        would_hire=$((would_hire + 1))
      else
        conv="$(convergence_of "$(rig_report "$name")")"
      fi
      if [ "$new_box" -eq 0 ] && [ "$conv" = converged ]; then
        echo "$name: WOULD hire (currently: $(hired_at "$name"))" 2>/dev/null || echo "$name: WOULD hire"
        would_hire=$((would_hire + 1))
      elif [ "$new_box" -eq 0 ]; then
        echo "$name: WOULD SKIP — not converged; crew hire $name would refuse"
      fi
    fi
  done < <(read_roster)

  if [ "$dry" -eq 1 ]; then
    echo
    echo "up --dry-run: $would_create would be created, $would_start started, $would_hire hired"
  fi

  if [ "$dry" -eq 0 ] && [ "$skipped" -ne 0 ]; then
    echo
    echo "up: $skipped box(es) SKIPPED — not confirmed converged: $skipped_names"
    echo "    they are NOT on duty; each printed its own reason above"
  fi

  if [ "$dry" -eq 0 ] && [ "$failed" -ne 0 ]; then
    echo
    echo "up: $failed box(es) could NOT be hired — see the errors above"
  fi

  if [ "$dry" -eq 0 ]; then
    echo
    echo "auth:"
    while read -r name _agent _role _from; do
      if bxn "$name" 'gh auth status >/dev/null 2>&1' 2>/dev/null; then
        echo "  $name: logged in"
      else
        echo "  $name: AWAITING LOGIN  (box shell $name → gh auth login)"
      fi
    done < <(read_roster)
    echo
    echo "boxes on this host but not in the roster (left alone):"
    comm -23 <(box_names | sort) <(roster_names | sort) | sed 's/^/  /' || true
  fi
  # Convergence that could not converge must not exit 0: `crew up` is what
  # automation runs, and a success rc is the only thing most callers read. A
  # SKIP counts for that purpose exactly as a failure does — the fleet is short
  # a member either way, and the whole defect being closed here is a short
  # fleet that reads as a full one.
  if [ "$dry" -eq 0 ] && { [ "$failed" -ne 0 ] || [ "$skipped" -ne 0 ]; }; then return 1; fi
}

# drain_probe NAME — print `idle|busy|unreadable AGE_SECONDS`.
#
# The probe answers from the lock itself. `.duty.lock.since` only enriches a
# held result with its continuous age; it never gets to turn an unreadable
# lock into an idle one. Transport errors and a guest without flock therefore
# collapse in the safe direction: busy/unreadable, never permission to kill a
# session (#588 D3).
drain_probe() {
  local record
  # shellcheck disable=SC2016  # HOME/lock variables expand inside the box
  record="$(bxn "$1" '
    lock="$HOME/duty/.duty.lock"
    since="$HOME/duty/.duty.lock.since"
    command -v flock >/dev/null 2>&1 || { printf "unreadable -1\n"; exit 0; }
    rc=0
    flock -n "$lock" true >/dev/null 2>&1 || rc=$?
    if [ "$rc" -eq 0 ]; then printf "idle 0\n"; exit 0; fi
    if [ "$rc" -ne 1 ]; then printf "unreadable -1\n"; exit 0; fi
    age=-1
    if [ -r "$since" ]; then
      started="$(cat "$since" 2>/dev/null || echo)"
      now="$(date +%s 2>/dev/null || echo)"
      case "$started:$now" in
        *[!0-9:]*|:*) : ;;
        *)
          while [ "${started#0}" != "$started" ]; do started="${started#0}"; done
          while [ "${now#0}" != "$now" ]; do now="${now#0}"; done
          started="${started:-0}"; now="${now:-0}"
          # Validate decimal identity and ordering before Bash arithmetic: a
          # wrapped or future timestamp is no evidence of a continuous hold.
          if [ "${#started}" -le 19 ] && [ "${#now}" -le 19 ] \
             && { [ "${#started}" -lt 19 ] || [[ "$started" < 9223372036854775808 ]]; } \
             && { [ "${#now}" -lt 19 ] || [[ "$now" < 9223372036854775808 ]]; } \
             && { [ "${#started}" -lt "${#now}" ] \
                  || { [ "${#started}" -eq "${#now}" ] && [[ "$started" < "$now" || "$started" = "$now" ]]; }; }; then
            age=$((10#$now - 10#$started))
          fi
          ;;
      esac
    fi
    printf "busy %s\n" "$age"
  ' 2>/dev/null | head -1 | tr -d '\r' || true)"
  case "$record" in
    "idle "*|"busy "*|"unreadable "*) printf '%s\n' "$record" ;;
    *) printf 'unreadable -1\n' ;;
  esac
}

box_free_kb() {
  local free
  # shellcheck disable=SC2016  # TMPDIR expands inside the box
  free="$(bxn "$1" 'df -Pk "${TMPDIR:-/tmp}" 2>/dev/null | tail -1 | tr -s " " | cut -d" " -f4' \
    2>/dev/null | tr -d '\r' | tail -1 || true)"
  case "$free" in ''|*[!0-9]*) return 1 ;; *) printf '%s\n' "$free" ;; esac
}

wait_box_free_kb() {
  local name="$1" attempt=1 free
  while [ "$attempt" -le "$RESTART_READY_ATTEMPTS" ]; do
    if free="$(box_free_kb "$name")"; then
      printf '%s\n' "$free"
      return 0
    fi
    [ "$attempt" -eq "$RESTART_READY_ATTEMPTS" ] || sleep "$RESTART_READY_POLL_S"
    attempt=$((attempt + 1))
  done
  return 1
}

clear_stale_duty_snapshots() {
  # shellcheck disable=SC2016  # TMPDIR expands inside the box
  bxn "$1" '
    tmp="${TMPDIR:-/tmp}"
    find "$tmp" -maxdepth 1 -type f -name "duty-snapshot.*" -mmin +5 -delete
  ' >/dev/null 2>&1
}

cycle_box() {
  local name="$1" initial_state="$2" before="" after delta state
  if [ "$initial_state" != stopped ]; then
    before="$(box_free_kb "$name")" || {
      echo "  restart FAILED on $name — could not read free space before stop"
      return 1
    }
    clear_stale_duty_snapshots "$name" || {
      echo "  restart FAILED on $name — could not clear stale duty snapshots"
      return 1
    }
    if ! box down "$name" </dev/null; then
      echo "  restart FAILED on $name — stop command failed"
      return 1
    fi
    state="$(box_state "$name")"
    if [ "$state" != stopped ]; then
      echo "  restart FAILED on $name — stop did not take (state: $state); NOT starting"
      return 1
    fi
  fi
  if ! box start "$name" </dev/null; then
    echo "  restart FAILED on $name — start command failed"
    return 1
  fi
  after="$(wait_box_free_kb "$name")" || {
    echo "  restart FAILED on $name — box started but its guest stayed unreachable after $RESTART_READY_ATTEMPTS probes; inspect with: box shell $name"
    return 1
  }
  if [ "$initial_state" = stopped ]; then
    clear_stale_duty_snapshots "$name" || {
      echo "  restart FAILED on $name — started, but could not clear stale duty snapshots"
      return 1
    }
    after="$(box_free_kb "$name")" || {
      echo "  restart FAILED on $name — started, but could not read free space after cleanup"
      return 1
    }
    printf '  %s: started from stopped; /tmp filesystem free %s KiB (no pre-stop reading)\n' \
      "$name" "$after"
    return 0
  fi
  delta=$((after - before))
  printf '  %s: restarted; /tmp filesystem free %s → %s KiB (delta %+d KiB)\n' \
    "$name" "$before" "$after" "$delta"
}

# --- the host maintenance job (#590) ----------------------------------------
# `crew restart` and `crew reset` are the two verbs a host schedule fires, and
# everything below is what a caller with no terminal and nobody watching needs.
#
# THE EVIDENCE CONTRACT IS tick.sh's, ADOPTED RATHER THAN REINVENTED. That file
# guarantees exactly one line per boundary in one of three shapes so that
# "silence at a boundary means exactly one thing: cron itself is dead". The
# host side gets the same property:
#
#   <ts> restart run start          — the run began
#   <ts> restart run skipped: ...   — another host job holds the lock
#   <ts> restart run end: ...       — the run finished, whatever it did
#
# with the run's own per-box lines in between, raw, exactly as tick.sh puts its
# job's stdout in the same file. The one deliberate difference from tick.sh:
# the third shape is unconditional here rather than only on failure. tick.sh
# can leave success implicit because its job writes `duty run start` itself and
# a reader wants the exception; a weekly `reset --all` that refused every box
# is a fact somebody has to be able to read POSITIVELY, at the boundary, rather
# than infer from the absence of a complaint.
#
# The lock is taken by BOTH verbs and on every invocation, not only under cron.
# "A weekly reset and a daily restart can never overlap" is not a property that
# can be conditional on how the caller was started: the operator who runs
# `crew restart claude-builder` by hand at 05:10 on a Sunday is the collision,
# and a lock that let them through would be decoration.
need_flock() {
  command -v flock >/dev/null ||
    die "the host maintenance lock needs 'flock' (util-linux) on PATH, and it is not there.
  crew restart and crew reset take that lock so a daily restart and a weekly
  reset can never overlap on one fleet. Running either without it is exactly
  the fail-open the lock exists to prevent, so this refuses rather than
  proceeding unlocked."
}

host_job_ts() { date -u '+%Y-%m-%dT%H:%M:%SZ'; }

# Rotation happens ONCE, before the run's first append — tick.sh's placement
# and its reason: rotating while an append is in flight lands that run's
# evidence in the old generation, which reads precisely like "cron is dead".
#
# WHICH MAKES IT THE HOLDER'S, AND ONLY THE HOLDER'S. Called before the lock is
# taken, this defeats its own reason: the caller does not yet know whether it is
# the invocation that will append, and a contender that renames the log splits
# the run already in flight across two generations — `tee -a` holds the INODE
# and keeps writing to `.1`, while host_job_log reopens BY NAME and puts the end
# boundary in the new file. The reader of one generation then sees a start with
# no end, which is the one shape D2 reserves for cron itself being dead. So this
# is called after flock -n succeeds and nowhere else. A contender appends its
# skip line to whatever generation is current — one line, complete in itself,
# belonging to no run — and rotates nothing.
host_job_rotate() {
  if [ -f "$HOST_JOB_LOG" ] &&
     [ "$(wc -c <"$HOST_JOB_LOG" 2>/dev/null || echo 0)" -gt "$HOST_JOB_LOG_MAX" ]; then
    mv "$HOST_JOB_LOG" "$HOST_JOB_LOG.1" 2>/dev/null || true
  fi
}

# Best-effort by construction. Evidence that can break the maintenance it
# records is worse than no evidence — tick.sh's vitals block makes the same
# trade for the same reason.
host_job_log() { # LINE
  printf '%s %s\n' "$(host_job_ts)" "$1" >>"$HOST_JOB_LOG" 2>/dev/null || true
}

# Who holds the lock, or an honest admission that we do not know. Never a
# guess: "held by reset" when the sidecar was unreadable would send an operator
# to look at a job that was not running.
host_job_holder() {
  local raw since verb pid age
  raw="$(cat "$HOST_JOB_LOCK.holder" 2>/dev/null || true)"
  read -r since verb pid <<<"$raw" || true
  case "$since" in
    ''|*[!0-9]*) echo "another crew host maintenance job (its holder record is missing or unreadable)"; return 0 ;;
  esac
  age=$(( $(date +%s) - since ))
  [ "$age" -ge 0 ] || age=0
  printf "'crew %s' (running %s, pid %s)\n" "${verb:-?}" "$(status_duration "$age")" "${pid:-?}"
}

host_job_status_word() { # RC
  case "$1" in
    0)                      echo "every selected box acted on" ;;
    "$EXIT_BOX_FAILED")     echo "a box FAILED or was REFUSED" ;;
    "$EXIT_SKIPPED_BUSY")   echo "some boxes SKIPPED busy" ;;
    "$EXIT_NOTHING_TO_DO")  echo "nothing to do" ;;
    2)                      echo "the invocation was rejected" ;;
    *)                      echo "an unexpected status" ;;
  esac
}

# host_job VERB RUNNER ARGS… — run RUNNER under the host lock, with the run's
# whole output on stdout AND in the log, and the boundary lines around it.
#
# Called AFTER each verb's own argument validation, deliberately: a typo'd flag
# must not take a fleet-wide lock, must not write a `run start` line, and must
# keep exiting 2 with nothing attempted.
host_job() { # VERB RUNNER ARGS...
  local verb="$1" runner="$2"; shift 2
  local rc=0 held lockfd
  need_flock
  mkdir -p "$HOST_STATE_DIR" 2>/dev/null ||
    die "cannot create the host maintenance state directory $HOST_STATE_DIR (the lock and the job log live there)"
  # An fd rather than `flock <file> <command>`: the lock has to be held across
  # the WHOLE run including its summary line, and an fd is released by the
  # process exiting, so no path out of here — die, a trap, a kill — can leak it
  # and wedge the next night's schedule.
  exec {lockfd}>>"$HOST_JOB_LOCK" ||
    die "cannot open the host maintenance lock at $HOST_JOB_LOCK"
  if ! flock -n "$lockfd"; then
    held="$(host_job_holder)"
    echo "$verb: SKIPPED — the host maintenance lock is held by $held; no box was touched"
    host_job_log "$verb run skipped: the host maintenance lock is held by $held"
    exec {lockfd}>&-
    # Nothing was attempted, so this is the nothing-to-do status and not the
    # skipped-busy one: #588's 3 means "a BOX was busy", and a cron mail that
    # could not tell "the fleet was working" from "the other job was working"
    # would send an operator to the wrong place.
    return "$EXIT_NOTHING_TO_DO"
  fi
  printf '%s %s %s\n' "$(date +%s)" "$verb" "$$" >"$HOST_JOB_LOCK.holder" 2>/dev/null || true
  # The holder's first act, and the only invocation entitled to it: from here
  # the whole record of this run — start, per-box output, end — is in one
  # generation, because nothing else can be appending under the lock.
  host_job_rotate
  host_job_log "$verb run start"
  # A PIPELINE, NOT `exec > >(tee …)`. Process substitution is asynchronous and
  # the shell can exit before tee has flushed, which loses the tail of the
  # output — the summary line, on exactly the run somebody opened the log for.
  # A pipeline's tee has exited before this returns, so the log is complete.
  #
  # `set +e` around it because the runner returning 1 or 3 is a REPORTED
  # outcome, not an error to abort on, and PIPESTATUS must be read before any
  # other command clobbers it (`|| true` here would).
  set +e
  "$runner" "$@" 2>&1 | tee -a "$HOST_JOB_LOG"
  rc=${PIPESTATUS[0]}
  set -e
  host_job_log "$verb run end: $(host_job_status_word "$rc") (exit $rc)"
  : >"$HOST_JOB_LOCK.holder" 2>/dev/null || true
  exec {lockfd}>&-
  return "$rc"
}

cmd_restart() {
  local all=0 force_hours="$RESTART_FORCE_AFTER_HOURS" force_seconds
  local -a named=() restart_targets=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --all) all=1; shift ;;
      --force-after) need_value "$@"; force_hours="$2"; shift 2 ;;
      --*) usage_error "unknown argument '$1' (usage: $(synopsis_of restart))" ;;
      *) named+=("$1"); shift ;;
    esac
  done
  case "$force_hours" in ''|*[!0-9]*) usage_error "--force-after requires a positive whole number of hours" ;; esac
  while [ "${force_hours#0}" != "$force_hours" ]; do force_hours="${force_hours#0}"; done
  [ -n "$force_hours" ] || usage_error "--force-after requires a positive whole number of hours"
  # Bash arithmetic is signed 64-bit on crew's supported hosts. Bound the
  # decimal string before conversion so neither base parsing nor multiplication
  # can wrap a safety threshold into permission to stop a live session.
  # shellcheck disable=SC2071  # equal-width decimal strings compare lexically
  if [ "${#force_hours}" -gt 16 ] \
     || { [ "${#force_hours}" -eq 16 ] && [[ "$force_hours" > 2562047788015215 ]]; }; then
    usage_error "--force-after is too large (maximum: 2562047788015215 hours)"
  fi
  force_seconds=$((10#$force_hours * 3600))
  if [ "$all" -eq 1 ] && [ "${#named[@]}" -ne 0 ]; then usage_error "usage: $(synopsis_of restart)"; fi
  if [ "$all" -eq 0 ] && [ "${#named[@]}" -eq 0 ]; then usage_error "usage: $(synopsis_of restart)"; fi
  need_box
  [ -f "$ROSTER" ] || die "no roster at $ROSTER"
  require_operator_config "crew restart"
  if [ "$all" -eq 1 ]; then mapfile -t restart_targets < <(roster_names); else restart_targets=("${named[@]}"); fi
  # The `+"${…[@]}"` guard, not a bare expansion: an --all over a roster whose
  # rows are all comments yields an EMPTY array, and that run must still reach
  # the log rather than dying on `set -u` before it can say it had nothing to
  # do. That is the case D2 names.
  host_job restart restart_run "$force_seconds" "$force_hours" \
    ${restart_targets[@]+"${restart_targets[@]}"}
}

restart_run() { # FORCE_SECONDS FORCE_HOURS TARGET...
  local force_seconds="$1" force_hours="$2"; shift 2
  local -a restart_targets=("$@")
  local name state age initial_state refreshed_state
  local restarted=0 skipped=0 failed=0 skipped_names="" failed_names=""
  if [ "${#restart_targets[@]}" -eq 0 ]; then
    echo "restart: no box selected — nothing to do"
    return "$EXIT_NOTHING_TO_DO"
  fi
  if [ -t 0 ]; then
    printf 'restart plan (%sh force-after):' "$force_hours"
    printf ' %s' "${restart_targets[@]}"
    printf '\n'
  fi
  for name in "${restart_targets[@]}"; do
    if ! box_exists "$name"; then
      echo "  $name: not present — restart FAILED"
      failed=$((failed + 1)); failed_names="${failed_names}${failed_names:+, }$name"
      continue
    fi
    initial_state="$(box_state "$name")"
    if [ "$initial_state" = stopped ]; then
      echo "  $name: already stopped; starting"
    else
      read -r state age <<<"$(drain_probe "$name")"
      if [ "$state" = unreadable ]; then
        refreshed_state="$(box_state "$name")"
        if [ "$refreshed_state" = stopped ]; then
          initial_state=stopped
          echo "  $name: stopped before the drain completed; starting"
        fi
      fi
    fi
    if [ "$initial_state" != stopped ] && [ "$state" != idle ]; then
      if [ "$state" = busy ] && [[ "$age" =~ ^[0-9]+$ ]] \
         && [ "$age" -ge "$force_seconds" ]; then
        echo "  $name: duty lock held for $(status_duration "$age") — force-after reached; restarting"
      else
        if [[ "$age" =~ ^[0-9]+$ ]]; then
          echo "  $name: SKIPPED busy — duty lock held for $(status_duration "$age")"
        elif [ "$state" = busy ]; then
          echo "  $name: SKIPPED busy — duty lock age unavailable"
        else
          echo "  $name: SKIPPED busy — duty lock state unreadable"
        fi
        skipped=$((skipped + 1)); skipped_names="${skipped_names}${skipped_names:+, }$name"
        continue
      fi
    fi
    if cycle_box "$name" "$initial_state"; then restarted=$((restarted + 1))
    else failed=$((failed + 1)); failed_names="${failed_names}${failed_names:+, }$name"; fi
  done
  echo
  echo "restart: $restarted restarted, $skipped skipped-busy, $failed failed"
  [ -z "$skipped_names" ] || echo "  skipped: $skipped_names"
  [ -z "$failed_names" ] || echo "  failed: $failed_names"
  if [ "$failed" -ne 0 ]; then return "$EXIT_BOX_FAILED"; fi
  if [ "$skipped" -ne 0 ]; then return "$EXIT_SKIPPED_BUSY"; fi
}

box_supports_force_down() {
  local help
  help="$(box down --help 2>&1 || true)"
  grep -q -- '--force' <<<"$help"
}

cmd_down() {
  local force=0 name _rest state age failed=0 stopped=0 absent=0 waited=0 already_stopped stop_failed
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --force) force=1; shift ;;
      *) usage_error "unknown argument '$1' (usage: $(synopsis_of down))" ;;
    esac
  done
  need_box
  [ -f "$ROSTER" ] || die "no roster at $ROSTER"
  require_operator_config "crew down"
  if [ "$force" -eq 1 ] && ! box_supports_force_down; then
    # The NUMBER comes from the declaration (#679 D11); the DECISION does not
    # (#679 D14). This still refuses, and it still refuses on the CAPABILITY —
    # box_supports_force_down probes box's own help, because a version string
    # is a proxy a fork or a local build gets wrong. What moved into
    # platform.sh is the figure this sentence quotes, and nothing else.
    die "crew down --force requires box $CREW_PLATFORM_BOX_MIN or later (this host's box has no down --force)"
  fi
  while read -r name _rest; do
    stop_failed=0
    if ! box_exists "$name"; then
      echo "  $name: not present, skipping"
      absent=$((absent + 1))
      continue
    fi
    state="$(box_state "$name")"
    if [ "$state" = stopped ]; then
      echo "  $name: already stopped"
      stopped=$((stopped + 1))
      state=""
      continue
    fi
    if [ "$force" -eq 0 ]; then
      local announced=0
      already_stopped=0
      while :; do
        read -r state age <<<"$(drain_probe "$name")"
        [ "$state" = idle ] && break
        if [ "$state" = unreadable ] && [ "$(box_state "$name")" = stopped ]; then
          echo "  $name: stopped while waiting"
          stopped=$((stopped + 1))
          already_stopped=1
          break
        fi
        announced=1
        if [[ "$age" =~ ^[0-9]+$ ]]; then
          echo "  $name: waiting for duty lock held $(status_duration "$age"); use crew down --force to stop without draining"
        else
          echo "  $name: waiting because duty lock state is unreadable; use crew down --force to stop without draining"
        fi
        sleep "$RESTART_DRAIN_POLL_S"
      done
      waited=$((waited + announced))
      [ "$already_stopped" -eq 0 ] || { state=""; continue; }
    fi
    if [ "$force" -eq 1 ]; then
      # This roster loop reads through a FIFO; a stdin-inheriting box command
      # would drain later roster rows (#48).
      box down "$name" --force </dev/null || stop_failed=1
    else
      # This roster loop reads through a FIFO; a stdin-inheriting box command
      # would drain later roster rows (#48).
      box down "$name" </dev/null || stop_failed=1
    fi
    if [ "$stop_failed" -eq 0 ]; then state="$(box_state "$name")"; else state=""; fi
    if [ "$state" = stopped ]; then
      echo "  $name: stopped"
      stopped=$((stopped + 1))
    else
      if [ "$stop_failed" -eq 1 ]; then
        echo "  down FAILED on $name (stop command failed)"
      else
        echo "  down FAILED on $name${state:+ (state: $state)}"
      fi
      failed=$((failed + 1))
    fi
    state=""
  done < <(read_roster)
  echo
  echo "down: $stopped stopped, $waited waited, $absent absent, $failed failed"
  if [ "$failed" -ne 0 ]; then return 1; fi
  if [ "$waited" -ne 0 ]; then return 3; fi
}

# --- crew reset: the `armed` checkpoint (#589) -------------------------------
#
# THE CHECKPOINT'S VERSION IS RECORDED HOST-SIDE, NOT INFERRED FROM THE IMAGE.
# `armed` is one fixed label by the ruling, so unlike `crew gold` — which
# spells the version into `gold-crew-<ver>` — this family has nowhere in the
# label to put it, and reading it back out of a snapshot would mean starting
# the box the reset exists to roll back. So `--cut` WRITES what it cut, beside
# the fleet definition the floor already writes per-box files into.
#
# D5 is the sharp edge and this is where it is blunted: the stale mark is set
# BEFORE the engine that invalidates the checkpoint is installed, by every verb
# that installs one, so the refusal fires on a fact somebody recorded rather
# than on a comparison reconstructed weeks later by whatever the box happens to
# answer. The live comparison in restore_box is a backstop for an engine
# installed by no crew verb at all, not the primary — and it cannot be the
# primary, because it is read from inside a box that a fleet-wide reset may
# well find stopped.
checkpoint_dir() { printf '%s\n' "$CONFIG_DIR/checkpoints"; }
checkpoint_file() { printf '%s\n' "$(checkpoint_dir)/$1.conf"; }
# Parsed, never sourced: three strings are not worth executing a file for, and
# this one is written by a verb that runs as the operator (same call the
# box_agent reader makes about instance.conf).
#
# A READ THAT FAILS ANSWERS EMPTY, AND SAYS SO IN ITS CONTRACT — rc is always
# 0. This used to end on a bare `sed … | head -1 | tr …`, which under `set -euo
# pipefail` returns a FAILURE for an unreadable record (sed exits 2 on EACCES;
# mode 000, or a re-pointed CREW_CONFIG_DIR owned by another uid). Whether that
# aborts the command or is inert depends entirely on the CALLER — bash
# suppresses errexit for the whole dynamic extent of a function invoked in a
# condition or an `&&`/`||` list, and all three call sites happen to be exactly
# that. So nothing misbehaves today, and that is not a property anybody can
# maintain: `local x; x="$(checkpoint_field …)"` as a plain statement is one
# refactor away and would abort a fleet verb between two boxes. The failure is
# absorbed here, once, where the question is asked.
#
# Empty is the fail-safe answer and not a shrug: restore_box refuses on it, in
# the same direction as its neighbours — an unreadable listing is not "no
# label", an unreadable lock is not "idle", an unreadable version is not "the
# versions agree". Captured and then printed rather than streamed, so a read
# that fails PART WAY through cannot emit a truncated version string that
# compares as a real one.
#
# AND `head` IS GONE RATHER THAN ABSORBED, which the fixtures caught and the
# first draft of this fix did not. `head -1` closes the pipe on the first
# match, so on a record carrying the key twice — a readable file, nothing
# wrong with it — sed takes SIGPIPE, pipefail promotes 141, and collapsing
# THAT to empty would refuse a box whose checkpoint is perfectly good. sed
# stops itself with `q` instead: one process, no pipe to break, and "the first
# value wins" stays true because it is the only one read.
checkpoint_field() { # KEY BOX — rc 0 always; empty when it cannot be answered
  local f v
  f="$(checkpoint_file "$2")"
  [ -f "$f" ] || return 0
  v="$(sed -n "/^$1=/{s/^$1=//p;q;}" "$f" 2>/dev/null | tr -d '"'\''\r')" || v=
  printf '%s\n' "$v"
}
checkpoint_record() { # BOX VERSION — the cut's own write; clears any stale mark
  local f; f="$(checkpoint_file "$1")"
  mkdir -p "$(checkpoint_dir)" || return 1
  # Written whole to a temporary and moved into place: a reset reading this
  # file half-written would see no version and refuse a box that has a good
  # checkpoint, and `mv` within one directory is atomic.
  #
  # Cleaning up after itself on both arms, and swallowing the shell's own
  # diagnostic, exactly as checkpoint_mark_stale does — the two halves of one
  # store answering a failed write differently is how the next reader learns
  # the wrong lesson. Nothing READS the litter (only `<box>.conf` is ever
  # read), so this is symmetry rather than correctness; the raw `bash: … :
  # Permission denied` printed above crew's own named FAILED line is the half
  # that is worth it on its own.
  {
    printf '# crew reset checkpoint record for %s (#589 D5). Written by crew.\n' "$1"
    printf 'CHECKPOINT_VERSION=%s\n' "$2"
    printf 'CHECKPOINT_CUT_AT=%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    printf 'CHECKPOINT_STALE=\n'
  } 2>/dev/null >"$f.tmp.$$" || { rm -f "$f.tmp.$$" 2>/dev/null; return 1; }
  mv -f "$f.tmp.$$" "$f" || { rm -f "$f.tmp.$$" 2>/dev/null; return 1; }
}
# checkpoint_mark_stale BOX VERSION — "this box's engine moved to VERSION after
# its checkpoint was cut". Called by cmd_upgrade in the same write as the
# upgrade. rc 0 marked (or nothing to mark) · 1 the mark could not be written.
#
# A box with NO record gets none, and that is rc 0: there is no checkpoint to
# invalidate, and inventing a record here would make `reset` refuse with a
# version pair it made up instead of refusing for the true reason, which is
# D4's missing label. The other two arms are REAL failures and say so — a
# record that could not be read or could not be rewritten leaves the box with
# an `armed` checkpoint that outranks the engine and no mark saying so, and
# D5 makes that fact load-bearing. Reporting it as marked is the one thing
# worse than failing to mark it.
checkpoint_mark_stale() { # BOX VERSION
  local f; f="$(checkpoint_file "$1")"
  [ -f "$f" ] || return 0
  local body
  body="$(grep -v '^CHECKPOINT_STALE=' "$f" 2>/dev/null)" || return 1
  { printf '%s\n' "$body"; printf 'CHECKPOINT_STALE=%s\n' "$2"; } 2>/dev/null >"$f.tmp.$$" \
    || { rm -f "$f.tmp.$$" 2>/dev/null; return 1; }
  mv -f "$f.tmp.$$" "$f" || { rm -f "$f.tmp.$$" 2>/dev/null; return 1; }
}

# checkpoint_stale_gate BOX VERSION — mark BOX's `armed` checkpoint stale, and
# say whether the engine change that follows may proceed. rc 0 proceed · 1 do
# NOT install. Called by EVERY verb that installs an engine, BEFORE it stages
# anything.
#
# THE MARK IS A PRECONDITION TO MOVING THE ENGINE, NOT A NOTE AFTERWARDS, and
# both halves of that sentence were defects until this round.
#
# "Every verb": `cmd_upgrade` was the only caller, and it is not the only route
# an engine moves by. `hire_box` installs whenever the installed version does
# not match, unconditionally on a `-dev` tree, and on --force; `cmd_up` calls
# `hire_box` for every roster box. So a routine `crew up` moved the engine past
# the checkpoint and marked nothing, leaving only restore_box's live comparison
# — which is read through `box exec` and therefore answers nothing at all on a
# stopped box, and a fleet with boxes down is precisely what `crew reset --all`
# is for. A same-version `-dev` re-bake marks too: the version string cannot
# detect that move, and the image still holds the older tree.
#
# "Before": marking after the install meant a write that failed left the box
# running a NEW engine and its checkpoint claiming the OLD one is current, with
# nothing durable saying otherwise — the exact silent downgrade D5 exists to
# stop, and a warning printed once into an upgrade log is not a durable
# anything. Marking first inverts the failure: a mark that cannot be written
# refuses the install, so the box and its checkpoint both stay exactly as they
# were and nothing drifts.
#
# The residual failure is chosen rather than emergent. If the mark lands and
# the install then fails, the checkpoint reads stale for a move that did not
# happen: `crew reset` refuses that box until it is re-cut. That is a FALSE
# REFUSAL, and it is the direction to fail in — the other direction is a silent
# engine downgrade with nothing red anywhere. The caller's failure arm says so
# rather than leaving it to be discovered at the next reset.
#
# A box with NO record is rc 0 with nothing written: there is no checkpoint to
# invalidate, and inventing a record here would make `reset` refuse with a
# version pair crew made up instead of refusing for the true reason, which is
# D4's missing label.
checkpoint_stale_gate() { # BOX VERSION
  local f; f="$(checkpoint_file "$1")"
  [ -f "$f" ] || return 0
  local cut_at; cut_at="$(checkpoint_field CHECKPOINT_VERSION "$1")"
  if checkpoint_mark_stale "$1" "$2"; then
    echo "  note: $1's $RESET_LABEL checkpoint is now STALE (cut at crew@${cut_at:-unknown}, engine moving to crew@$2); re-cut with: crew reset --cut $1"
    return 0
  fi
  echo "  REFUSED — $1's $RESET_LABEL checkpoint could NOT be marked stale at $f, and an engine is not installed over a checkpoint that would still claim to match it. Nothing was staged and nothing was installed; make that path writable, or remove the record, and run this again."
  return 1
}

# box_snapshot_labels NAME — the labels `box info` lists, one per line. rc 1
# when the listing cannot be read at all, which is NOT the same answer as "no
# labels" and must never collapse into it: D4 exists because a reset path that
# assumes the snapshot is there fails on exactly the sick boxes it is for.
#
# The TEXT view, not `--json`. `box info <box>` is documented as the way to
# read the labels ("'box info <box>' lists the labels", box:630) and its
# SNAPSHOTS block is one indented label per line; `box info --json` is a raw
# `incus list --format json` passthrough whose snapshot entries carry the
# daemon's own naming, which is a shape crew would be guessing at. box_state
# uses --json because `status` is a documented top-level key there; this is a
# different question with a different documented answer.
box_snapshot_labels() { # NAME
  local info
  info="$(box info "$1" 2>/dev/null)" || return 1
  case "$info" in *SNAPSHOTS*) ;; *) return 1 ;; esac
  # Stops at the blank line that closes the block, so the "Clone one: box new
  # --name <new> --from <box>/<label>" footer beneath it can never be read as
  # a label.
  printf '%s\n' "$info" | awk '
    $1 == "SNAPSHOTS" && $2 == "(none)" { exit }
    $1 == "SNAPSHOTS" && NF == 1 { block = 1; next }
    block && NF == 0 { exit }
    block { print $1 }
  '
}
# has_reset_checkpoint NAME — rc 0 present · 1 absent · 2 the listing could not
# be read. Three-valued for _reaper_entry_state's reason: an unreadable listing
# scoring the same as a missing label would restore, or refuse, on evidence
# nobody gathered.
has_reset_checkpoint() { # NAME
  local labels
  labels="$(box_snapshot_labels "$1")" || return 2
  grep -qx -- "$RESET_LABEL" <<<"$labels"
}

# box_used_pct NAME — the box's ROOT filesystem, percent used, as a bare
# integer. Root and not /tmp: cycle_box reads /tmp because a restart's whole
# subject is the tmpfs it clears, while a checkpoint freezes the root disk,
# and #589's own 91% measurement is a root-filesystem reading.
box_used_pct() { # NAME
  local pct
  pct="$(bxn "$1" 'df -Pk / 2>/dev/null | tail -1 | tr -s " " | cut -d" " -f5' \
    2>/dev/null | tr -d '%\r' | tail -1 || true)"
  case "$pct" in ''|*[!0-9]*) return 1 ;; *) printf '%s\n' "$pct" ;; esac
}
# box_large_paths NAME — what is large on this box, biggest first. This is the
# half of D7's refusal that does the work: a percentage sends the operator to
# go look, while "13G /swapfile-drill, 13G /swapfile" tells them the answer is
# box#178 and not a crew problem at all. Read as root over `/`, one depth, so
# the swapfiles and /var are visible — they are the whole finding on the fleet
# as measured, and every one of them is outside anything the reaper can reach.
box_large_paths() { # NAME
  bxn "$1" 'sudo -n du -shx /* 2>/dev/null | sort -rh | head -4 | tr "\n" ";"' \
    2>/dev/null | tr -d '\r' | tail -1 || true
}

# reset_drain_gate NAME FORCE_SECONDS MODE — #588's contract, consumed rather
# than re-implemented (D6). MODE is `cut` or `restore`. Prints the human reason
# on a skip. rc 0 proceed · 1 skip. The `unreadable` arm counts as busy for the
# reason cmd_restart gives it: a lock state nothing could read is not evidence
# the box is free.
#
# --force-after FORCES THE RESTORE PATH AND NOT THE CUT, and that is a decision
# rather than an accident. D6 says the flag is the same flag; D7 step 1 says
# the cut's on-demand sweep takes this same duty lock with `flock -n`. Both
# cannot hold, so one of them has to give, and forcing is the wrong one to
# keep for two reasons: a sweep run under a live session is #457 D1's named
# hazard (a reaper deleting files beneath a session), and a cut that skipped
# reclaiming would freeze an unreclaimed box as the floor the fleet returns to
# forever, which is the entire subject of D7. Announcing "proceeding" and then
# failing at the reaper — which is what the emergent behaviour did — is worse
# than either. So a held lock skips the cut whatever its age, at exit 3, which
# is what `crew help reset` says the contract is. The flag keeps #588's
# validation, spellings and default to the letter on both paths.
reset_drain_gate() { # NAME FORCE_SECONDS MODE
  local name="$1" force_seconds="$2" mode="$3" state age
  read -r state age <<<"$(drain_probe "$name")"
  [ "$state" != idle ] || return 0
  if [ "$state" = busy ] && [[ "$age" =~ ^[0-9]+$ ]] && [ "$age" -ge "$force_seconds" ]; then
    if [ "$mode" = cut ]; then
      echo "  $name: SKIPPED busy — duty lock held for $(status_duration "$age"); --force-after does not apply to --cut (the on-demand reaper D7 requires takes this same lock, and a checkpoint of a box that could not be reclaimed becomes the floor every later reset returns to)"
      return 1
    fi
    echo "  $name: duty lock held for $(status_duration "$age") — force-after reached; proceeding"
    return 0
  fi
  if [[ "$age" =~ ^[0-9]+$ ]]; then
    echo "  $name: SKIPPED busy — duty lock held for $(status_duration "$age")"
  elif [ "$state" = busy ]; then
    echo "  $name: SKIPPED busy — duty lock age unavailable"
  else
    echo "  $name: SKIPPED busy — duty lock state unreadable"
  fi
  return 1
}

# cut_box NAME — D1, D7 and D5's write, for one box. rc 0 cut · 1 refused.
cut_box() { # NAME
  local name="$1" pct large stamp ver agent profile rc replaced=0
  # D1's preconditions. A checkpoint of a box that is not logged in, or not
  # hired, is worse than none: the restore that uses it comes back looking
  # like it worked and the box cannot do a minute's work.
  if ! bxn "$name" 'gh auth status >/dev/null 2>&1' 2>/dev/null; then
    echo "  $name: REFUSED — not logged in to GitHub (an $RESET_LABEL checkpoint of a box without credentials restores to a box that cannot work); log it in with: box shell $name"
    return 1
  fi
  stamp="$(hired_at "$name")"
  if [ -z "$stamp" ]; then
    echo "  $name: REFUSED — not hired (no engine to checkpoint); hire it with: crew hire $name"
    return 1
  fi
  # LOGGED IN IS BOTH HALVES, and the lifecycle prose in `crew help` says so:
  # the human login step is `gh auth login` AND the agent profile's own login.
  # A box with live GitHub credentials and a logged-out vendor CLI is the
  # half-built box D1 refuses — every session it starts dies at the model, and
  # the checkpoint would freeze that state as the one the fleet returns to.
  #
  # AFTER the hired check, deliberately: the agent is read from the
  # `instance.conf` the install writes, so an unhired box has no answer here
  # and must be told it is unhired rather than told its agent is unreadable.
  # From instance.conf and not the roster line, so a named off-roster box is
  # covered too, and so the probe is run against the agent the box was ACTUALLY
  # installed as rather than the one the roster believes it should be.
  agent="$(box_agent "$name")"
  if [ -z "$agent" ]; then
    echo "  $name: REFUSED — hired, but it does not say which agent it was installed as (no BOT_AGENT in its instance.conf), so its vendor login cannot be proved; re-hire it with: crew hire $name"
    return 1
  fi
  profile="$(agent_conf "$agent")"
  if [ ! -f "$profile" ]; then
    echo "  $name: REFUSED — installed as agent '$agent', which resolves to no profile at $profile, so its vendor login cannot be proved; 'crew profiles' lists the ones this fleet has"
    return 1
  fi
  if ! vendor_probe "$name" "$agent"; then
    echo "  $name: REFUSED — its $agent CLI is not logged in (an $RESET_LABEL checkpoint of a box that cannot reach its model restores to a box that cannot work); log it in with: box shell $name"
    return 1
  fi
  # AN UNPARSEABLE STAMP IS NOT A VERSION TO RECORD. This coerced to the
  # literal `unknown` and wrote it, which put a nonempty non-version into
  # CHECKPOINT_VERSION by the cut's own hand — and restore_box's emptiness
  # check sailed straight past it, reconstructing `restored to armed
  # (crew@unknown)` from a record that looked present. Legacy SHA-only stamps
  # are a real and supported state, so this is reachable and not theoretical.
  if ! ver="$(stamp_version "$stamp" 2>/dev/null)"; then
    echo "  $name: REFUSED — its engine stamp '$stamp' is not a version that can be recorded (a legacy SHA-only stamp, or malformed), and a checkpoint whose version cannot be compared cannot be safely restored; re-hire it with: crew hire $name"
    return 1
  fi
  # D7, in its ruled order: reclaim, THEN measure, THEN decide. Measuring
  # first would refuse boxes the reaper was about to fix, which is the one
  # thing step 2 names. The sweep's own output is forwarded — it is the
  # operator's evidence for the figure the next line prints.
  echo "  $name: reclaiming before measuring (reaper, on demand)"
  rc=0
  # shellcheck disable=SC2016  # $HOME must expand INSIDE the box, not here
  bxn "$name" '"$HOME"/duty/bin/reap-now.sh' 2>/dev/null || rc=$?
  if [ "$rc" -ne 0 ]; then
    # reap-now.sh documents three, and asserting the first for all of them was
    # wrong in the one case that is not an edge: 127 is every box still on a
    # pre-#589 engine, which is the WHOLE FLEET on the first `--cut` anybody
    # runs. Telling that operator a duty tick holds a lock sends them to look
    # at the wrong thing entirely.
    case "$rc" in
      199) echo "  $name: REFUSED — the on-demand reaper did not complete (a duty tick took the duty lock between the drain probe and now); nothing cut" ;;
      127) echo "  $name: REFUSED — the on-demand reaper did not complete (this box has no reap-now.sh — its engine predates it); upgrade it first with: crew upgrade $name" ;;
      *)   echo "  $name: REFUSED — the on-demand reaper did not complete (it exited $rc); nothing cut" ;;
    esac
    return 1
  fi
  if ! pct="$(box_used_pct "$name")"; then
    echo "  $name: REFUSED — could not read the root filesystem; a checkpoint is not cut on an unmeasured box"
    return 1
  fi
  if [ "$pct" -gt "$RESET_MAX_USED_PCT" ]; then
    large="$(box_large_paths "$name")"
    # THE COMPOSITION, NOT ONLY THE PERCENTAGE (D7 step 3). Whatever is inside
    # the image becomes the floor the fleet returns to forever, so the operator
    # is told what to clear rather than told to go look.
    echo "  $name: REFUSED — root filesystem ${pct}% used after reclaiming, over the ${RESET_MAX_USED_PCT}% ceiling"
    if [ -n "$large" ]; then
      echo "      largest: ${large%;}"
    else
      echo "      largest: unavailable (no passwordless sudo in the box to read / as root)"
    fi
    echo "      whatever is in an $RESET_LABEL image is the floor every later reset returns to; clear it before cutting"
    return 1
  fi
  # A re-cut REPLACES: D5 names `--cut` as the repair after every upgrade, so
  # it has to work unattended, and `incus snapshot create` refuses a label that
  # already exists. box has no delete-a-snapshot row, and its own doctrine
  # sends anything that is not a box invariant to `box incus` — the `{}`
  # placeholder puts the resolved instance where this call needs it rather
  # than appended at the end.
  # Three-valued here for the same reason the restore path is: an unreadable
  # listing is not "there is no label to replace". Read as the latter, the cut
  # below would fail on an `armed` that is still perfectly good and report it
  # as a box left with no checkpoint at all — a false alarm about the one
  # state D4 refuses on.
  case "$(has_reset_checkpoint "$name"; echo $?)" in
    2)
      echo "  $name: REFUSED — could not read its snapshot labels, so a re-cut cannot tell whether $RESET_LABEL is there to replace; nothing cut and nothing removed"
      return 1 ;;
    0)
      if ! box incus "$name" -- snapshot delete "{}" "$RESET_LABEL" </dev/null >/dev/null 2>&1; then
        echo "  $name: REFUSED — could not replace the existing $RESET_LABEL checkpoint; it is unchanged"
        return 1
      fi
      replaced=1 ;;
  esac
  if ! box snapshot "$name" "$RESET_LABEL" </dev/null >/dev/null; then
    # Said loudly, and said ACCURATELY. When the delete above landed, this box
    # is left with no checkpoint at all — exactly the state D4 refuses on weeks
    # later with nobody knowing why — and when it did not, the old one is still
    # there. Reporting the first case in the second one would send an operator
    # to repair a box that does not need it, and the reverse is worse.
    if [ "$replaced" -eq 1 ]; then
      echo "  $name: FAILED — the $RESET_LABEL snapshot was not taken and the previous one was already removed; this box now has NO checkpoint. Repair with: crew reset --cut $name"
    else
      echo "  $name: FAILED — the $RESET_LABEL snapshot was not taken; the box's checkpoint state is unchanged"
    fi
    return 1
  fi
  if ! checkpoint_record "$name" "$ver"; then
    echo "  $name: FAILED — $RESET_LABEL was cut but its version could not be recorded at $(checkpoint_file "$name"); re-cut once the path is writable"
    return 1
  fi
  echo "  $name: $RESET_LABEL cut at crew@$ver; root filesystem ${pct}% used"
}

# restore_box NAME — D4, D5 and D3, for one box. rc 0 restored · 1 refused.
#
# Stop, confirm stopped, restore, start — cycle_box's discipline, for its
# reason: a stop that does not take must never be followed by anything, and
# here "anything" includes rolling a running box's disk out from under it.
restore_box() { # NAME
  local name="$1" recorded stale live state
  case "$(has_reset_checkpoint "$name"; echo $?)" in
    2)
      echo "  $name: REFUSED — could not read its snapshot labels; a reset is not performed on an unverified box"
      return 1 ;;
    1)
      # Never a fallback to `bootstrapped` or `pristine` (D-out): both return a
      # creds-free, unhired box, which is a bootstrap and not a maintenance.
      echo "  $name: REFUSED — no $RESET_LABEL checkpoint (crew reset --cut $name takes one); it is NOT rolled back to any other label"
      return 1 ;;
  esac
  recorded="$(checkpoint_field CHECKPOINT_VERSION "$name")"
  stale="$(checkpoint_field CHECKPOINT_STALE "$name")"
  # AN UNKNOWN VERSION IS NOT "NO MISMATCH". The label is guest-side and the
  # record is host-side, so they drift by more routes than one: `--cut`'s own
  # `checkpoint_record` failing after `box snapshot` landed (which leaves the
  # snapshot on the box and says so), a re-pointed CREW_CONFIG_DIR, a host
  # config restored from a backup predating the cut. In every one of them the
  # checkpoint's version cannot be proved current, and D5's hazard is an
  # unattended weekly caller downgrading an engine with nothing red anywhere.
  # So this refuses, in the same direction as the two reads either side of it:
  # an unreadable listing is not "no label", an unreadable lock is not "idle",
  # and an unreadable version is not "the versions agree". One arm covers
  # missing, unreadable and malformed alike — checkpoint_field answers empty
  # for all three, and none of them is evidence of anything.
  if [ -z "$recorded" ]; then
    echo "  $name: REFUSED — its $RESET_LABEL checkpoint records no engine version at $(checkpoint_file "$name") (missing, unreadable or malformed), so restoring it could silently downgrade the engine. Repair with: crew reset --cut $name"
    return 1
  fi
  # NONEMPTY IS NOT THE SAME QUESTION AS COMPARABLE. `unknown` is the case that
  # matters, because a `--cut` used to write it itself out of an unparseable
  # stamp — but any non-version string lands here, and none of them can be
  # compared with what the box runs. On a stopped box the live side is empty by
  # construction, so this arm is the only one left to notice.
  if ! is_engine_version "$recorded"; then
    echo "  $name: REFUSED — its $RESET_LABEL checkpoint records '$recorded' at $(checkpoint_file "$name"), which is not an engine version and cannot be compared with the box's, so restoring it could silently downgrade the engine. Repair with: crew reset --cut $name"
    return 1
  fi
  if [ -n "$stale" ]; then
    echo "  $name: REFUSED — its $RESET_LABEL checkpoint was cut at crew@$recorded and the box was upgraded to crew@$stale since; restoring it would silently downgrade the engine. Repair with: crew reset --cut $name"
    return 1
  fi
  # A BACKSTOP, AND ONLY A BACKSTOP — the comment here used to claim more than
  # it could deliver, which is how the defect stayed hidden. It is read through
  # `box exec`, so it answers NOTHING on a stopped box, and the restore path
  # accepts stopped boxes; a fleet with boxes down is exactly what `--all` is
  # for. So a live read must never be what D5 rests on, and since this round it
  # is not: every verb that installs an engine marks the checkpoint stale
  # first, host-side, where a stopped box cannot switch the answer off. What is
  # left for this arm is an engine installed by no crew verb at all — a hand
  # `install.sh`, a restored host config predating the move — and for that it
  # is worth keeping. A live version that cannot be read is still not evidence
  # of a mismatch. The recorded side is guaranteed a version above.
  live="$(stamp_version "$(hired_at "$name")" 2>/dev/null || echo)"
  if [ -n "$live" ] && [ "$recorded" != "$live" ]; then
    echo "  $name: REFUSED — its $RESET_LABEL checkpoint was cut at crew@$recorded and the box now runs crew@$live; restoring it would silently downgrade the engine. Repair with: crew reset --cut $name"
    return 1
  fi
  state="$(box_state "$name")"
  if [ "$state" != stopped ]; then
    if ! box down "$name" </dev/null; then
      echo "  $name: FAILED — stop command failed; nothing restored"
      return 1
    fi
    state="$(box_state "$name")"
    if [ "$state" != stopped ]; then
      echo "  $name: FAILED — stop did not take (state: $state); NOT restoring"
      return 1
    fi
  fi
  # --force because there is no terminal here to confirm on: `box restore` is
  # a confirm row and refuses outright without one.
  if ! box restore "$name" "$RESET_LABEL" --force </dev/null; then
    echo "  $name: FAILED — restore failed; the box is stopped and NOT started"
    return 1
  fi
  if ! box start "$name" </dev/null; then
    echo "  $name: FAILED — restored to $RESET_LABEL but the start failed; start it with: box start $name"
    return 1
  fi
  if ! wait_box_free_kb "$name" >/dev/null; then
    echo "  $name: FAILED — restored and started, but its guest stayed unreachable after $RESTART_READY_ATTEMPTS probes; inspect with: box shell $name"
    return 1
  fi
  echo "  $name: restored to $RESET_LABEL (crew@$recorded) and started"
}

cmd_reset() {
  local all=0 cut=0 force_hours="$RESTART_FORCE_AFTER_HOURS" force_seconds
  local -a named=() reset_targets=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --all) all=1; shift ;;
      --cut) cut=1; shift ;;
      --force-after) need_value "$@"; force_hours="$2"; shift 2 ;;
      --*) usage_error "unknown argument '$1' (usage: $(synopsis_of reset))" ;;
      *) named+=("$1"); shift ;;
    esac
  done
  # #588's own validation, to the letter: the flag means the same thing here,
  # so it must refuse the same spellings. A threshold that wrapped through
  # Bash arithmetic would become permission to roll back a live session's box.
  case "$force_hours" in ''|*[!0-9]*) usage_error "--force-after requires a positive whole number of hours" ;; esac
  while [ "${force_hours#0}" != "$force_hours" ]; do force_hours="${force_hours#0}"; done
  [ -n "$force_hours" ] || usage_error "--force-after requires a positive whole number of hours"
  # shellcheck disable=SC2071  # equal-width decimal strings compare lexically
  if [ "${#force_hours}" -gt 16 ] \
     || { [ "${#force_hours}" -eq 16 ] && [[ "$force_hours" > 2562047788015215 ]]; }; then
    usage_error "--force-after is too large (maximum: 2562047788015215 hours)"
  fi
  force_seconds=$((10#$force_hours * 3600))
  # The threshold is an env override, so it is validated like one and not
  # trusted. `CREW_RESET_CUT_MAX_USED_PCT=80%` would otherwise reach `[ -gt ]`
  # as a non-integer, and under `set -e` that ends the whole command in the
  # middle of a fleet-wide cut — some boxes checkpointed, some not, and no
  # summary. The reaper's own _reaper_whole exists for this exact failure.
  #
  # ON THE CUT PATH ONLY, because that is the only path that reads it. Before
  # the loop still, so a `--cut` fails fast without touching a box — but an
  # operator with a malformed value exported in their shell was having every
  # `crew reset` die on a variable the restore never consults, and the
  # variable's own name says which path it belongs to.
  if [ "$cut" -eq 1 ]; then
    case "$RESET_MAX_USED_PCT" in
      ''|*[!0-9]*) die "CREW_RESET_CUT_MAX_USED_PCT must be a whole percentage, not '$RESET_MAX_USED_PCT'" ;;
    esac
    [ "$RESET_MAX_USED_PCT" -le 100 ] \
      || die "CREW_RESET_CUT_MAX_USED_PCT must be 100 or less, not '$RESET_MAX_USED_PCT'"
  fi
  if [ "$all" -eq 1 ] && [ "${#named[@]}" -ne 0 ]; then usage_error "usage: $(synopsis_of reset)"; fi
  if [ "$all" -eq 0 ] && [ "${#named[@]}" -eq 0 ]; then usage_error "usage: $(synopsis_of reset)"; fi
  need_box
  [ -f "$ROSTER" ] || die "no roster at $ROSTER"
  require_operator_config "crew reset"
  # --all is the ROSTER, not every box on the host — `crew upgrade --all`'s
  # rule, for its stated reason (#37): a disarmed box carrying a real identity
  # must not be rolled back by routine maintenance.
  if [ "$all" -eq 1 ]; then mapfile -t reset_targets < <(roster_names); else reset_targets=("${named[@]}"); fi
  host_job reset reset_run "$cut" "$force_seconds" "$force_hours" \
    ${reset_targets[@]+"${reset_targets[@]}"}
}

reset_run() { # CUT FORCE_SECONDS FORCE_HOURS TARGET...
  local cut="$1" force_seconds="$2" force_hours="$3"; shift 3
  local -a reset_targets=("$@")
  local name
  local done_n=0 skipped=0 failed=0 skipped_names="" failed_names=""
  # THE REFUSAL/FAILURE SPLIT IS #589's AND IS NOT REOPENED HERE. A box the
  # version interlock refuses counts into `failed` and is listed under
  # `failed:`, which that issue's fixtures pin deliberately. D4 asks that a
  # refused weekly reset "read as one in the log, not as a failure to be tuned
  # away", and it does: the per-box line says REFUSED and names `crew reset
  # --cut <box>` as the repair, verbatim, in the job log — and the boundary
  # line this run ends on says "a box FAILED or was REFUSED" rather than
  # asserting a failure the log may not contain. Recounting the summary would
  # move a contract this issue inherits rather than owns.
  if [ "${#reset_targets[@]}" -eq 0 ]; then
    echo "reset: no box selected — nothing to do"
    return "$EXIT_NOTHING_TO_DO"
  fi
  if [ -t 0 ]; then
    printf 'reset plan (%s, %sh force-after):' "$([ "$cut" -eq 1 ] && echo "cut $RESET_LABEL" || echo "restore to $RESET_LABEL")" "$force_hours"
    printf ' %s' "${reset_targets[@]}"
    printf '\n'
  fi
  for name in "${reset_targets[@]}"; do
    if ! box_exists "$name"; then
      echo "  $name: not present — reset FAILED"
      failed=$((failed + 1)); failed_names="${failed_names}${failed_names:+, }$name"
      continue
    fi
    # A STOPPED BOX REFUSES THE CUT AND NOT THE RESTORE, because only the cut
    # needs to look inside: it reads the vendor login, the engine stamp and
    # the root filesystem through the box, and runs the reaper in it. The
    # restore reads none of them — the recorded version and the stale mark are
    # host-side files and the live comparison is a guarded backstop — and
    # `restore_box`'s first act is to stop the box anyway. Refusing there was
    # gratuitous and inconsistent with the sibling verb, which answers this
    # same state by starting the box (`cmd_restart`: "already stopped").
    if [ "$(box_state "$name")" = stopped ]; then
      if [ "$cut" -eq 1 ]; then
        echo "  $name: REFUSED — stopped; a cut reads its login, its engine and its disk from inside it. Start it first with: box start $name"
        failed=$((failed + 1)); failed_names="${failed_names}${failed_names:+, }$name"
        continue
      fi
      # No drain gate: a stopped box runs no duty tick, so there is no lock to
      # respect and probing it could only answer `unreadable` — which the gate
      # correctly reads as busy, and which would skip a box that is plainly free.
      echo "  $name: already stopped; restoring"
    # D6, both paths: a reset destroys in-flight work exactly as a restart
    # does, and the cut takes the duty lock through the reaper besides.
    elif ! reset_drain_gate "$name" "$force_seconds" "$([ "$cut" -eq 1 ] && echo cut || echo restore)"; then
      skipped=$((skipped + 1)); skipped_names="${skipped_names}${skipped_names:+, }$name"
      continue
    fi
    if [ "$cut" -eq 1 ]; then
      if cut_box "$name"; then done_n=$((done_n + 1))
      else failed=$((failed + 1)); failed_names="${failed_names}${failed_names:+, }$name"; fi
    else
      if restore_box "$name"; then done_n=$((done_n + 1))
      else failed=$((failed + 1)); failed_names="${failed_names}${failed_names:+, }$name"; fi
    fi
  done
  echo
  if [ "$cut" -eq 1 ]; then
    echo "reset --cut: $done_n cut, $skipped skipped-busy, $failed failed"
  else
    echo "reset: $done_n restored, $skipped skipped-busy, $failed failed"
  fi
  [ -z "$skipped_names" ] || echo "  skipped: $skipped_names"
  [ -z "$failed_names" ] || echo "  failed: $failed_names"
  if [ "$failed" -ne 0 ]; then return "$EXIT_BOX_FAILED"; fi
  if [ "$skipped" -ne 0 ]; then return "$EXIT_SKIPPED_BUSY"; fi
}

# crew status — no argument: the whole crew as a table, one roster member
# per row, with auth problems FLAGGED (an unauthenticated member fails
# loudly in its own duty.log every tick; this is the host-side view of the
# same fact). With a box name: the detailed view.
cmd_status() {
  max_args status 1 "$@"
  need_box
  fallback_banner
  if [ -n "${1:-}" ]; then
    local b="$1" engine
    # A box that does not exist is a FAILURE, not an empty report (#97). The
    # old form printed "(unreachable)" and returned 0, so `crew status x ||
    # alert` could never fire and a typo'd box name read exactly like a box
    # that was merely down. Same shape as cmd_hire's existing check, and the
    # same exit code: the world is not ready, so 1 rather than 2.
    #
    # Deliberately narrow: a box that EXISTS but does not answer keeps
    # printing "(unreachable)" and returning 0, because stopped is a normal
    # state that `crew status` with no argument reports without complaint.
    box_exists "$b" || die "no box named '$b' — 'crew status' lists the roster"
    echo "== $b"
    echo "host: $(crew_version)"
    # The same single exec the table makes, asked for its paths as well: this
    # is the view an operator opens after the table shouted MODIFIED, so it is
    # where the file list belongs. Still one round trip, not two.
    local report state recorded
    report="$(engine_report "$b" --paths)"
    engine="$(report_field stamp "$report")"
    state="$(report_field state "$report")"
    recorded="$(report_field recorded "$report")"
    case "$state" in
      absent) echo "engine: not hired (no engine)" ;;
      '')     echo "engine: unknown — the box did not answer" ;;
      *)      echo "engine: $engine" ;;
    esac
    case "$state" in
      current)
        echo "integrity: current — every engine file is what ${recorded:-this install} shipped" ;;
      modified)
        # Named separately from skew, and worded differently, because they ask
        # for different actions: skew says "ship the engine", MODIFIED says
        # "find out what someone did here, and why".
        echo "integrity: MODIFIED — diverged from ${recorded:-its recorded install}:"
        printf '%s\n' "$report" | sed -n 's/^path=/  /p'
        echo "  crew upgrade $b --force overwrites all of these — save what you need first" ;;
      unverified)
        echo "integrity: unverified — hired before content stamping; the next crew upgrade records one" ;;
    esac
    # The provenance half of #220, and this is the view it belongs in: the
    # table's NOTE has to fit one clause, while the operator who opened a
    # single box wants the marker line itself and which rig wrote it. Costs one
    # round trip on a one-box view, and none at all on the table.
    local rreport rconv rver rat
    rreport="$(rig_report "$b")"
    rconv="$(convergence_of "$rreport")"
    # `converged_*`, never `bootstrapped_*`: a box re-bootstrapped by a newer
    # rig carries both pairs and they differ, and what authorized the hire is
    # the convergence. Asking for the WHOLE key is what keeps the two apart —
    # rig writes `bootstrapped_at=` two lines above `converged_at=`, so a read
    # that went after the family (`.*_at=`, "grab the timestamp") would answer
    # with the first it met. Not the `^`: the key names do not overlap, so
    # anchored or not, `converged_at` never matches the bootstrap's line.
    rver="$(report_field rig:converged_by "$rreport")"
    rat="$(report_field rig:converged_at "$rreport")"
    case "$rconv" in
      converged)
        echo "rig: converged — $(report_field marker "$rreport")"
        # A converged box with no rig manifest was built by a rig older than
        # that file (rig#61) — old, not broken — so it says nothing rather than
        # inventing an alarm — the marker is what the verdict rests on.
        # rig records a BARE version (`converged_by=0.3.2-dev`), so the word
        # "rig" is crew's to supply — without it the line reads as a version of
        # nothing in particular.
        if [ -n "$rver" ]; then echo "     converged by rig $rver${rat:+ at $rat}"; fi ;;
      *)
        echo "rig: ${rconv^^} — $(convergence_detail "$rreport")"
        # roster_line prints "agent role from", so field 1 is the agent — and
        # an off-roster box yields nothing, which convergence_recovery renders
        # as a `<agent>` placeholder rather than a malformed command.
        echo "     $(convergence_recovery "$b" "$(roster_line "$b" | awk '{print $1}')")"
        echo "     crew hire $b refuses until this is fixed (--force overrides)" ;;
    esac
    # #221 — this line answered "can this box be reached?" with a test of
    # whether ONE FILE exists. ~/duty/duty.log is not written until the first
    # duty run, so `tail` exits 1 on every freshly hired box, `||` read that as
    # silence, and the detail view called a demonstrably reachable box
    # unreachable — the `integrity:` line three rows up is itself a `box exec`
    # round trip that answered. The window is every hire, for up to five
    # minutes, which is exactly when an operator runs this to check the hire
    # worked; in the reported instance it bought a round of diagnosis that
    # ended at "wait five minutes".
    #
    # Reachability comes from the probes already made, never from this read's
    # exit status — and from BOTH of them, not one. A box that answered neither
    # engine_report nor rig_report is the box nobody can talk to; a box that
    # answered one of them has a broken engine or an unreadable marker and is
    # very much reachable, so resting on a single silent probe would re-file
    # the same false alarm one layer down. No round trip is added: both
    # captures are already in hand, and this read is the same one it always
    # was.
    #
    # The hired/un-hired split keys on the report state, as does the `engine:`
    # line above: `absent` is a reachable box with no engine, while an empty
    # state means the box did not answer at all (#308).
    #
    # Stopped and unreachable keep printing "(unreachable)" and keep returning
    # 0, per the narrowness comment at the top of this branch: stopped is a
    # normal state, and #97's failure is reserved for a box that does not exist.
    # ONE exec for both of this view's box reads — #221's round-trip budget is
    # THREE and fleet-floor/test/cli.sh asserts the number, so the session
    # budget rides along with the duty-log tail rather than buying a fourth.
    #
    # A box that answers nothing yields no mark, and both halves come back
    # empty: `log` is then exactly what it was before this, so the unreachable
    # branch below still rests on the two probes already made and never on
    # this read's exit status.
    local probe rest budget health vitals log vkey vval
    # The read is INLINE and not a helper: fleet-floor/test/cli.sh pins this
    # `tail` inside cmd_status and requires the `|| true` beside it, because
    # the defect it guards is the duty-log read's exit status deciding
    # reachability. Extracting it would move the guard's subject out from
    # under it while leaving the property true and unasserted.
    #
    # The budget half asks the box for FINISHED ROWS rather than for numbers to
    # render here, and `load_conf` runs INSIDE that same exec because the
    # ceilings are a fact of the box's own conf/roles/*.conf: a lane is
    # configured there whether or not it has ever dispatched, and this host has
    # no way to resolve a role conf it does not have. Loading it here costs no
    # round trip — it is one more statement in the exec already being made, and
    # #221's count of three is unmoved.
    #
    # Silence on every failure path, deliberately. An engine older than the
    # budget has no session_budget_report, a box mid-install has no
    # instance.conf for load_conf to read, a box with no configured lane prints
    # nothing, and a box that answers nothing yields no mark at all — both
    # halves come back empty, so `log` is exactly what it was before this.
    # shellcheck disable=SC2016  # $HOME must expand INSIDE the box
    probe="$(bxn "$b" '
      [ -r "$HOME/duty/lib/common.sh" ] &&
        env DUTY_DIR="$HOME/duty" bash -c \
          ". \"$HOME/duty/lib/common.sh\"; load_conf; session_budget_report" 2>/dev/null
      echo "'"$STATUS_PROBE_MARK"'"
      [ -r "$HOME/duty/lib/common.sh" ] &&
        env DUTY_DIR="$HOME/duty" bash -c \
          ". \"$HOME/duty/lib/common.sh\"; tick_health_report \"$HOME/duty/duty.log\"" 2>/dev/null
      echo "'"$STATUS_HEALTH_MARK"'"
      grep "^VITALS " ~/duty/duty.log 2>/dev/null | tail -1
      echo "'"$STATUS_VITALS_MARK"'"
      tail -n 5 ~/duty/duty.log 2>/dev/null
    ' 2>/dev/null | tr -d '\r' || true)"
    # #483 rides here as a THIRD section of the same exec, between the budget
    # and the log tail. Whole-file grep and not `tail -n N | grep`: the newest
    # record is normally a few lines back, but a long session logs hundreds
    # inside one tick, and a window that loses the record on exactly the busy
    # box an operator is looking at is worse than a scan of a file tick.sh
    # already caps at 5 MB. fleet-floor/server/probe.sh selects it by the same
    # rule for the floor, which is what makes "the two cannot disagree" a
    # property of the code rather than a claim about it.
    budget="${probe%%"$STATUS_PROBE_MARK"*}"
    rest="${probe#*"$STATUS_PROBE_MARK"}"
    [ "$probe" != "$budget" ] || budget=""   # no mark: nothing answered
    health="${rest%%"$STATUS_HEALTH_MARK"*}"
    rest="${rest#*"$STATUS_HEALTH_MARK"}"
    if [ "$rest" = "$health" ]; then rest="$health"; health=""; fi
    vitals="${rest%%"$STATUS_VITALS_MARK"*}"
    log="${rest#*"$STATUS_VITALS_MARK"}"
    # Same degradation as the budget half, one section along: a box that
    # answered nothing yields no marks, and `log` must come out as exactly
    # what it was before either section existed rather than swallowing the
    # whole capture into `vitals`.
    if [ "$rest" = "$vitals" ]; then vitals=""; log="$rest"; fi
    budget="${budget%$'\n'}"
    health="${health#$'\n'}"; health="${health%$'\n'}"
    vitals="${vitals#$'\n'}"; vitals="${vitals%$'\n'}"
    log="${log#$'\n'}"
    # #464 D7 — the balance the gate is already keeping, displayed. A budget
    # nobody can read without opening a dotfile is a budget nobody reads, and
    # this is the view an operator opens when a lane has gone quiet.
    #
    # The SECTION is omitted entirely when no lane is CONFIGURED, rather than
    # printed empty: the default is off, so on most boxes the honest report is
    # no report. A configured lane that has not dispatched yet still gets its
    # row, at zero — the operator who has just set a ceiling is exactly who
    # opens this view. Placed above the duty.log tail because it is the state,
    # and the tail is the narration.
    #
    # NOT telemetry (#327), which owns per-session accounting, outcomes and
    # vendor spend. This is one balance per lane and nothing else.
    # #483 — the box's own vitals, from the record the tick wrote. ABOVE the
    # budget because it is the more basic state: budget is what the work has
    # cost, vitals is whether the box can do any, and an operator opening this
    # view on a box that has gone quiet wants "it is out of disk" before "it
    # has spent 40% of its lane".
    #
    # The SECTION is omitted entirely on a box whose engine predates the probe
    # — the same rule the budget uses one line down, and for the same reason:
    # a heading over six em-dashes reads as a box that answered and had
    # nothing to say, which is the opposite of what happened.
    #
    # Rendered from vitals_rows and nothing else, so the words here and the
    # words on the floor are one string. See the contract on that function.
    if [ -n "$vitals" ]; then
      echo "vitals:"
      while IFS=$'\t' read -r vkey vval; do
        printf '  %s: %s\n' "$vkey" "$vval"
      done < <(vitals_rows "$vitals")
    fi
    if [ -n "$health" ]; then
      echo "tick health:"
      while IFS=$'\t' read -r vkey vval; do
        printf '  %s: %s\n' "$vkey" "$vval"
      done < <(tick_health_rows "$health")
    fi
    if [ -n "$budget" ]; then
      echo "budget:"
      printf '%s\n' "$budget"
    fi
    if [ -z "$state" ] && [ "$rconv" = unknown ]; then
      echo "  (unreachable)"
    elif [ "$state" = absent ]; then
      # No engine, so a missing duty log is not the news — the absent engine
      # is. Factual and not prescriptive: `crew hire` is the action, but
      # whether it will be REFUSED belongs to the rig lines directly above,
      # which already carry the recovery for an unconverged box.
      echo "  not hired — no engine installed, so there is no duty log"
    elif [ -z "$log" ]; then
      # Absent and empty are the same fact here — nothing has run — and
      # telling them apart would mean deciding a meaning box-side, where no
      # offline test can reach it (rig_report's split, same rule).
      #
      # `no ticks yet` is NOT this line's own phrase: it is what the table
      # prints in NOTE for this same box a few hundred lines down (#224), and
      # the floor renders the same fact as `waiting` (#265). Three readers of
      # one state, so a third phrase here would mean an operator needs a
      # glossary to see that two views agree — which is the disagreement #265
      # was raised to end. Amended into #221's spec by triage on 2026-08-02.
      #
      # No hire stamp, deliberately. The only stamp in reach is $engine, which
      # is the engine VERSION (hired_at() reads ~/duty/VERSION line 1) and is
      # already on screen two rows up as `engine:` — so "hired at crew@0.1.0"
      # would be both redundant and read as a time it is not. The real
      # wall-clock stamp is that file's line 2, which `crew upgrade` rewrites
      # and engine_report does not carry.
      #
      # The wait is quoted from what `crew hire` told this operator minutes
      # ago (shared/install.sh's "first tick at the next 5-minute boundary"):
      # the answer to "did my hire work?" should read as the hire's own
      # promise, not as a new fact to interpret. It describes an ARMED box,
      # which every just-hired box is; a box disarmed after hire is a state
      # this view cannot see without a round trip it is not allowed to make
      # (#221's own budget), and the table — `crew status` with no argument —
      # is the reader that reports `disarmed` from counts it already has.
      echo "  no ticks yet — ~/duty/duty.log is written by the first tick, at the next 5-minute boundary"
    else
      printf '%s\n' "$log"
    fi
    return 0
  fi

  # 20, not 18: `crew-drill-reviewer` is 19 characters, so an 18-wide column
  # overflowed and shifted every field after it one place right on that row.
  #
  # INTEGRITY is its OWN column and not a decoration on ENGINE (#159): HOST vs
  # ENGINE is skew, INTEGRITY is whether the box is even running the engine it
  # names, and collapsing the two loses the only question `crew status` could
  # not answer before. 10 wide for `unverified`.
  local fmt='%-20s %-10s %-12s %-15s %-10s %-8s %-8s %s\n'
  local host; host="$(crew_version)"
  # shellcheck disable=SC2059
  printf "$fmt" MEMBER STATE HOST ENGINE INTEGRITY GH VENDOR NOTE
  local name agent role _from state hired ghs vs ghs_d vs_d note last
  local supp_age supp_kind supp_key supp_subject log_timestamped session_active lock_age
  local session_kind session_ceiling lock_ceiling lock_bound
  local report estate erecorded edisplay
  local rreport conv convnote
  while read -r name agent role _from; do
    if ! box_exists "$name"; then
      # shellcheck disable=SC2059
      printf "$fmt" "$name" - "$host" - - - - "NOT CREATED — crew new $name"
      continue
    fi
    state="$(box_state "$name")"
    if [ "$state" = "stopped" ]; then
      # shellcheck disable=SC2059
      printf "$fmt" "$name" stopped "$host" - - - - "crew up starts it"
      continue
    fi
    report="$(engine_report "$name")"
    hired="$(report_field stamp "$report")"
    estate="$(report_field state "$report")"
    erecorded="$(report_field recorded "$report")"
    # One exec, no network, same evidence the floor reads — see auth_from_flow.
    read -r ghs vs tickage armed cpaused supp_age supp_kind supp_key \
      log_timestamped session_active lock_age session_kind session_ceiling \
      <<<"$(auth_from_flow "$name")"
    ghs="${ghs:-unknown}"; vs="${vs:-unknown}"; tickage="${tickage:--1}"
    # An older engine, or a box that answered nothing, reports no counts. Treat
    # that as "armed" rather than inventing an alarm: absence of evidence about
    # cron is not evidence that cron is gone, and the old behaviour (say
    # nothing) is the safe one to fall back to.
    armed="${armed:-1}"; cpaused="${cpaused:-0}"
    supp_age="${supp_age:--1}"; supp_kind="${supp_kind:--}"; supp_key="${supp_key:--}"
    log_timestamped="${log_timestamped:-0}"; session_active="${session_active:-0}"; lock_age="${lock_age:--1}"
    # An engine older than #624 answers eleven fields, so these two are empty
    # on exactly the boxes whose `SESSION START` lines the second clause below
    # could not have used anyway. Defaulting them to "nothing declared" is what
    # makes an un-upgraded box's reading bit-identical to today's.
    session_kind="${session_kind:--}"; session_ceiling="${session_ceiling:--1}"
    # The CLI's half of floor.units.stuck_verdict, and the same two clauses in
    # the same order (#624 D3). Computed here rather than inside the ladder
    # below because the ladder's rungs are single conditions.
    #
    #   · a session is in flight and declared a ceiling  → that ceiling + the
    #     kill grace. The knob is deliberately NOT consulted: it bounds a run
    #     with no session to speak for it, and capping a declared ceiling with
    #     it would re-introduce the false alarm this replaces, silently, on the
    #     boxes whose operator had raised it.
    #   · nothing in flight, or a START carrying no `timeout=`  → STUCK_AFTER_S
    #     unchanged, which is the one meaning of CREW_FLOOR_STUCK_AFTER that
    #     this keeps intact.
    #
    # `session_active` gates the first clause because the floor's `cur` is None
    # for an orphan past the six-hour bound, and a ceiling read off a dead
    # session's line is exactly the second source of truth this refuses.
    # auth_from_flow clears both fields at that bound too, so this gate is
    # belt-and-braces rather than the only thing holding the two apart.
    #
    # `10#` — THE WIRE CARRIES DIGITS, AND THIS READER TURNS THEM INTO A
    # NUMBER, which is where the floor does it too: `int(m.group(4))` in
    # units.derive_sessions. Neither reader normalises the LOG, because the
    # record is the box's and D1 is that it is read rather than restated.
    # Bash reads a leading zero in an arithmetic context as octal, and a role
    # conf may legitimately say `TIMEOUT_BUILD=0900` — nothing between it and
    # `session.sh`'s `timeout=${tmo}s` canonicalises, and GNU `timeout 0900`
    # runs the session happily. Without `10#` that reaches `$(( ))` as an
    # invalid octal literal: the guards above do NOT stop it, because the
    # regex matches and `test -gt` parses base 10. The expansion is then a
    # FATAL error under `set -euo pipefail`, so `cmd_status` returns 1 out of
    # this `while read` and the roster stops printing at that box while the
    # floor renders it fine — the disagreement this whole change removes,
    # wearing its worst hat. It is also what `lock_ceiling` is RENDERED from
    # three screens down, so the canonical value has to be the stored one.
    #
    # THE VALIDATION IS ONE REGEX AND NOT A `test`, because `test` is the other
    # fixed-width reader in this clause and it fails the same way `$(( ))` does.
    # `^0*([1-9][0-9]*)$` does all three jobs at no width at all: digits only,
    # POSITIVE (at least one non-zero digit, so `0` and `0000` fall through to
    # the fallback exactly as `-gt 0` made them), and it captures the ceiling
    # with leading zeros stripped — as a STRING, which is the only form of it
    # bash can hold for a wire value of arbitrary length. `[ "$session_ceiling"
    # -gt 0 ]` stood here until this was found and must not come back: on
    # twenty-four digits it exits 2 with `integer expression expected` on the
    # operator's stderr, mid-roster, and the clause is then SKIPPED — so a live
    # session with an enormous declared ceiling was graded against
    # STUCK_AFTER_S and a 700s lock read STUCK here while the floor, whose
    # `int()` has no range, read it healthy. #624's own defect, inside #624's
    # own fix.
    #
    # Past SESSION_CEILING_MAX_S the ceiling is SATURATED rather than computed
    # with. `$(( ))` would wrap silently and fabricate a number that is nobody's
    # record; saturating grades identically to the floor's unbounded arithmetic
    # for every lock age that can exist, which is the agreement being defended
    # rather than the arithmetic. The gate is taken on the capture's LENGTH
    # against the constant's own length, so the two cannot drift apart. The
    # saturated value is never rendered: `lock_ceiling` is read in exactly one
    # place, the STUCK note, and reaching it needs a lock age past 10^18.
    lock_ceiling=-1
    lock_bound="$STUCK_AFTER_S"
    if [ "$session_active" = 1 ] && [[ "$session_ceiling" =~ ^0*([1-9][0-9]*)$ ]]; then
      if [ "${#BASH_REMATCH[1]}" -gt "${#SESSION_CEILING_MAX_S}" ]; then
        lock_ceiling=$SESSION_CEILING_MAX_S
      else
        lock_ceiling=$(( 10#$session_ceiling ))
      fi
      lock_bound=$(( lock_ceiling + SESSION_KILL_GRACE_S ))
    fi
    # `nofail` aged into a verdict HERE, on the host, with the same rule the
    # floor applies. SILENT_AFTER_S must equal floor.py's; shared/test asserts
    # it, because two readers with private thresholds is the defect this whole
    # helper exists to remove.
    # The never-ticked branch is floor.py's `never_ticked = tick_age < 0`, and
    # shared/test asserts the two boundaries match for the same reason it
    # asserts SILENT_AFTER_S does: a verdict that exists in one reader only is
    # exactly the disagreement auth_from_flow was written to remove. It comes
    # FIRST because "no age at all" is not a point on the freshness scale —
    # falling through to the else called a box hired a minute ago `stale` (#265).
    for _v in ghs vs; do
      if [ "${!_v}" = nofail ]; then
        if [[ "$tickage" =~ ^-?[0-9]+$ ]] && [ "$tickage" -lt 0 ]; then
          printf -v "$_v" waiting
        elif [[ "$tickage" =~ ^[0-9]+$ ]] && [ "$tickage" -lt "$SILENT_AFTER_S" ]; then
          printf -v "$_v" flowing
        else
          printf -v "$_v" stale
        fi
      fi
    done
    # The wire vocabulary is lowercase and shared with the floor; the TABLE
    # shouts. A dead login is the one row an operator must not skim past, and
    # it earned its capitals long before this column changed source.
    ghs_d="$ghs"; vs_d="$vs"
    [ "$ghs" = missing ] && ghs_d=MISSING
    [ "$vs"  = missing ] && vs_d=MISSING
    note=""; conv=""; convnote=""
    # Convergence is asked ONLY of an un-hired box, and that is a budget
    # decision as much as a semantic one: a hired box already proved it could
    # run, so a healthy steady-state fleet pays no extra round trip at all and
    # this column costs exactly what it cost before (the same rule engine_report
    # is written to). The window where it matters is bring-up, and in that
    # window every OTHER signal is derived through an engine that does not
    # exist yet — GH and VENDOR both read `unknown`, which is why nothing in
    # this table carried the failure (#220).
    if [ -z "$hired" ]; then
      hired="not hired"
      rreport="$(rig_report "$name")"
      conv="$(convergence_of "$rreport")"
      case "$conv" in
        converged) note="crew hire $name" ;;
        incomplete)
          convnote="INCOMPLETE — $(convergence_detail "$rreport"); $(convergence_recovery "$name" "$agent")" ;;
        unknown)
          convnote="convergence unknown — $(convergence_detail "$rreport"); crew hire refuses until it can read the marker" ;;
      esac
    fi
    if [ "$ghs" = missing ] || [ "$vs" = missing ]; then
      note="⚠ log in: box shell $name${note:+; $note}"
      # A failing vendor probe has two very different causes, and they were
      # indistinguishable: the box is genuinely logged out, OR the ROSTER named
      # the wrong agent and we just probed with the wrong vendor profile. The
      # second reads as the first forever, because nothing compared the
      # roster's claim against what the box was actually installed as.
      #
      # Only asked when the probe already failed: on a healthy fleet this costs
      # nothing, and this is exactly the moment an operator is staring at
      # MISSING wondering why. (A mismatch where BOTH vendor CLIs happen to be
      # installed stays invisible here; the floor reports it unconditionally,
      # since probe.sh is one round trip either way.)
      if [ "$vs" = MISSING ]; then
        actual="$(box_agent "$name")"
        if [ -n "$actual" ] && [ "$actual" != "$agent" ]; then
          note="⚠ $ROSTER says '$agent', box installed as '$actual' — probing the WRONG vendor"
        fi
      fi
    elif [ -n "$hired" ] && [ "$hired" != "not hired" ] && [ "$armed" = 0 ]; then
      # Not armed: cron will never fire here, so the newest duty.log line is a
      # fact about the past and reads as though the box is working. The floor
      # says the same thing from the same counts (#189) — that agreement is the
      # point, and drill/rehearsal-app.sh asserts it on a real host.
      if [ "$cpaused" != 0 ]; then
        note="paused by operator — resume from the console"
      else
        note="disarmed — no cron line; crew hire $name arms it"
      fi
    elif [ -n "$hired" ] && [ "$hired" != "not hired" ] \
         && [ "$log_timestamped" = 1 ] && { ! [[ "$tickage" =~ ^[0-9]+$ ]] \
           || [ "$tickage" -ge "$SILENT_AFTER_S" ]; }; then
      state=offline
      if [[ "$tickage" =~ ^[0-9]+$ ]]; then
        note="SILENT — no tick for $(status_duration "$tickage")"
      else
        note="tick age unknown — waiting for a valid probe"
      fi
    elif [ -n "$hired" ] && [ "$hired" != "not hired" ] \
         && [[ "$lock_age" =~ ^[0-9]+$ ]] \
         && [ "$lock_age" -gt "$lock_bound" ]; then
      state=working
      if [ "$lock_ceiling" != -1 ]; then
        # Name the bound, not only the age: an operator who can see 62m and not
        # the 60m it passed cannot tell a wedge from a raised threshold. Word
        # for word the floor's sentence, because the two consoles describing
        # one box differently is the defect, not the wording.
        note="STUCK — duty run has held the lock for $(status_duration "$lock_age"), past the $session_kind session's $(status_duration "$lock_ceiling") ceiling"
      elif [ "$session_active" = 1 ]; then
        # In flight, ceiling unknown. Today's sentence to the byte: there is no
        # bound to name that the box has told us about, and inventing one from
        # the host's idea of this lane is the second source of truth refused
        # above.
        note="STUCK — duty run has held the lock for $(status_duration "$lock_age")"
      else
        note="STUCK — duty run has held the lock for $(status_duration "$lock_age") with no session in flight, past $(status_duration "$STUCK_AFTER_S")"
      fi
    elif [ -n "$hired" ] && [ "$hired" != "not hired" ] \
         && [ "$session_active" = 1 ]; then
      state=working
      note="session active"
    elif [ -n "$hired" ] && [ "$hired" != "not hired" ] \
         && [[ "$supp_age" =~ ^[0-9]+$ ]]; then
      state=suppressed
      supp_subject="${supp_key%@*}"
      note="for $(status_duration "$supp_age") — $supp_kind resume breaker at $supp_subject"
    elif [ -n "$hired" ] && [ "$hired" != "not hired" ]; then
      # `|| true` is load-bearing, exactly as it is in box_state, box_agent and
      # box_registry: ~/duty/duty.log does not exist until the first duty run
      # writes it, so `tail` exits 1, bxn propagates that, `pipefail` takes it,
      # and the assignment died under `set -e` — killing the table at the first
      # never-ticked box with no message at all (#224). That is not an edge
      # case during bring-up: it is EVERY box, for the first five minutes.
      #
      # It also makes `no ticks yet` reachable. The fallback was written for
      # exactly this box and could never render, because the assignment that
      # would leave `last` empty ended the command first.
      #
      # An UNREACHABLE box never arrives here: it answers no engine_report, so
      # `hired` is empty and the branch above claims the row. That separation
      # is the point — a box nobody can talk to must not read as a healthy box
      # that has simply not ticked (#221, one call site over).
      last="$(bxn "$name" 'tail -n 1 ~/duty/duty.log 2>/dev/null' 2>/dev/null | tr -d '\r' | cut -c1-60 || true)"
      note="${last:-no ticks yet}"
    fi
    # Convergence WINS the note outright, over the login advice above. Both are
    # true of an unconverged box, and only one of them is worth doing: logging
    # in a box that has no vendor CLI installed fixes nothing, and `crew hire`
    # will refuse it either way. The note must carry the action that actually
    # moves the box forward, which is the bootstrap.
    # An `if`, not `[ … ] && …`: this file already carries that scar twice
    # (cmd_upgrade's loop, hire_box's force_arg) — the short form takes the
    # test's exit status, and here the common case is the empty one.
    if [ -n "$convnote" ]; then note="$convnote"; fi
    # The wire vocabulary is lowercase; MODIFIED shouts for the same reason
    # MISSING does — it is the one row an operator must not skim past, and the
    # note names the version it diverged from so the column stays one word.
    case "$estate" in
      modified)
        edisplay=MODIFIED
        note="⚠ engine MODIFIED since ${erecorded:-its install} — crew status $name lists the files${note:+; $note}" ;;
      absent) edisplay=- ;;
      *)      edisplay="${estate:--}" ;;
    esac
    # shellcheck disable=SC2059
    printf "$fmt" "$name" "$state" "$host" "$hired" "$edisplay" "$ghs_d" "$vs_d" "$note"
  done < <(read_roster)
}

cmd_upgrade() {
  need_box
  local targets="" skipped="" target="" ref="HEAD" want force_arg=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --all)
        [ -z "$target" ] || usage_error "usage: $(synopsis_of upgrade)"
        target="--all"; shift ;;
      --ref) need_value "$@"; ref="$2"; shift 2 ;;
      # The override for install.sh's refusal to overwrite a MODIFIED engine
      # (#159). Nothing else consults it: the check is in the installer, where
      # the overwrite happens, so this only has to reach it.
      --force) force_arg="--force"; shift ;;
      --*) usage_error "unknown argument '$1' (usage: $(synopsis_of upgrade))" ;;
      *)
        [ -z "$target" ] || usage_error "usage: $(synopsis_of upgrade)"
        target="$1"; shift ;;
    esac
  done
  resolve_engine "$ref"
  want="$ENGINE_VERSION"
  case "$target" in
    --all)
      # The ROSTER, not every box on the host. `crew up` already leaves
      # off-roster boxes alone and says so; this verb reaching them meant a
      # disarmed box carrying a real identity and a production registry --
      # a drill box between runs, say -- could be armed by routine
      # maintenance (#37). Naming a box explicitly is still allowed: that is
      # a deliberate act on a known target, which `--all` is not.
      targets="$(comm -12 <(roster_names | sort) <(box_names | sort))"
      skipped="$(comm -23 <(box_names | sort) <(roster_names | sort))"
      ;;
    "")    usage_error "usage: $(synopsis_of upgrade)" ;;
    *)     targets="$target" ;;
  esac
  # After the target `case`, so `crew upgrade` with no target still earns its
  # invocation-fault 2 rather than this world-fault 1.
  require_operator_config "crew upgrade"
  local b armed flags line agent role identity_args registry_arg
  registry_arg="$(registry_install_arg)"
  for b in $targets; do
    echo "== upgrading $b"
    if [[ "$want" == *-dev* ]]; then
      echo "$b: crew@$want is a development tree — upgrade re-bakes unconditionally"
    fi
    # Preserve the box's armed state instead of asserting one. An upgrade
    # that arms a box nobody armed is a behaviour change wearing the
    # clothes of a version bump.
    if bxn "$b" 'crontab -l 2>/dev/null | grep -qE "^[^#].*tick\.sh"' 2>/dev/null; then
      armed=1; flags="--arm-cron"
    else
      armed=0; flags=""
    fi
    line="$(roster_line "$b")"
    if [ -n "$line" ]; then
      read -r agent role _ <<<"$line"
      identity_args="$(install_identity_args "$b" "$agent" "$role")"
    else
      # An explicitly named off-roster box keeps its existing instance config.
      identity_args=""
    fi
    # D5's mark, BEFORE the upgrade that invalidates the checkpoint (#589). An
    # `armed` checkpoint cut before this moment restores an OLDER engine than
    # the box is hired at, and an unattended weekly reset would perform that
    # downgrade every week with nothing red anywhere. Marking first is what
    # makes the fact durable: a mark that could not be written stops the
    # upgrade instead of leaving a box whose checkpoint lies about it. It can
    # still not take the loop down — one box refuses, the rest carry on.
    if ! checkpoint_stale_gate "$b" "$want"; then
      echo "  upgrade REFUSED on $b — its engine is unchanged"
      continue
    fi
    if ! stage_engine "$b" ||
       ! stage_fleet_definition "$b" ||
       ! install_staged_engine "$b" "$identity_args $registry_arg $flags $force_arg"; then
      cleanup_staged_engine "$b"
      echo "  upgrade FAILED on $b"
      # The chosen residual of marking first: the checkpoint now reads stale
      # for an engine move that did not happen, so a reset will refuse this
      # box. Said here rather than left to be met weeks later at the reset.
      if [ -f "$(checkpoint_file "$b")" ]; then
        echo "  note: $b's $RESET_LABEL checkpoint was already marked stale for crew@$want and stays marked; a reset REFUSES this box until it is re-cut with: crew reset --cut $b"
      fi
    fi
    # An `if`, not `[ … ] && echo`: as the loop body's last statement that
    # form returns 1 whenever the box WAS armed, and `set -e` would end the
    # loop after one box. Same shape as #25/#30.
    if [ "$armed" -eq 0 ]; then
      echo "  note: $b was NOT cron-armed; left disarmed (arm it with: crew hire $b)"
    fi
  done
  if [ -n "$skipped" ]; then
    echo
    echo "boxes on this host but not in the roster (left alone):"
    # shellcheck disable=SC2086  # splitting the name list is the point
    printf '  %s\n' $skipped
  fi
}

cmd_gold() {
  max_args gold 2 "$@"
  need_box
  local name="${1:-}" force="${2:-}"
  [ -n "$name" ] || usage_error "usage: crew gold <box> [--force]"
  require_operator_config "crew gold"
  # Gold images are the bake cache and must carry ZERO credentials — cut
  # them pre-auth. A logged-in box is refused.
  if bxn "$name" 'gh auth status >/dev/null 2>&1' 2>/dev/null; then
    [ "$force" = "--force" ] || die "$name has live gh credentials — golds are cut PRE-login (--force to override)"
  fi
  local stamp ver
  stamp="$(hired_at "$name")"
  stamp="${stamp:-crew@unknown}"
  ver="$(stamp_version "$stamp" 2>/dev/null || echo unknown)"
  ver="${ver//[^A-Za-z0-9_.-]/-}"
  box snapshot "$name" "gold-crew-$ver"
  echo "gold cut: $name @ $stamp"
}

# crew floor — serve the fleet-floor console from THIS host, on IP:PORT.
#
# The floor reads every box over `box exec` and fires operator actions the same
# way (#38/#39). That is the whole point: the boxes have no inbound network
# path, but the host they run on has always had a control channel into them —
# the one `crew status` and `crew hire` already use. Nothing is installed in a
# box and no box has to reach out.
#
# It binds 0.0.0.0 by default because being reachable at IP:PORT is the job, so
# HTTP Basic auth is NOT optional: a page that can power-cycle boxes and start
# model sessions is not a page to leave open on a LAN. Without --pass or
# CREW_FLOOR_PASS one is generated and printed here, once.
cmd_floor() {
  need_box
  local port="${CREW_FLOOR_PORT:-8420}" bind="${CREW_FLOOR_BIND:-0.0.0.0}"
  local user="${CREW_FLOOR_USER:-operator}" pass="${CREW_FLOOR_PASS:-}"
  local interval="${CREW_FLOOR_INTERVAL:-60}" gen=0
  local roster="${CREW_FLOOR_ROSTER:-$ROSTER}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --port)     need_value "$@"; port="$2";     shift 2 ;;
      --bind)     need_value "$@"; bind="$2";     shift 2 ;;
      --user)     need_value "$@"; user="$2";     shift 2 ;;
      --pass)     need_value "$@"; pass="$2";     shift 2 ;;
      --interval) need_value "$@"; interval="$2"; shift 2 ;;
      --roster)   need_value "$@"; roster="$2";   shift 2 ;;
      --local)    bind=127.0.0.1; shift ;;
      -h|--help) show_help floor; return 0 ;;
      *) usage_error "crew floor: unknown option '$1'" ;;
    esac
  done

  # The console is the ninth verb of #216's rule (#244). It reads like an
  # inspection surface and is not one: every button on the page fires through
  # POST /api/command, where `resume` uncomments a box's crontab and `message`
  # starts a real vendor-CLI session — the two acts #216 exists to stop the
  # fallback from performing. `do_command` gates only on the box being in the
  # resolved roster, and under the fallback the resolved roster is the shipped
  # one. Serving it is itself an act besides: a long-lived HTTP service on
  # 0.0.0.0 with a generated password is not the same category as printing a
  # table, and the browser gets none of the banner `crew status` prints.
  #
  # Placed after the option loop so `crew floor --port` still earns its
  # invocation-fault 2, and before the python3 / index.html / roster
  # preconditions so an unconfigured host gets the config answer rather than a
  # missing-build one. `--roster` does not lift it: that flag selects a roster
  # file while fleet.conf and the agent profiles still come from the resolved
  # config dir, so serving a console over a definition that is not the
  # resolved one is CREW_CONFIG_DIR's job.
  require_operator_config "crew floor"

  command -v python3 >/dev/null \
    || die "python3 is required for 'crew floor' (stdlib only, nothing to install)"
  [ -f "$CREW_ROOT/fleet-floor/index.html" ] \
    || die "fleet-floor/index.html is missing — build it with fleet-floor/build.sh in a repository checkout, or reinstall (an installed tree carries the built page, not the builder)"
  # Named at startup rather than surfaced as an empty fleet on first poll: a
  # typo'd --roster otherwise renders a console with nothing on it, which reads
  # exactly like a dead host.
  [ -f "$roster" ] || die "no roster at '$roster' (--roster / CREW_FLOOR_ROSTER)"

  if [ -z "$pass" ]; then
    pass="$(head -c 18 /dev/urandom | base64 | tr -d '/+=' | cut -c1-20)"
    gen=1
  fi

  # The address an operator actually types. A host with several NICs gets them
  # all rather than a guess.
  local ips
  ips="$(hostname -I 2>/dev/null | tr ' ' '\n' | grep -E '^[0-9]' || true)"
  [ -z "$ips" ] && ips="127.0.0.1"

  echo "crew floor — fleet console"
  if [ "$bind" = "127.0.0.1" ]; then
    echo "  url       http://127.0.0.1:$port/   (loopback only)"
  else
    while read -r ip; do [ -n "$ip" ] && echo "  url       http://$ip:$port/"; done <<<"$ips"
  fi
  echo "  user      $user"
  if [ "$gen" -eq 1 ]; then
    echo "  password  $pass   (generated — pass --pass or CREW_FLOOR_PASS to fix it)"
  else
    echo "  password  (from --pass/CREW_FLOOR_PASS)"
  fi
  echo "  polling   every ${interval}s over 'box exec' — nothing runs inside the boxes"
  # Always printed, not only when overridden: which boxes the console is
  # watching is the first thing to check when it shows something surprising.
  echo "  roster    $roster"
  [ "$bind" = "127.0.0.1" ] \
    || echo "  NOTE      plain HTTP: the password crosses the network in the clear."
  echo

  CREW_FLOOR_PORT="$port" CREW_FLOOR_BIND="$bind" CREW_FLOOR_USER="$user" \
  CREW_FLOOR_PASS="$pass" CREW_FLOOR_INTERVAL="$interval" \
  CREW_FLOOR_ROSTER="$roster" CREW_FLOOR_VERSION="$(version)" \
    exec python3 "$CREW_ROOT/fleet-floor/server/floor.py"
}

cmd_init() {
  [ "$#" -le 1 ] || usage_error "usage: crew init [config-dir]"
  local target="${1:-}" file name _agent _role _from
  if [ -z "$target" ]; then
    if [ -n "${XDG_CONFIG_HOME:-}" ]; then target="$XDG_CONFIG_HOME/crew"
    else target="$HOME/.config/crew"; fi
  fi
  [ ! -e "$target" ] ||
    die "refusing to overwrite existing operator config '$target'"

  mkdir -p "$target/agents"
  for file in fleet.roster fleet.conf repos.txt notify-repos.txt doctrine.conf; do
    cp "$CREW_ROOT/examples/$file" "$target/$file"
  done

  echo "initialized operator config: $target"
  echo "edit the generated files, then run: CREW_CONFIG_DIR='$target' crew up"
  echo
  echo "static login obligations from fleet.roster (definition only; not a live auth check):"
  while read -r name _agent _role _from; do
    echo "  $name — by hand: box shell $name; gh auth login; then the agent login"
  done < <(grep -vE '^[[:space:]]*(#|$)' "$target/fleet.roster")
}

cmd_profiles() {
  max_args profiles 0 "$@"
  fallback_banner
  local f name
  echo "roles:"
  for f in "$ROLES_DIR"/*.conf; do
    echo "  $(basename "$f" .conf) — $(sed -n '1s/^# *//p' "$f")"
  done
  echo "agents:"
  # The union of shipped and operator names, each resolved through agent_conf
  # so the line shown describes the file that will actually run; a profile the
  # operator supplied (or overrode) says so, because "listed here" must mean
  # "hireable" and an operator debugging a clash needs to see who won (#75).
  for name in $(agent_names | sort -u); do
    f="$(agent_conf "$name")"
    case "$f" in
      "$AGENTS_DIR"/*) echo "  $name — $(sed -n '1s/^# *//p' "$f")" ;;
      *)               echo "  $name — $(sed -n '1s/^# *//p' "$f")  [operator]" ;;
    esac
  done
}

# --- dispatch: driven by the table, not by a hand-written case --------------

cmd="${1:-help}"; shift || true
case "$cmd" in
  -h|--help)    usage; exit 0 ;;
  -V|--version) version; exit 0 ;;
  -*)           usage_error "options come after the command — try 'crew <command> $cmd ...'" ;;
esac

cmd="$(normalize_verb "$cmd")"
fn="$(field "$cmd" fn)" || unknown_command "$cmd"
"$fn" "$@"
